    fi
  fi
  if tui_yesno "ACME" "是否用 Let's Encrypt 申请证书？（域名需解析到本机，临时占用 80）"; then
    issue_acme_cert "${domain}" || return 1
  else
    make_self_signed "${domain}"
    tui_msg "自签名" "已生成自签名证书，客户端需允许不安全连接（仅测试）。"
  fi
  CERT_FILE="${XCC_CERT_DIR}/fullchain.pem"
  KEY_FILE="${XCC_CERT_DIR}/privkey.pem"
}

