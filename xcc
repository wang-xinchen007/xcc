    }
  fi
}

#===============================================================================
# 看门狗暂停 / 恢复（配置修改期间自动执行）
#===============================================================================
pause_watchdog() {
  if is_svc_active xcc-watchdog; then
    systemctl stop xcc-watchdog
    WATCHDOG_PAUSED=1
    tui_infobox "⏸ 看门狗已暂停，配置修改期间不会自动重启 Xray / sing-box / Nginx"
    xcc_log INFO "看门狗已暂停（配置修改）"
  else
    WATCHDOG_PAUSED=0
  fi
}

resume_watchdog() {
  if [[ "${WATCHDOG_PAUSED}" -eq 1 ]]; then
    systemctl start xcc-watchdog 2>/dev/null || true
    WATCHDOG_PAUSED=0
    tui_infobox "▶ 看门狗已恢复运行"
    xcc_log INFO "看门狗已恢复运行"
  fi
}

# 配置操作期间 Ctrl+C / 异常退出：回滚最新备份并恢复看门狗。
on_run_exit() {
  if [[ "${IN_CONFIG_OP}" -eq 1 && -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    restore_backup_dir "${CURRENT_BACKUP}" || true
    xcc_log WARN "配置操作异常退出，已从备份恢复"
  fi
  if [[ "${WATCHDOG_PAUSED}" -eq 1 ]]; then
    systemctl start xcc-watchdog >/dev/null 2>&1 || true
    WATCHDOG_PAUSED=0
  fi
}

begin_config_op() {
  IN_CONFIG_OP=1
  pause_watchdog
  CURRENT_BACKUP=$(backup_runtime_configs) || CURRENT_BACKUP=""
}

end_config_op_ok() {
  IN_CONFIG_OP=0
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    rm -rf "${CURRENT_BACKUP}"
  fi
  CURRENT_BACKUP=""
  resume_watchdog
}

end_config_op_fail() {
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    restore_backup_dir "${CURRENT_BACKUP}" || true
  fi
  IN_CONFIG_OP=0
  CURRENT_BACKUP=""
  resume_watchdog
}

end_config_op_cancel() {
  IN_CONFIG_OP=0
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    rm -rf "${CURRENT_BACKUP}"
  fi
  CURRENT_BACKUP=""
  resume_watchdog
}

backup_runtime_configs() {
  local stamp dest
  stamp=$(date '+%Y%m%d-%H%M%S')
  dest="${XCC_BACKUP_DIR}/${stamp}"
  mkdir -p "${dest}"
  cp -a "${XCC_NODES}" "${dest}/nodes.json" 2>/dev/null || true
  cp -a "${XCC_OUTBOUND}" "${dest}/outbound.conf" 2>/dev/null || true
  cp -a "${XRAY_CONF}" "${dest}/xray.json" 2>/dev/null || true
  if [[ -d "${SINGBOX_DIR}" ]]; then
    cp -a "${SINGBOX_DIR}" "${dest}/sing-box" 2>/dev/null || true
    cp -a "${SINGBOX_DIR}" "${dest}/hysteria" 2>/dev/null || true
  fi
  cp -a "${SSHD_CONFIG}" "${dest}/sshd_config" 2>/dev/null || true
  printf '%s' "${dest}"
}

restore_backup_dir() {
  local dest="$1"
  [[ -d "${dest}" ]] || return 1
  [[ -f "${dest}/nodes.json" ]] && cp -a "${dest}/nodes.json" "${XCC_NODES}"
  [[ -f "${dest}/outbound.conf" ]] && cp -a "${dest}/outbound.conf" "${XCC_OUTBOUND}"
  [[ -f "${dest}/xray.json" ]] && cp -a "${dest}/xray.json" "${XRAY_CONF}"
  [[ -f "${dest}/sshd_config" ]] && cp -a "${dest}/sshd_config" "${SSHD_CONFIG}"
  if [[ -d "${dest}/sing-box" ]]; then
    mkdir -p "${SINGBOX_DIR}"
    cp -a "${dest}/sing-box/." "${SINGBOX_DIR}/"
  elif [[ -d "${dest}/hysteria" ]]; then
    mkdir -p "${SINGBOX_DIR}"
    cp -a "${dest}/hysteria/." "${SINGBOX_DIR}/"
  fi
}

#===============================================================================
# 端口占用检测
#===============================================================================
port_busy_ss() {
  local port="$1"
  port_busy_tcp "${port}" || port_busy_udp "${port}"
}

port_busy_tcp() {
  local port="$1"
  ss -H -ltn 2>/dev/null | grep -Eq ":${port}([^0-9]|$)"
}

port_busy_udp() {
  local port="$1"
  ss -H -lun 2>/dev/null | grep -Eq ":${port}([^0-9]|$)"
}

port_used_by_nodes() {
  local port="$1"
  local skip_tag="${2:-}"
  jq -r --arg skip "${skip_tag}" --argjson port "${port}" '
    (.reality[]? | select(.tag != $skip) | .port),
    (.reality[]? | select(.tag != $skip) | .xray_port),
    (.vless[]? | select(.tag != $skip and ((.network // "tcp") != "kcp")) | .port),
    (.trojan[]? | select(.tag != $skip) | .port),
    (.shadowsocks[]? | select(.tag != $skip) | .port),
    (.http[]? | select(.tag != $skip) | .port),
    (.socks[]? | select(.tag != $skip) | .port),
    (.tunnel[]? | select(.tag != $skip) | .port),
    (.wireguard[]? | select(.tag != $skip) | .port)
  ' "${XCC_NODES}" 2>/dev/null | grep -qx "${port}" && return 0
  if nginx_front_enabled; then
    [[ "$(nginx_public_port)" == "${port}" ]] && return 0
  else
    jq -r --arg skip "${skip_tag}" --argjson port "${port}" '
      (.vless_ws[]? | select(.tag != $skip) | .port),
      (.vmess[]? | select(.tag != $skip) | .port)
    ' "${XCC_NODES}" 2>/dev/null | grep -qx "${port}" && return 0
  fi
  return 1
}

udp_port_used_by_nodes() {
  local port="$1"
  local skip_tag="${2:-}"
  jq -r --arg skip "${skip_tag}" --argjson port "${port}" '
    (.hysteria[]? | select(.tag != $skip) | .port),
    (.wireguard[]? | select(.tag != $skip) | .port),
    (.tunnel[]? | select(.tag != $skip) | .port),
    (.vless[]? | select(.tag != $skip and (.network // "") == "kcp") | .port),
    (.vmess[]? | select(.tag != $skip and (.network // "") == "kcp") | .port)
  ' "${XCC_NODES}" 2>/dev/null | grep -qx "${port}"
}

assert_port_free() {
  local port="$1"
  local skip_tag="${2:-}"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 || "${port}" -gt 65535 ]]; then
    tui_msg "错误" "端口无效: ${port}"
    return 1
  fi
  if port_used_by_nodes "${port}" "${skip_tag}"; then
    tui_msg "端口占用" "端口 ${port} 已被 xcc 节点或 Nginx 使用，请更换端口。"
    return 1
  fi
  if port_busy_tcp "${port}"; then
    tui_msg "端口占用" "检测到 TCP 端口 ${port} 已被占用（ss -tln），请更换端口。"
    return 1
  fi
  return 0
}

assert_udp_port_free() {
  local port="$1"
  local skip_tag="${2:-}"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 || "${port}" -gt 65535 ]]; then
    tui_msg "错误" "端口无效: ${port}"
    return 1
  fi
  if udp_port_used_by_nodes "${port}" "${skip_tag}"; then
    tui_msg "端口占用" "UDP 端口 ${port} 已被 Hysteria2 使用，请更换端口。"
    return 1
  fi
  if port_busy_udp "${port}"; then
    tui_msg "端口占用" "检测到 UDP 端口 ${port} 已被占用（ss -uln），请更换端口。"
    return 1
  fi
  return 0
}

# Nginx 公网 TLS 端口：可复用本机已有的 xcc Nginx，但不能和 Reality/Trojan/SS 抢 TCP。
assert_nginx_listen_port() {
  local port="$1"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 || "${port}" -gt 65535 ]]; then
    tui_msg "错误" "端口无效: ${port}"
    return 1
  fi
  if jq -r --argjson port "${port}" '
      (.reality[]? | .port),
      (.reality[]? | .xray_port),
      (.vless[]? | select((.network // "tcp") != "kcp") | .port),
      (.trojan[]? | .port),
      (.shadowsocks[]? | .port),
      (.http[]? | .port),
      (.socks[]? | .port),
      (.tunnel[]? | .port)
    ' "${XCC_NODES}" 2>/dev/null | grep -qx "${port}"; then
    tui_msg "端口占用" "TCP ${port} 已被 Reality / VLESS / Trojan / SS / HTTP / SOCKS 等占用，Nginx 无法共用。请换端口。"
    return 1
  fi
  if port_busy_tcp "${port}"; then
    if [[ -f "${NGINX_CONF}" ]] && grep -Eq "listen[[:space:]]+(\\[::\\]:)?${port}[[:space:]]" "${NGINX_CONF}"; then
      return 0
    fi
    tui_msg "端口占用" "检测到 TCP 端口 ${port} 已被占用（ss -tln），请更换 Nginx 端口。"
    return 1
  fi
  return 0
}

