jq_file() {
  local file="$1"
  local expr="$2"
  jq_apply "${file}" "${expr}"
}

# 安全写入 JSON：jq 失败时不覆盖原文件。
jq_apply() {
  local file="$1"
  shift
  local tmp
  tmp=$(xcc_mktemp)
  if jq "$@" "${file}" > "${tmp}"; then
    mv "${tmp}" "${file}"
    chmod 600 "${file}"
    return 0
  fi
  rm -f "${tmp}"
  return 1
}

