}

#===============================================================================
# 日志（看门狗与主脚本共用）
# 每次写入前检查体积，超过 50MB 则自行轮转。
#===============================================================================
rotate_xcc_log_if_needed() {
  local size
  if [[ -f "${XCC_LOG}" ]]; then
    size=$(wc -c < "${XCC_LOG}" 2>/dev/null | tr -d ' ' || echo 0)
    if [[ "${size}" -gt 52428800 ]]; then
      mv "${XCC_LOG}" "${XCC_LOG}.old" 2>/dev/null || true
      : > "${XCC_LOG}"
    fi
  fi
}

xcc_log() {
  local level="$1"
  shift
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  mkdir -p "$(dirname "${XCC_LOG}")"
  rotate_xcc_log_if_needed
  printf '%s [%s] %s\n' "${ts}" "${level}" "$*" >> "${XCC_LOG}"
}

broadcast() {
  if command -v wall >/dev/null 2>&1; then
    printf '%s\n' "$*" | wall 2>/dev/null || true
  fi
}

#===============================================================================
# 临时文件（避免 /tmp 可能挂载为 noexec）
#===============================================================================
init_tmp() {
  mkdir -p "${XCC_TMP_DIR}" "${XCC_CACHE_DIR}"
  chmod 700 "${XCC_TMP_DIR}" 2>/dev/null || true
}

xcc_mktemp() {
  local suffix="${1:-}" f
  init_tmp
  f=$(mktemp "${XCC_TMP_DIR}/xcc-XXXXXX")
  if [[ -n "${suffix}" ]]; then
    mv "${f}" "${f}${suffix}"
    printf '%s' "${f}${suffix}"
  else
    printf '%s' "${f}"
  fi
}

# 使用 curl -f；失败时删除不完整文件并提示重试。
xcc_curl() {
  local dest="$1"
  local url="$2"
  shift 2
  init_tmp
  if ! curl -fL -A "xcc/${XCC_VERSION}" --retry 3 --retry-delay 2 \
      --connect-timeout 15 --max-time 180 "$@" -o "${dest}" "${url}"; then
    rm -f "${dest}"
    err "下载失败，请检查网络后重试: ${url}"
    return 1
  fi
  return 0
}

xcc_curl_stdout() {
  local url="$1"
  shift
  curl -fL -A "xcc/${XCC_VERSION}" --retry 3 --retry-delay 2 \
    --connect-timeout 15 --max-time 60 "$@" "${url}"
}

xcc_curl_quick() {
  local url="$1"
  shift
  curl -fL -A "xcc/${XCC_VERSION}" --connect-timeout 8 --max-time 12 "$@" "${url}"
}

# GitHub raw 在国内常 DNS 污染；按镜像顺序尝试。
github_file_urls() {
  local file="$1"
  local slug="${XCC_GITHUB_SLUG}"
  local branch="${XCC_GITHUB_BRANCH}"
  printf '%s\n' \
    "https://cdn.jsdelivr.net/gh/${slug}@${branch}/${file}" \
    "https://fastly.jsdelivr.net/gh/${slug}@${branch}/${file}" \
    "https://github.com/${slug}/raw/${branch}/${file}" \
    "https://raw.gitmirror.com/${slug}/${branch}/${file}" \
    "https://raw.githubusercontent.com/${slug}/${branch}/${file}" \
    "https://ghproxy.net/https://raw.githubusercontent.com/${slug}/${branch}/${file}"
}

# 从镜像列表下载仓库文件；全部失败则删除不完整文件。
download_github_file() {
  local dest="$1"
  local file="$2"
  local url
  init_tmp
  while IFS= read -r url; do
    [[ -n "${url}" ]] || continue
    info "尝试下载: ${url}"
    if curl -fL -A "xcc/${XCC_VERSION}" --connect-timeout 8 --max-time 90 -o "${dest}" "${url}"; then
      return 0
    fi
    rm -f "${dest}"
  done < <(github_file_urls "${file}")
  err "所有镜像均下载失败，请检查网络或为终端配置代理（socks5h）。"
  return 1
}

#===============================================================================
# 系统检测与依赖安装
# 严格顺序：先装依赖 → 再 curl 下载官方脚本 → 最后执行安装。
#===============================================================================
detect_os() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_ID="${ID:-unknown}"
    OS_VERSION_ID="${VERSION_ID:-0}"
  else
    OS_ID="unknown"
    OS_VERSION_ID="0"
  fi

  if command -v apt-get >/dev/null 2>&1; then
    PKG_MGR="apt"
  elif command -v dnf >/dev/null 2>&1; then
    PKG_MGR="dnf"
  elif command -v yum >/dev/null 2>&1; then
    PKG_MGR="yum"
  else
    PKG_MGR="unknown"
  fi
}

os_major() {
  printf '%s' "${OS_VERSION_ID%%.*}"
}

check_os_support() {
  local major
  major=$(os_major)
  case "${OS_ID}" in
    ubuntu)
      if [[ "${major}" -lt 24 ]]; then
        add_warning "当前 Ubuntu ${OS_VERSION_ID} 低于推荐版本 24.04，部分适配可能不可用。"
      fi
      ;;
    debian)
      if [[ "${major}" -lt 12 ]]; then
        add_warning "当前 Debian ${OS_VERSION_ID} 低于推荐版本 12。"
      fi
      ;;
    centos|rhel|rocky|almalinux|fedora)
      if [[ "${OS_ID}" != "fedora" && "${major}" -lt 9 ]]; then
        add_warning "当前 ${OS_ID} ${OS_VERSION_ID} 低于推荐版本 9。"
      fi
      ;;
    *)
      add_warning "未识别的发行版 ${OS_ID}，将尝试继续安装。"
      ;;
  esac
}

# 所有 apt 操作前统一设置非交互，避免卡住 TUI。
apt_noninteractive() {
  export DEBIAN_FRONTEND=noninteractive
  DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a "$@"
}

pkg_update() {
  case "${PKG_MGR}" in
    apt) apt_noninteractive apt-get update -y ;;
    dnf) dnf makecache -y ;;
    yum) yum makecache -y ;;
    *) return 1 ;;
  esac
}

pkg_install() {
  [[ "$#" -eq 0 ]] && return 0
  case "${PKG_MGR}" in
    apt) apt_noninteractive apt-get install -y "$@" ;;
    dnf) dnf install -y "$@" ;;
    yum) yum install -y "$@" ;;
    *)
      err "无法识别包管理器，请手动安装: $*"
      return 1
      ;;
  esac
}

ensure_locale() {
  if [[ -z "${LANG:-}" || "${LANG}" == "C" || "${LANG}" == "POSIX" ]]; then
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
  fi
}

# 安装 curl/jq/unzip/bc/dialog/qrencode 等依赖。
ensure_deps() {
  local pkgs=()
  local missing=()
  local p

  detect_os

  pkgs=(curl jq unzip tar bc openssl ca-certificates nginx)
  if [[ "${PKG_MGR}" == "apt" ]]; then
    pkgs+=(dialog qrencode whiptail apparmor-utils)
  else
    pkgs+=(dialog qrencode newt)
  fi

  for p in "${pkgs[@]}"; do
    case "${p}" in
      whiptail|newt)
        if ! command -v whiptail >/dev/null 2>&1; then
          missing+=("${p}")
        fi
        ;;
      dialog)
        if ! command -v dialog >/dev/null 2>&1 && ! command -v whiptail >/dev/null 2>&1; then
          missing+=("${p}")
        fi
        ;;
      qrencode)
        command -v qrencode >/dev/null 2>&1 || missing+=("${p}")
        ;;
      apparmor-utils)
        if [[ "${OS_ID}" == "ubuntu" || "${OS_ID}" == "debian" ]]; then
          command -v aa-complain >/dev/null 2>&1 || missing+=("${p}")
        fi
        ;;
      ca-certificates)
        if [[ ! -f /etc/ssl/certs/ca-certificates.crt && ! -f /etc/pki/tls/certs/ca-bundle.crt ]]; then
          missing+=("${p}")
        fi
        ;;
      *)
        command -v "${p}" >/dev/null 2>&1 || missing+=("${p}")
        ;;
    esac
  done

  if ! command -v ss >/dev/null 2>&1; then
    if [[ "${PKG_MGR}" == "apt" ]]; then
      missing+=(iproute2)
    else
      missing+=(iproute)
    fi
  fi

  if [[ "${#missing[@]}" -gt 0 ]]; then
    info "正在安装依赖: ${missing[*]}"
    pkg_update || warn "软件源更新失败，将继续尝试安装依赖。"
    pkg_install "${missing[@]}" || warn "部分依赖安装失败，稍后将尝试降级交互模式。"
  fi

  # TUI fallback：whiptail → dialog → 自动安装 whiptail → 纯命令行
  if ! command -v whiptail >/dev/null 2>&1 && ! command -v dialog >/dev/null 2>&1; then
    info "未检测到 whiptail/dialog，正在安装 whiptail..."
    if [[ "${PKG_MGR}" == "apt" ]]; then
      pkg_install whiptail || true
    else
      pkg_install newt || true
    fi
  fi
}

# TUI 后端检测顺序：whiptail → dialog → 纯命令行
tui_init() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    TUI_BACKEND="cli"
    warn "当前不是交互式终端，已切换为命令行模式。"
    return
  fi
  if command -v whiptail >/dev/null 2>&1; then
    TUI_BACKEND="whiptail"
  elif command -v dialog >/dev/null 2>&1; then
    TUI_BACKEND="dialog"
  else
    TUI_BACKEND="cli"
    warn "whiptail/dialog 均不可用，已降级为纯命令行交互。"
  fi
}

#===============================================================================
# TUI 封装（支持回车使用默认值）
#===============================================================================
tui_menu() {
  local title="$1"
  local text="$2"
  shift 2
  local choice=""
  case "${TUI_BACKEND}" in
    whiptail)
      choice=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --menu "${text}" 22 78 14 "$@" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      choice=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --menu "${text}" 22 78 14 "$@" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      local key val
      echo
      printf '%b== %s ==%b\n' "${BLUE}" "${title}" "${NC}"
      echo "${text}"
      while [[ $# -ge 2 ]]; do
        key="$1"; val="$2"; shift 2
        printf "  %s) %s\n" "${key}" "${val}"
      done
      read -r -p "请选择: " choice || return 1
      ;;
  esac
  printf '%s' "${choice}"
}

tui_input() {
  local title="$1"
  local text="$2"
  local default="${3:-}"
  local result=""
  case "${TUI_BACKEND}" in
    whiptail)
      result=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --inputbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      result=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --inputbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      echo
      printf '%b== %s ==%b\n' "${BLUE}" "${title}" "${NC}"
      if [[ -n "${default}" ]]; then
        read -r -p "${text} [${default}]: " result || return 1
      else
        read -r -p "${text}: " result || return 1
      fi
      ;;
  esac
  if [[ -z "${result}" && -n "${default}" ]]; then
    result="${default}"
  fi
  printf '%s' "${result}"
}

tui_password() {
  local title="$1"
  local text="$2"
  local default="${3:-}"
  local result=""
  case "${TUI_BACKEND}" in
    whiptail)
      result=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --passwordbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      result=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --passwordbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      echo
      read -r -s -p "${text}: " result || return 1
      echo
      ;;
  esac
  if [[ -z "${result}" && -n "${default}" ]]; then
    result="${default}"
  fi
  printf '%s' "${result}"
}

tui_yesno() {
  local title="$1"
  local text="$2"
  local default_no="${3:-0}"
  case "${TUI_BACKEND}" in
    whiptail)
      if [[ "${default_no}" == "1" ]]; then
        whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --defaultno --yesno "${text}" 12 78
      else
        whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --yesno "${text}" 12 78
      fi
      ;;
    dialog)
      local rc
      if [[ "${default_no}" == "1" ]]; then
        dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --defaultno --yesno "${text}" 12 78
      else
        dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --yesno "${text}" 12 78
      fi
      rc=$?
      clear
      return "${rc}"
      ;;
    cli)
      local ans
      read -r -p "${text} [y/N]: " ans || return 1
      [[ "${ans}" == "y" || "${ans}" == "Y" || "${ans}" == "yes" ]]
      ;;
    none|"")
      return 1
      ;;
  esac
}

tui_msg() {
  local title="$1"
  local text="$2"
  case "${TUI_BACKEND}" in
    whiptail)
      whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --msgbox "${text}" 16 78 || true
      ;;
    dialog)
      dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --msgbox "${text}" 16 78 || true
      clear
      ;;
    cli)
      echo
      printf '%b== %s ==%b\n%s\n' "${BLUE}" "${title}" "${NC}" "${text}"
      read -r -p "按回车继续..." _ || true
      ;;
    none|"")
      printf '%s: %s\n' "${title}" "${text}"
      ;;
