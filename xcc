#-------------------------------------------------------------------------------
# 运行时状态
#-------------------------------------------------------------------------------
TUI_BACKEND="cli"
OS_ID=""
OS_VERSION_ID=""
PKG_MGR=""
IN_CONFIG_OP=0
WATCHDOG_PAUSED=0
CURRENT_BACKUP=""
WARNINGS=()

#===============================================================================
# 基础输出
#===============================================================================

info()  { printf '%b[INFO]%b %s\n' "${GREEN}" "${NC}" "$*"; }
warn()  { printf '%b[WARN]%b %s\n' "${YELLOW}" "${NC}" "$*"; }
err()   { printf '%b[ERROR]%b %s\n' "${RED}" "${NC}" "$*" >&2; }
die()   { err "$*"; exit 1; }

add_warning() {
  WARNINGS+=("$1")
  warn "$1"
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    die "请使用 root 用户运行 xcc（例如: sudo xcc run）"
  fi
}

#===============================================================================
# 日志（看门狗与主脚本共用）
# 每次写入前检查体积，超过 50MB 则自行轮转。
#===============================================================================
rotate_xcc_log_if_needed() {
  local size
  if [[ -f "${XCC_LOG}" ]]; then
    size=$(wc -c < "${XCC_LOG}" 2>/dev/null | tr -d ' ' || echo 0)
    if [[ "${size}" -gt 52428800 ]]; then
      mv "${XCC_LOG}" "${XCC_LOG}.old" 2>/dev/null || true
      : > "${XCC_LOG}"
    fi
  fi
}

xcc_log() {
  local level="$1"
  shift
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  mkdir -p "$(dirname "${XCC_LOG}")"
  rotate_xcc_log_if_needed
  printf '%s [%s] %s\n' "${ts}" "${level}" "$*" >> "${XCC_LOG}"
}

broadcast() {
  if command -v wall >/dev/null 2>&1; then
    printf '%s\n' "$*" | wall 2>/dev/null || true
  fi
}

#===============================================================================
# 临时文件（避免 /tmp 可能挂载为 noexec）
#===============================================================================
init_tmp() {
  mkdir -p "${XCC_TMP_DIR}" "${XCC_CACHE_DIR}"
  chmod 700 "${XCC_TMP_DIR}" 2>/dev/null || true
}

xcc_mktemp() {
  local suffix="${1:-}" f
  init_tmp
  f=$(mktemp "${XCC_TMP_DIR}/xcc-XXXXXX")
  if [[ -n "${suffix}" ]]; then
    mv "${f}" "${f}${suffix}"
    printf '%s' "${f}${suffix}"
  else
    printf '%s' "${f}"
  fi
}

# 使用 curl -f；失败时删除不完整文件并提示重试。
xcc_curl() {
  local dest="$1"
  local url="$2"
  shift 2
  init_tmp
  if ! curl -fL -A "xcc/${XCC_VERSION}" --retry 3 --retry-delay 2 \
      --connect-timeout 15 --max-time 180 "$@" -o "${dest}" "${url}"; then
    rm -f "${dest}"
    err "下载失败，请检查网络后重试: ${url}"
    return 1
  fi
  return 0
}

xcc_curl_stdout() {
  local url="$1"
  shift
  curl -fL -A "xcc/${XCC_VERSION}" --retry 3 --retry-delay 2 \
    --connect-timeout 15 --max-time 60 "$@" "${url}"
}

xcc_curl_quick() {
  local url="$1"
  shift
  curl -fL -A "xcc/${XCC_VERSION}" --connect-timeout 8 --max-time 12 "$@" "${url}"
}

# GitHub raw 在国内常 DNS 污染；按镜像顺序尝试。
github_file_urls() {
  local file="$1"
  local slug="${XCC_GITHUB_SLUG}"
  local branch="${XCC_GITHUB_BRANCH}"
  printf '%s\n' \
    "https://cdn.jsdelivr.net/gh/${slug}@${branch}/${file}" \
    "https://fastly.jsdelivr.net/gh/${slug}@${branch}/${file}" \
    "https://github.com/${slug}/raw/${branch}/${file}" \
    "https://raw.gitmirror.com/${slug}/${branch}/${file}" \
    "https://raw.githubusercontent.com/${slug}/${branch}/${file}" \
    "https://ghproxy.net/https://raw.githubusercontent.com/${slug}/${branch}/${file}"
}

# 从镜像列表下载仓库文件；全部失败则删除不完整文件。
download_github_file() {
  local dest="$1"
  local file="$2"
  local url
  init_tmp
  while IFS= read -r url; do
    [[ -n "${url}" ]] || continue
    info "尝试下载: ${url}"
    if curl -fL -A "xcc/${XCC_VERSION}" --connect-timeout 8 --max-time 90 -o "${dest}" "${url}"; then
      return 0
    fi
    rm -f "${dest}"
  done < <(github_file_urls "${file}")
  err "所有镜像均下载失败，请检查网络或为终端配置代理（socks5h）。"
  return 1
}

#===============================================================================
# 系统检测与依赖安装
# 严格顺序：先装依赖 → 再 curl 下载官方脚本 → 最后执行安装。
#===============================================================================
detect_os() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_ID="${ID:-unknown}"
    OS_VERSION_ID="${VERSION_ID:-0}"
  else
    OS_ID="unknown"
    OS_VERSION_ID="0"
  fi

  if command -v apt-get >/dev/null 2>&1; then
    PKG_MGR="apt"
  elif command -v dnf >/dev/null 2>&1; then
    PKG_MGR="dnf"
  elif command -v yum >/dev/null 2>&1; then
    PKG_MGR="yum"
  else
    PKG_MGR="unknown"
  fi
}

os_major() {
  printf '%s' "${OS_VERSION_ID%%.*}"
}

check_os_support() {
  local major
  major=$(os_major)
  case "${OS_ID}" in
    ubuntu)
      if [[ "${major}" -lt 24 ]]; then
        add_warning "当前 Ubuntu ${OS_VERSION_ID} 低于推荐版本 24.04，部分适配可能不可用。"
      fi
      ;;
    debian)
      if [[ "${major}" -lt 12 ]]; then
        add_warning "当前 Debian ${OS_VERSION_ID} 低于推荐版本 12。"
      fi
      ;;
    centos|rhel|rocky|almalinux|fedora)
      if [[ "${OS_ID}" != "fedora" && "${major}" -lt 9 ]]; then
        add_warning "当前 ${OS_ID} ${OS_VERSION_ID} 低于推荐版本 9。"
      fi
      ;;
    *)
      add_warning "未识别的发行版 ${OS_ID}，将尝试继续安装。"
      ;;
  esac
}

# 所有 apt 操作前统一设置非交互，避免卡住 TUI。
apt_noninteractive() {
  export DEBIAN_FRONTEND=noninteractive
  DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a "$@"
}

pkg_update() {
  case "${PKG_MGR}" in
    apt) apt_noninteractive apt-get update -y ;;
    dnf) dnf makecache -y ;;
    yum) yum makecache -y ;;
    *) return 1 ;;
  esac
}

pkg_install() {
  [[ "$#" -eq 0 ]] && return 0
  case "${PKG_MGR}" in
    apt) apt_noninteractive apt-get install -y "$@" ;;
    dnf) dnf install -y "$@" ;;
    yum) yum install -y "$@" ;;
    *)
      err "无法识别包管理器，请手动安装: $*"
      return 1
      ;;
  esac
}

ensure_locale() {
  if [[ -z "${LANG:-}" || "${LANG}" == "C" || "${LANG}" == "POSIX" ]]; then
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
  fi
}

# 安装 curl/jq/unzip/bc/dialog/qrencode 等依赖。
ensure_deps() {
  local pkgs=()
  local missing=()
  local p

  detect_os

  pkgs=(curl jq unzip bc openssl ca-certificates python3)
  if [[ "${PKG_MGR}" == "apt" ]]; then
    pkgs+=(dialog qrencode whiptail apparmor-utils)
  else
    pkgs+=(dialog qrencode newt)
  fi

  for p in "${pkgs[@]}"; do
    case "${p}" in
      whiptail|newt)
        if ! command -v whiptail >/dev/null 2>&1; then
          missing+=("${p}")
        fi
        ;;
      dialog)
        if ! command -v dialog >/dev/null 2>&1 && ! command -v whiptail >/dev/null 2>&1; then
          missing+=("${p}")
        fi
        ;;
      qrencode)
        command -v qrencode >/dev/null 2>&1 || missing+=("${p}")
        ;;
      apparmor-utils)
        if [[ "${OS_ID}" == "ubuntu" || "${OS_ID}" == "debian" ]]; then
          command -v aa-complain >/dev/null 2>&1 || missing+=("${p}")
        fi
        ;;
      ca-certificates)
        if [[ ! -f /etc/ssl/certs/ca-certificates.crt && ! -f /etc/pki/tls/certs/ca-bundle.crt ]]; then
          missing+=("${p}")
        fi
        ;;
      *)
        command -v "${p}" >/dev/null 2>&1 || missing+=("${p}")
        ;;
    esac
  done

  if ! command -v ss >/dev/null 2>&1; then
    if [[ "${PKG_MGR}" == "apt" ]]; then
      missing+=(iproute2)
    else
      missing+=(iproute)
    fi
  fi

  if [[ "${#missing[@]}" -gt 0 ]]; then
    info "正在安装依赖: ${missing[*]}"
    pkg_update || warn "软件源更新失败，将继续尝试安装依赖。"
    pkg_install "${missing[@]}" || warn "部分依赖安装失败，稍后将尝试降级交互模式。"
  fi

  # TUI fallback：whiptail → dialog → 自动安装 whiptail → 纯命令行
  if ! command -v whiptail >/dev/null 2>&1 && ! command -v dialog >/dev/null 2>&1; then
    info "未检测到 whiptail/dialog，正在安装 whiptail..."
    if [[ "${PKG_MGR}" == "apt" ]]; then
      pkg_install whiptail || true
    else
      pkg_install newt || true
    fi
  fi
}

# TUI 后端检测顺序：whiptail → dialog → 纯命令行
tui_init() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    TUI_BACKEND="cli"
    warn "当前不是交互式终端，已切换为命令行模式。"
    return
  fi
  if command -v whiptail >/dev/null 2>&1; then
    TUI_BACKEND="whiptail"
  elif command -v dialog >/dev/null 2>&1; then
    TUI_BACKEND="dialog"
  else
    TUI_BACKEND="cli"
    warn "whiptail/dialog 均不可用，已降级为纯命令行交互。"
  fi
}

#===============================================================================
# TUI 封装（支持回车使用默认值）
#===============================================================================
tui_menu() {
  local title="$1"
  local text="$2"
  shift 2
  local choice=""
  case "${TUI_BACKEND}" in
    whiptail)
      choice=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --menu "${text}" 22 78 14 "$@" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      choice=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --menu "${text}" 22 78 14 "$@" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      local key val
      echo
      printf '%b== %s ==%b\n' "${BLUE}" "${title}" "${NC}"
      echo "${text}"
      while [[ $# -ge 2 ]]; do
        key="$1"; val="$2"; shift 2
        printf "  %s) %s\n" "${key}" "${val}"
      done
      read -r -p "请选择: " choice || return 1
      ;;
  esac
  printf '%s' "${choice}"
}

tui_input() {
  local title="$1"
  local text="$2"
  local default="${3:-}"
  local result=""
  case "${TUI_BACKEND}" in
    whiptail)
      result=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --inputbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      result=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --inputbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      echo
      printf '%b== %s ==%b\n' "${BLUE}" "${title}" "${NC}"
      if [[ -n "${default}" ]]; then
        read -r -p "${text} [${default}]: " result || return 1
      else
        read -r -p "${text}: " result || return 1
      fi
      ;;
  esac
  if [[ -z "${result}" && -n "${default}" ]]; then
    result="${default}"
  fi
  printf '%s' "${result}"
}

tui_password() {
  local title="$1"
  local text="$2"
  local default="${3:-}"
  local result=""
  case "${TUI_BACKEND}" in
    whiptail)
      result=$(whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --passwordbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      ;;
    dialog)
      result=$(dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" \
        --passwordbox "${text}" 12 78 "${default}" 3>&1 1>&2 2>&3) || return 1
      clear
      ;;
    cli)
      echo
      read -r -s -p "${text}: " result || return 1
      echo
      ;;
  esac
  if [[ -z "${result}" && -n "${default}" ]]; then
    result="${default}"
  fi
  printf '%s' "${result}"
}

tui_yesno() {
  local title="$1"
  local text="$2"
  case "${TUI_BACKEND}" in
    whiptail)
      whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --yesno "${text}" 12 78
      ;;
    dialog)
      dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --yesno "${text}" 12 78
      local rc=$?
      clear
      return "${rc}"
      ;;
    cli)
      local ans
      read -r -p "${text} [y/N]: " ans || return 1
      [[ "${ans}" == "y" || "${ans}" == "Y" || "${ans}" == "yes" ]]
      ;;
  esac
}

tui_msg() {
  local title="$1"
  local text="$2"
  case "${TUI_BACKEND}" in
    whiptail)
      whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --msgbox "${text}" 16 78 || true
      ;;
    dialog)
      dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --msgbox "${text}" 16 78 || true
      clear
      ;;
    cli)
      echo
      printf '%b== %s ==%b\n%s\n' "${BLUE}" "${title}" "${NC}" "${text}"
      read -r -p "按回车继续..." _ || true
      ;;
  esac
}

tui_infobox() {
  local text="$1"
  case "${TUI_BACKEND}" in
    whiptail)
      whiptail --backtitle "${XCC_BACKTITLE}" --title "xcc" --infobox "${text}" 8 78
      sleep 1
      ;;
    dialog)
      dialog --backtitle "${XCC_BACKTITLE}" --title "xcc" --infobox "${text}" 8 78
      sleep 1
      clear
      ;;
    cli)
      echo "${text}"
      sleep 1
      ;;
  esac
}

tui_textbox_file() {
  local title="$1"
  local file="$2"
  case "${TUI_BACKEND}" in
    whiptail)
      whiptail --backtitle "${XCC_BACKTITLE}" --title "${title}" --textbox "${file}" 20 78 || true
      ;;
    dialog)
      dialog --backtitle "${XCC_BACKTITLE}" --title "${title}" --textbox "${file}" 20 78 || true
      clear
      ;;
    cli)
      echo
      cat "${file}"
      read -r -p "按回车继续..." _ || true
      ;;
  esac
}

#===============================================================================
# Ubuntu 24.04+ 环境适配检测
#===============================================================================
is_svc_active() {
  systemctl is-active --quiet "$1" 2>/dev/null
}

# NTP 时间同步：未同步则自动开启。
check_ntp() {
  if ! command -v timedatectl >/dev/null 2>&1; then
    return 0
  fi
  local status
  status=$(timedatectl status 2>/dev/null || true)
  if ! printf '%s' "${status}" | grep -Eqi 'NTP synchronized: yes|System clock synchronized: yes'; then
    info "NTP 未同步，正在执行 timedatectl set-ntp true"
    timedatectl set-ntp true 2>/dev/null || warn "无法启用 NTP，Reality/TLS 可能因时间偏差失败。"
  fi
}

# cloud-init 可能重置防火墙规则。
check_cloud_init() {
  if [[ -f /etc/cloud/cloud.cfg ]]; then
    add_warning "cloud-init 可能重置防火墙规则，建议创建 /etc/cloud/cloud.cfg.d/99_disable_network.cfg 禁用网络管理。"
  fi
}

# NetworkManager 可能干扰服务器网络配置。
check_network_manager() {
  if is_svc_active NetworkManager; then
    add_warning "NetworkManager 可能干扰网络配置，建议在纯服务器环境中禁用。"
  fi
}

# unattended-upgrades 可能自动重启服务。
check_unattended_upgrades() {
  if is_svc_active unattended-upgrades; then
    add_warning "自动更新可能重启服务，建议手动配置排除 Xray。"
  fi
}

# 旧版包管理器 Xray 残留（/etc/xray/）。
check_legacy_xray_pkg() {
  if [[ -d /etc/xray ]]; then
    add_warning "检测到包管理器安装的旧版 Xray（apt install xray），建议执行 apt purge xray -y 后再继续。"
    if [[ -t 0 ]]; then
      if tui_yesno "旧版 Xray" "检测到 /etc/xray/，是否现在执行 apt purge xray -y？"; then
        if [[ "${PKG_MGR}" == "apt" ]]; then
          apt_noninteractive apt-get purge -y xray || true
        fi
      fi
    fi
  fi
}

# AppArmor 拒绝记录自动降为 complain。
check_apparmor_xray() {
  if [[ ! -f /var/log/syslog ]]; then
    return 0
  fi
  if grep -qi "apparmor.*denied.*xray" /var/log/syslog 2>/dev/null; then
    warn "检测到 AppArmor 拒绝 Xray，正在执行 aa-complain。"
    command -v aa-complain >/dev/null 2>&1 || pkg_install apparmor-utils || true
    aa-complain /usr/local/bin/xray 2>/dev/null || true
  fi
}

dns_servers_json() {
  if is_svc_active systemd-resolved; then
    printf '%s' '["https://1.1.1.1/dns-query","tcp://1.1.1.1:53"]'
  else
    printf '%s' '["1.1.1.1","8.8.8.8"]'
  fi
}

#===============================================================================
# 防火墙：nftables → ufw → firewalld → iptables
#===============================================================================
fw_kind() {
  if is_svc_active nftables; then
    printf 'nftables'
    return
  fi
  if command -v ufw >/dev/null 2>&1; then
    local st
    st=$(ufw status 2>/dev/null | head -n1 || true)
    if printf '%s' "${st}" | grep -qi 'active'; then
      printf 'ufw'
      return
    fi
  fi
  if is_svc_active firewalld; then
    printf 'firewalld'
    return
  fi
  if command -v iptables >/dev/null 2>&1; then
    printf 'iptables'
    return
  fi
  printf 'none'
}

# 放行 TCP 端口；ufw inactive 时跳过 ufw。
fw_allow_tcp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    nftables)
      nft add table inet filter 2>/dev/null || true
      nft 'add chain inet filter input { type filter hook input priority 0; }' 2>/dev/null || true
      if nft add rule inet filter input tcp dport "${port}" accept 2>/dev/null; then
        nft list ruleset > /etc/nftables.conf 2>/dev/null || true
        info "nftables 已放行 TCP ${port}"
      else
        warn "nftables 放行 TCP ${port} 失败，请手动放行。"
      fi
      ;;
    ufw)
      ufw allow "${port}/tcp" >/dev/null
      ufw reload >/dev/null || true
      info "ufw 已放行 TCP ${port}"
      ;;
    firewalld)
      firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null
      firewall-cmd --reload >/dev/null
      info "firewalld 已放行 TCP ${port}"
      ;;
    iptables)
      iptables -I INPUT -p tcp --dport "${port}" -j ACCEPT
      mkdir -p /etc/iptables
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      info "iptables 已放行 TCP ${port}"
      ;;
    *)
      warn "未检测到防火墙，请手动放行端口 ${port}"
      ;;
  esac
}

fw_allow_udp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    nftables)
      nft add table inet filter 2>/dev/null || true
      nft 'add chain inet filter input { type filter hook input priority 0; }' 2>/dev/null || true
      nft add rule inet filter input udp dport "${port}" accept 2>/dev/null || true
      nft list ruleset > /etc/nftables.conf 2>/dev/null || true
      ;;
    ufw)
      ufw allow "${port}/udp" >/dev/null
      ufw reload >/dev/null || true
      ;;
    firewalld)
      firewall-cmd --permanent --add-port="${port}/udp" >/dev/null
      firewall-cmd --reload >/dev/null
      ;;
    iptables)
      iptables -I INPUT -p udp --dport "${port}" -j ACCEPT
      mkdir -p /etc/iptables
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      ;;
    *)
      warn "未检测到防火墙，请手动放行 UDP 端口 ${port}"
      ;;
  esac
}

fw_delete_tcp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    ufw)
      ufw delete allow "${port}/tcp" >/dev/null 2>&1 || true
      ufw reload >/dev/null || true
      ;;
    firewalld)
      firewall-cmd --permanent --remove-port="${port}/tcp" >/dev/null 2>&1 || true
      firewall-cmd --reload >/dev/null 2>&1 || true
      ;;
    iptables)
      iptables -D INPUT -p tcp --dport "${port}" -j ACCEPT 2>/dev/null || true
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      ;;
    nftables)
      warn "nftables 删除规则需手动处理（请用 nft -a list ruleset 查找 handle）。"
      ;;
  esac
}

#===============================================================================
# 目录、版本、节点 JSON
#===============================================================================
ensure_dirs() {
  mkdir -p "${XCC_DIR}" "${XCC_BACKUP_DIR}" "${HYSTERIA_DIR}" \
    "${XCC_CERT_DIR}" "${XCC_SUB_DIR}" \
    "$(dirname "${XRAY_CONF}")" "${XCC_TMP_DIR}" "${XCC_CACHE_DIR}"
  chmod 700 "${XCC_DIR}" "${XCC_BACKUP_DIR}" "${HYSTERIA_DIR}" "${XCC_CERT_DIR}"
  if [[ ! -f "${XCC_NODES}" ]]; then
    printf '%s\n' '{"reality":[],"hysteria":[],"vless_ws":[],"vmess":[],"trojan":[],"shadowsocks":[],"settings":'"${XCC_SETTINGS_DEFAULT}"'}' > "${XCC_NODES}"
    chmod 600 "${XCC_NODES}"
  else
    migrate_nodes_json
  fi
  if [[ ! -f "${XCC_VERSION_FILE}" ]]; then
    printf '%s\n' "${XCC_CONFIG_FORMAT}" > "${XCC_VERSION_FILE}"
  fi
  if [[ ! -f "${XRAY_CONF}" ]]; then
    printf '%s\n' '{"inbounds":[]}' > "${XRAY_CONF}"
    chmod 600 "${XRAY_CONF}"
  fi
}

# 兼容 1.x nodes.json，补齐 2.0 字段。
migrate_nodes_json() {
  [[ -f "${XCC_NODES}" ]] || return 0
  local tmp
  tmp=$(xcc_mktemp)
  if jq --argjson st "${XCC_SETTINGS_DEFAULT}" '
      .vless_ws //= []
      | .vmess //= []
      | .trojan //= []
      | .shadowsocks //= []
      | .settings = ($st + (.settings // {}))
    ' "${XCC_NODES}" > "${tmp}" 2>/dev/null; then
    mv "${tmp}" "${XCC_NODES}"
    chmod 600 "${XCC_NODES}"
  else
    rm -f "${tmp}"
  fi
}

check_config_format() {
  local ver
  ver=$(tr -d ' \n' < "${XCC_VERSION_FILE}" 2>/dev/null || echo "")
  if [[ -n "${ver}" && "${ver}" != "${XCC_CONFIG_FORMAT}" ]]; then
    add_warning "配置格式已从 ${ver} 升级到 ${XCC_CONFIG_FORMAT}，已自动迁移旧节点。"
    printf '%s\n' "${XCC_CONFIG_FORMAT}" > "${XCC_VERSION_FILE}"
  fi
}

jq_file() {
  local file="$1"
  local expr="$2"
  local tmp
  tmp=$(xcc_mktemp)
  if jq "${expr}" "${file}" > "${tmp}"; then
    mv "${tmp}" "${file}"
    chmod 600 "${file}"
    return 0
  fi
  rm -f "${tmp}"
  return 1
}

# 若 config.json 不存在 inbounds 字段，先创建空数组再追加。
ensure_xray_inbounds_array() {
  mkdir -p "$(dirname "${XRAY_CONF}")"
  if [[ ! -s "${XRAY_CONF}" ]] || ! jq empty "${XRAY_CONF}" 2>/dev/null; then
    printf '%s\n' '{"inbounds":[]}' > "${XRAY_CONF}"
    chmod 600 "${XRAY_CONF}"
    return
  fi
  if ! jq -e '.inbounds' "${XRAY_CONF}" >/dev/null 2>&1; then
    jq_file "${XRAY_CONF}" '. + {inbounds: []}' || {
      printf '%s\n' '{"inbounds":[]}' > "${XRAY_CONF}"
      chmod 600 "${XRAY_CONF}"
    }
  fi
}

#===============================================================================
# 看门狗暂停 / 恢复（配置修改期间自动执行）
#===============================================================================
pause_watchdog() {
  if is_svc_active xcc-watchdog; then
    systemctl stop xcc-watchdog
    WATCHDOG_PAUSED=1
    tui_infobox "⏸ 看门狗已暂停，配置修改期间不会自动重启 Xray"
    xcc_log INFO "看门狗已暂停（配置修改）"
  else
    WATCHDOG_PAUSED=0
  fi
}

resume_watchdog() {
  if [[ "${WATCHDOG_PAUSED}" -eq 1 ]]; then
    systemctl start xcc-watchdog 2>/dev/null || true
    WATCHDOG_PAUSED=0
    tui_infobox "▶ 看门狗已恢复运行"
    xcc_log INFO "看门狗已恢复运行"
  fi
}

# 配置操作期间 Ctrl+C / 异常退出：回滚最新备份并恢复看门狗。
on_run_exit() {
  if [[ "${IN_CONFIG_OP}" -eq 1 && -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    restore_backup_dir "${CURRENT_BACKUP}" || true
    xcc_log WARN "配置操作异常退出，已从备份恢复"
  fi
  if [[ "${WATCHDOG_PAUSED}" -eq 1 ]]; then
    systemctl start xcc-watchdog >/dev/null 2>&1 || true
    WATCHDOG_PAUSED=0
  fi
}

begin_config_op() {
  IN_CONFIG_OP=1
  pause_watchdog
  CURRENT_BACKUP=$(backup_runtime_configs) || CURRENT_BACKUP=""
}

end_config_op_ok() {
  IN_CONFIG_OP=0
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    rm -rf "${CURRENT_BACKUP}"
  fi
  CURRENT_BACKUP=""
  resume_watchdog
}

end_config_op_fail() {
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    restore_backup_dir "${CURRENT_BACKUP}" || true
  fi
  IN_CONFIG_OP=0
  CURRENT_BACKUP=""
  resume_watchdog
}

end_config_op_cancel() {
  IN_CONFIG_OP=0
  if [[ -n "${CURRENT_BACKUP}" && -d "${CURRENT_BACKUP}" ]]; then
    rm -rf "${CURRENT_BACKUP}"
  fi
  CURRENT_BACKUP=""
  resume_watchdog
}

backup_runtime_configs() {
  local stamp dest
  stamp=$(date '+%Y%m%d-%H%M%S')
  dest="${XCC_BACKUP_DIR}/${stamp}"
  mkdir -p "${dest}"
  cp -a "${XCC_NODES}" "${dest}/nodes.json" 2>/dev/null || true
  cp -a "${XCC_OUTBOUND}" "${dest}/outbound.conf" 2>/dev/null || true
  cp -a "${XRAY_CONF}" "${dest}/xray.json" 2>/dev/null || true
  cp -a "${HYSTERIA_DIR}" "${dest}/hysteria" 2>/dev/null || true
  cp -a "${SSHD_CONFIG}" "${dest}/sshd_config" 2>/dev/null || true
  printf '%s' "${dest}"
}

restore_backup_dir() {
  local dest="$1"
  [[ -d "${dest}" ]] || return 1
  [[ -f "${dest}/nodes.json" ]] && cp -a "${dest}/nodes.json" "${XCC_NODES}"
  [[ -f "${dest}/outbound.conf" ]] && cp -a "${dest}/outbound.conf" "${XCC_OUTBOUND}"
  [[ -f "${dest}/xray.json" ]] && cp -a "${dest}/xray.json" "${XRAY_CONF}"
  [[ -f "${dest}/sshd_config" ]] && cp -a "${dest}/sshd_config" "${SSHD_CONFIG}"
  if [[ -d "${dest}/hysteria" ]]; then
    mkdir -p "${HYSTERIA_DIR}"
    cp -a "${dest}/hysteria/." "${HYSTERIA_DIR}/"
  fi
}

#===============================================================================
# 端口占用检测
#===============================================================================
port_busy_ss() {
  local port="$1"
  ss -H -tuln 2>/dev/null | awk '{print $5}' | grep -Eq ":${port}$"
}

port_used_by_nodes() {
  local port="$1"
  local skip_tag="${2:-}"
  jq -r --arg skip "${skip_tag}" --argjson port "${port}" '
    (.reality[]? | select(.tag != $skip) | .port),
    (.hysteria[]? | select(.tag != $skip) | .port)
  ' "${XCC_NODES}" 2>/dev/null | grep -qx "${port}"
}

assert_port_free() {
  local port="$1"
  local skip_tag="${2:-}"
  if ! [[ "${port}" =~ ^[0-9]+$ ]] || [[ "${port}" -lt 1 || "${port}" -gt 65535 ]]; then
    tui_msg "错误" "端口无效: ${port}"
    return 1
  fi
  if port_used_by_nodes "${port}" "${skip_tag}"; then
    tui_msg "端口占用" "端口 ${port} 已被 xcc 节点使用，请更换端口。"
    return 1
  fi
  if port_busy_ss "${port}"; then
    tui_msg "端口占用" "检测到端口 ${port} 已被占用（ss -tuln），请更换端口。"
    return 1
  fi
  return 0
}

#===============================================================================
# Xray / Hysteria 安装（必须先依赖，再 curl -f 下载，再执行）
#===============================================================================
arch_suffix() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64' ;;
    aarch64|arm64) printf 'arm64' ;;
    armv7l) printf 'armv7' ;;
    *) printf 'amd64' ;;
  esac
}

xray_installed_version() {
  if [[ -x "${XRAY_BIN}" ]]; then
    "${XRAY_BIN}" version 2>/dev/null | head -n1 | awk '{print $2}'
  fi
}

hysteria_installed_version() {
  if [[ -x "${HYSTERIA_BIN}" ]]; then
    "${HYSTERIA_BIN}" version 2>/dev/null | head -n1 | awk '{print $NF}' | tr -d ','
  fi
}

github_latest_tag() {
  local api="$1"
  xcc_curl_quick "${api}" 2>/dev/null | jq -r '.tag_name // empty'
}

version_newer() {
  local remote="${1#v}"
  local localv="${2#v}"
  [[ -z "${localv}" ]] && return 0
  [[ "${remote}" == "${localv}" ]] && return 1
  [[ "$(printf '%s\n%s\n' "${localv}" "${remote}" | sort -V | tail -n1)" == "${remote}" ]]
}

# 包管理器安装路径可能不是 /usr/local/bin，做兼容链接。
link_binary() {
  local dest="$1"
  local name="$2"
  if [[ -x "${dest}" ]]; then
    return 0
  fi
  local found
  found=$(command -v "${name}" 2>/dev/null || true)
  if [[ -n "${found}" && -x "${found}" && "${found}" != "${dest}" ]]; then
    ln -sf "${found}" "${dest}" 2>/dev/null || cp -a "${found}" "${dest}" || true
  fi
}

# 安装最新 TLS 版本 Xray（官方脚本，失败则降级包管理器）。
install_xray() {
  local script latest installed
  latest=$(github_latest_tag "${XRAY_RELEASE_API}" || true)
  installed=$(xray_installed_version || true)

  if [[ -x "${XRAY_BIN}" ]]; then
    info "已安装 Xray ${installed:-unknown}，最新版本 ${latest:-unknown}"
    if [[ -n "${latest}" ]] && version_newer "${latest}" "${installed}"; then
      if tui_yesno "Xray 升级" "检测到新版本 ${latest}（当前 ${installed}）。是否升级到最新 TLS 版本？"; then
        :
      else
        return 0
      fi
    else
      return 0
    fi
  fi

  check_legacy_xray_pkg
  info "正在通过官方脚本安装最新 Xray..."
  script=$(xcc_mktemp)
  if ! xcc_curl "${script}" "${XRAY_INSTALL_URL}"; then
    warn "官方安装脚本下载失败，尝试包管理器（可能不是最新 TLS 版本）。"
    pkg_install xray || return 1
    link_binary "${XRAY_BIN}" xray
    return 0
  fi
  chmod 700 "${script}"
  # 等价于官方推荐: bash -c "$(curl -L .../install-release.sh)" @ install
  if ! bash "${script}" install; then
    warn "官方脚本安装失败，尝试包管理器降级安装。"
    pkg_install xray || {
      rm -f "${script}"
      return 1
    }
    link_binary "${XRAY_BIN}" xray
  fi
  rm -f "${script}"
  link_binary "${XRAY_BIN}" xray
  mkdir -p "$(dirname "${XRAY_CONF}")"
  ensure_xray_inbounds_array
  systemctl enable xray >/dev/null 2>&1 || true
  check_apparmor_xray
  info "Xray 安装完成: $(xray_installed_version || echo unknown)"
}

install_hysteria() {
  local latest installed arch url tmp
  latest=$(github_latest_tag "${HYSTERIA_RELEASE_API}" || true)
  installed=$(hysteria_installed_version || true)
  arch=$(arch_suffix)

  if [[ -x "${HYSTERIA_BIN}" ]]; then
    info "已安装 Hysteria ${installed:-unknown}，最新版本 ${latest:-unknown}"
    if [[ -n "${latest}" ]] && version_newer "${latest}" "${installed}"; then
      if ! tui_yesno "Hysteria 升级" "检测到新版本 ${latest}（当前 ${installed}）。是否升级？"; then
        return 0
      fi
    else
      return 0
    fi
  fi

  info "正在从 GitHub Release 安装 Hysteria..."
  url="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-${arch}"
  tmp=$(xcc_mktemp)
  if ! xcc_curl "${tmp}" "${url}"; then
    warn "GitHub 下载 Hysteria 失败，尝试包管理器。"
    pkg_install hysteria || return 1
    link_binary "${HYSTERIA_BIN}" hysteria
    return 0
  fi
  chmod 755 "${tmp}"
  mv "${tmp}" "${HYSTERIA_BIN}"
  chmod 755 "${HYSTERIA_BIN}"
  link_binary "${HYSTERIA_BIN}" hysteria
  mkdir -p "${HYSTERIA_DIR}"
  chmod 700 "${HYSTERIA_DIR}"
  info "Hysteria 安装完成: $(hysteria_installed_version || echo unknown)"
}

