arch_suffix() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64' ;;
    aarch64|arm64) printf 'arm64' ;;
    armv7l) printf 'armv7' ;;
    *) printf 'amd64' ;;
  esac
}

xray_installed_version() {
  if [[ -x "${XRAY_BIN}" ]]; then
    "${XRAY_BIN}" version 2>/dev/null | head -n1 | awk '{print $2}'
  fi
}

hysteria_installed_version() {
  singbox_installed_version
}

singbox_installed_version() {
  if [[ -x "${SINGBOX_BIN}" ]]; then
    "${SINGBOX_BIN}" version 2>/dev/null | awk '/sing-box version/{print $3; exit}'
  fi
}

github_latest_tag() {
  local api="$1"
  xcc_curl_quick "${api}" 2>/dev/null | jq -r '.tag_name // empty'
}

version_newer() {
  local remote="${1#v}"
  local localv="${2#v}"
  [[ -z "${localv}" ]] && return 0
  [[ "${remote}" == "${localv}" ]] && return 1
  [[ "$(printf '%s\n%s\n' "${localv}" "${remote}" | sort -V | tail -n1)" == "${remote}" ]]
}

# 包管理器安装路径可能不是 /usr/local/bin，做兼容链接。
link_binary() {
  local dest="$1"
  local name="$2"
  if [[ -x "${dest}" ]]; then
    return 0
  fi
  local found
  found=$(command -v "${name}" 2>/dev/null || true)
  if [[ -n "${found}" && -x "${found}" && "${found}" != "${dest}" ]]; then
    ln -sf "${found}" "${dest}" 2>/dev/null || cp -a "${found}" "${dest}" || true
  fi
}

# 安装最新 TLS 版本 Xray（官方脚本，失败则降级包管理器）。
install_xray() {
  local mode="${1:-ask}"
  local script latest installed
  latest=$(github_latest_tag "${XRAY_RELEASE_API}" || true)
  installed=$(xray_installed_version || true)

  if [[ -x "${XRAY_BIN}" ]]; then
    info "已安装 Xray ${installed:-unknown}，最新版本 ${latest:-unknown}"
    if [[ -n "${latest}" ]] && version_newer "${latest}" "${installed}"; then
      if [[ "${mode}" == "auto" ]]; then
        xcc_log INFO "自动升级 Xray ${installed} -> ${latest}"
      elif tui_yesno "Xray 升级" "检测到新版本 ${latest}（当前 ${installed}）。是否升级到最新 TLS 版本？"; then
        :
      else
        return 0
      fi
    else
      return 0
    fi
  fi

  check_legacy_xray_pkg
  info "正在通过官方脚本安装最新 Xray..."
  script=$(xcc_mktemp)
  if ! xcc_curl "${script}" "${XRAY_INSTALL_URL}"; then
    warn "官方安装脚本下载失败，尝试包管理器（可能不是最新 TLS 版本）。"
    pkg_install xray || return 1
    link_binary "${XRAY_BIN}" xray
    return 0
  fi
  chmod 700 "${script}"
  # 等价于官方推荐: bash -c "$(curl -L .../install-release.sh)" @ install
  if ! bash "${script}" install; then
    warn "官方脚本安装失败，尝试包管理器降级安装。"
    pkg_install xray || {
      rm -f "${script}"
      return 1
    }
    link_binary "${XRAY_BIN}" xray
  fi
  rm -f "${script}"
  link_binary "${XRAY_BIN}" xray
  mkdir -p "$(dirname "${XRAY_CONF}")"
  ensure_xray_inbounds_array
  systemctl enable xray >/dev/null 2>&1 || true
  check_apparmor_xray
  info "Xray 安装完成: $(xray_installed_version || echo unknown)"
}

install_geodata() {
  local script dest
  dest="${XRAY_DAT_DIR}"
  mkdir -p "${dest}"
  script=$(xcc_mktemp)
  if xcc_curl "${script}" "${XRAY_INSTALL_DAT_URL}" 2>/dev/null && bash "${script}" >/dev/null 2>&1; then
    rm -f "${script}"
    xcc_log INFO "已更新 Xray geoip/geosite（官方 dat 脚本）"
    return 0
  fi
  rm -f "${script}"
  local geoip geosite url
  geoip=$(xcc_mktemp)
  geosite=$(xcc_mktemp)
  for url in \
    "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat" \
    "https://ghproxy.net/https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"; do
    if xcc_curl "${geoip}" "${url}" 2>/dev/null; then
      break
    fi
  done
  for url in \
    "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat" \
    "https://ghproxy.net/https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat"; do
    if xcc_curl "${geosite}" "${url}" 2>/dev/null; then
      break
    fi
  done
