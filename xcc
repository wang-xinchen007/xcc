menu_config_tun() {
  local name gw gw6 mtu auto_route ipv6 tag node exist n
  begin_config_op
  if ! tun_device_available; then
    tui_msg "错误" "本机没有 /dev/net/tun。OpenVZ / 部分 LXC 需先在宿主机打开 TUN。"
    end_config_op_cancel
    return 1
  fi
  n=$(jq '[.tun[]?] | length' "${XCC_NODES}" 2>/dev/null || echo 0)
  if [[ "${n}" =~ ^[0-9]+$ && "${n}" -gt 0 ]]; then
    if ! tui_yesno "已有 TUN" "通常只需一个 TUN 接口。是否再添加？"; then
      end_config_op_cancel
      return 1
    fi
  fi
  name=$(tui_input "TUN" "接口名（Linux 最长 15 字符）" "${TUN_DEFAULT_NAME}") || { end_config_op_cancel; return 1; }
  if ! [[ "${name}" =~ ^[A-Za-z][A-Za-z0-9_-]{0,14}$ ]]; then
    tui_msg "错误" "接口名无效：需字母开头，仅字母数字 _ -，最长 15。"
    end_config_op_cancel
    return 1
  fi
  exist=$(jq -r --arg n "${name}" '[.tun[]? | select(.name==$n)] | length' "${XCC_NODES}" 2>/dev/null || echo 0)
  if [[ "${exist}" =~ ^[0-9]+$ && "${exist}" -gt 0 ]]; then
    tui_msg "错误" "接口名 ${name} 已被其它 TUN 节点占用。"
    end_config_op_cancel
    return 1
  fi
  gw=$(tui_input "TUN" "接口 IPv4 网关（CIDR）" "${TUN_DEFAULT_GATEWAY}") || { end_config_op_cancel; return 1; }
  if ! [[ "${gw}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]]; then
    tui_msg "错误" "IPv4 网关需写成 CIDR，例如 ${TUN_DEFAULT_GATEWAY}"
    end_config_op_cancel
    return 1
  fi
  ipv6=false
  gw6=""
  if tui_yesno "TUN IPv6" "是否同时配置 IPv6 网关？" 1; then
    ipv6=true
    gw6=$(tui_input "TUN" "接口 IPv6 网关（CIDR）" "${TUN_DEFAULT_GATEWAY6}") || { end_config_op_cancel; return 1; }
  fi
  mtu=$(tui_input "TUN" "MTU" "${TUN_DEFAULT_MTU}") || { end_config_op_cancel; return 1; }
  if ! [[ "${mtu}" =~ ^[0-9]+$ ]]; then
    tui_msg "错误" "MTU 无效"
    end_config_op_cancel
    return 1
  fi
  auto_route=$(tui_menu "TUN 系统路由" "对齐 3X-UI autoSystemRoutingTable。默认只建接口，不劫持本机默认路由。" \
    "off" "仅建接口（其它机器策略路由进来）" \
    "ipv4" "本机 IPv4 全局透明代理（0.0.0.0/0）" \
    "both" "本机 IPv4+IPv6 全局透明代理") || { end_config_op_cancel; return 1; }
  if [[ "${auto_route}" != "off" ]]; then
    if ! tui_yesno "TUN 警告" "会把默认路由写入系统。出站失败时 SSH 可能断连。已设 autoOutboundsInterface=auto 防 Xray 回环，私网默认走 direct。确定继续？"; then
      end_config_op_cancel
      return 1
    fi
  fi
  tag="tun-${name}"
  node=$(jq -n --arg tag "${tag}" --arg name "${name}" --argjson mtu "${mtu}" \
    --arg gw "${gw}" --arg gw6 "${gw6}" --argjson ipv6 "${ipv6}" --arg auto_route "${auto_route}" \
    '{
      tag:$tag, enabled:true, email:$tag, outbound:"proxy",
      name:$name, mtu:$mtu, gateway:[$gw], gateway6:$gw6, ipv6:$ipv6,
      dns:["1.1.1.1","8.8.8.8"],
      auto_route:$auto_route, auto_iface:"auto", private_direct:true
    }')
  upsert_node tun "${node}"
  if apply_xray_config; then
    end_config_op_ok
    tui_msg "TUN 已创建" "$(tun_share_link "${node}")"
  else
    end_config_op_fail
  fi
}

menu_manage_tun() {
  local tag json choice ob auto_route
  tag=$(select_node_tag tun "管理 TUN") || return 1
  while true; do
    json=$(node_json_by_tag tun "${tag}")
    [[ -n "${json}" ]] || return 0
    choice=$(tui_menu "管理 TUN" "$(printf '%s' "${json}" | jq -r '"\(.tag) if=\(.name // "xcc0") \(if .enabled then "启用" else "禁用" end) route=\(.auto_route // "off") out=\(.outbound // "proxy")"')" \
      "toggle" "启用 / 禁用" \
      "out" "出站（proxy / direct / warp）" \
      "route" "系统路由（off / ipv4 / both）" \
      "share" "接口说明" \
      "del" "删除" \
      "back" "返回") || return 0
    case "${choice}" in
      toggle)
        begin_config_op
        if [[ "$(printf '%s' "${json}" | jq -r '.enabled')" == "true" ]]; then
          set_node_field tun "${tag}" enabled false 1
        else
          set_node_field tun "${tag}" enabled true 1
        fi
        if apply_xray_config; then end_config_op_ok; else end_config_op_fail; fi
        ;;
      out)
        begin_config_op
        ob=$(prompt_node_outbound "出站 ${tag}") || { end_config_op_cancel; continue; }
        set_node_field tun "${tag}" outbound "${ob}"
        if apply_xray_config; then end_config_op_ok; else end_config_op_fail; fi
        ;;
      route)
        begin_config_op
        auto_route=$(tui_menu "TUN 系统路由" "修改 autoSystemRoutingTable" \
          "off" "仅建接口" \
          "ipv4" "本机 IPv4 全局" \
          "both" "本机 IPv4+IPv6 全局") || { end_config_op_cancel; continue; }
        if [[ "${auto_route}" != "off" ]]; then
          if ! tui_yesno "TUN 警告" "会劫持本机默认路由，出站失败时 SSH 可能断连。确定？"; then
            end_config_op_cancel
            continue
          fi
        fi
        set_node_field tun "${tag}" auto_route "${auto_route}"
        if apply_xray_config; then end_config_op_ok; else end_config_op_fail; fi
        ;;
      share)
        tui_msg "TUN" "$(tun_share_link "${json}")"
        ;;
      del)
        begin_config_op
        if tui_yesno "删除" "确认删除 ${tag}？"; then
          delete_node tun "${tag}"
          if apply_xray_config; then end_config_op_ok; return 0; else end_config_op_fail; fi
        else
          end_config_op_cancel
        fi
        ;;
      back|*) return 0 ;;
    esac
  done
}

