  sni="localhost"
  if tui_yesno "ACME 证书" "是否启用 ACME（需要已解析到本机的域名）？"; then
    use_acme="true"
    domain=$(tui_input "ACME 域名" "请输入域名" "") || { end_config_op_cancel; return 1; }
    email=$(tui_input "ACME 邮箱" "请输入邮箱" "admin@${domain}") || { end_config_op_cancel; return 1; }
    sni="${domain}"
  else
    use_acme="false"
    tui_msg "自签名证书" "未启用 ACME，将生成自签名证书（客户端需 insecure，仅限测试）。"
  fi
  tag="hysteria-${port}"
  local node tmp insecure
  insecure="true"
  [[ "${use_acme}" == "true" ]] && insecure="false"
  node=$(jq -n \
    --arg tag "${tag}" \
    --argjson port "${port}" \
    --arg password "${password}" \
    --arg obfs "${obfs}" \
    --arg acme "${use_acme}" \
    --arg domain "${domain}" \
    --arg email "${email}" \
    --arg sni "${sni}" \
    --arg insecure "${insecure}" \
    '{
      tag:$tag, enabled:true, port:$port, password:$password, obfs:$obfs,
      acme:($acme=="true"), domain:$domain, email:$email, sni:$sni,
      insecure:($insecure=="true"), outbound:"proxy"
    }')
  tmp=$(xcc_mktemp)
  jq --arg tag "${tag}" --argjson node "${node}" \
    '(.hysteria) |= (map(select(.tag != $tag)) + [$node])' \
    "${XCC_NODES}" > "${tmp}"
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"
  fw_allow_udp "${port}"
  fw_allow_tcp "${port}"
  if apply_hysteria_config && apply_xray_config; then
    end_config_op_ok
    show_share_and_qr "Hysteria 节点已创建" "$(hysteria_share_link "${node}")"
  else
    tui_msg "错误" "写入 Hysteria 配置失败，已回滚。"
    end_config_op_fail
    return 1
  fi
}

#===============================================================================
# 节点选择
#===============================================================================
select_node_tag() {
  local kind="$1"
  local title="$2"
  local count items=() tag desc
  count=$(jq -r --arg k "${kind}" '(.[$k] // []) | length' "${XCC_NODES}")
  if [[ "${count}" -eq 0 ]]; then
    tui_msg "提示" "尚未配置 ${kind} 节点。"
    return 1
  fi
  while IFS=$'\t' read -r tag desc; do
    items+=("${tag}" "${desc}")
  done < <(jq -r --arg k "${kind}" '
    .[$k][] | [.tag, ((if .enabled then "启用" else "禁用" end) + " port=" + (.port|tostring) + " outbound=" + (.outbound // "proxy"))] | @tsv
  ' "${XCC_NODES}")
  tui_menu "${title}" "请选择节点" "${items[@]}"
}

node_json_by_tag() {
  local kind="$1"
  local tag="$2"
  jq -c --arg k "${kind}" --arg tag "${tag}" '.[$k][] | select(.tag==$tag)' "${XCC_NODES}"
}

upsert_node() {
  local kind="$1"
  local node="$2"
  local tag tmp
  tag=$(printf '%s' "${node}" | jq -r '.tag')
  tmp=$(xcc_mktemp)
  jq --arg k "${kind}" --arg tag "${tag}" --argjson node "${node}" \
    '.[$k] = (.[$k] | map(select(.tag != $tag)) + [$node])' \
    "${XCC_NODES}" > "${tmp}"
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"
}

delete_node() {
  local kind="$1"
  local tag="$2"
  local tmp
  tmp=$(xcc_mktemp)
  jq --arg k "${kind}" --arg tag "${tag}" '.[$k] |= map(select(.tag != $tag))' \
    "${XCC_NODES}" > "${tmp}"
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"
}

set_node_field() {
  local kind="$1" tag="$2" key="$3" value="$4" is_json="${5:-0}"
  local tmp
  tmp=$(xcc_mktemp)
  if [[ "${is_json}" -eq 1 ]]; then
    jq --arg k "${kind}" --arg tag "${tag}" --arg key "${key}" --argjson val "${value}" \
      '(.[$k][] | select(.tag==$tag) | .[$key]) = $val' "${XCC_NODES}" > "${tmp}"
  else
    jq --arg k "${kind}" --arg tag "${tag}" --arg key "${key}" --arg val "${value}" \
      '(.[$k][] | select(.tag==$tag) | .[$key]) = $val' "${XCC_NODES}" > "${tmp}"
  fi
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"
}

