hy2_cert_files() {
  local json="$1"
  local acme domain sni port cert key
  acme=$(printf '%s' "${json}" | jq -r '.acme')
  domain=$(printf '%s' "${json}" | jq -r '.domain // empty')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .domain // "localhost"')
  port=$(printf '%s' "${json}" | jq -r '.port')
  cert=$(jq -r '.settings.cert // empty' "${XCC_NODES}")
  key=$(jq -r '.settings.key // empty' "${XCC_NODES}")
  if [[ "${acme}" == "true" || ( -n "${domain}" && -f "${cert}" && -f "${key}" ) ]]; then
    HY2_CERT="${cert:-${XCC_CERT_DIR}/fullchain.pem}"
    HY2_KEY="${key:-${XCC_CERT_DIR}/privkey.pem}"
    return 0
  fi
  HY2_CERT="${XCC_CERT_DIR}/hy2-${port}.crt"
  HY2_KEY="${XCC_CERT_DIR}/hy2-${port}.key"
  if [[ ! -f "${HY2_CERT}" || ! -f "${HY2_KEY}" ]]; then
    openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
      -keyout "${HY2_KEY}" -out "${HY2_CERT}" -subj "/CN=${sni}" >/dev/null 2>&1
    chmod 600 "${HY2_KEY}"
  fi
}

# 按 v2ray-agent initSingBoxHysteria2Config 生成 sing-box 配置。
apply_singbox_config() {
  local hy_count
  hy_count=$(jq '[.hysteria[]? | select(.enabled==true)] | length' "${XCC_NODES}" 2>/dev/null || echo 0)
  if [[ "${hy_count}" -eq 0 ]]; then
    systemctl disable --now sing-box >/dev/null 2>&1 || true
    return 0
  fi
  install_singbox || return 1
  install_singbox_unit
  stop_legacy_hysteria
  mkdir -p "${SINGBOX_FRAG_DIR}"
  local tmp mode
  tmp=$(xcc_mktemp .json)
  mode=$(outbound_mode)
  local socks_json='null'
  if [[ "${mode}" == "proxy" ]]; then
    local url
    url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
    parse_socks5 "${url}"
    socks_json=$(jq -n \
      --arg host "${SOCKS_HOST}" \
      --argjson port "${SOCKS_PORT}" \
      --arg user "${SOCKS_USER}" \
      --arg pass "${SOCKS_PASS}" \
      '{
        type:"socks", tag:"socks5_outbound", server:$host, server_port:$port
      } + (if $user == "" then {} else {username:$user, password:$pass} end)')
  fi

  local inbounds='[]' routes='[]' json port password email sni up down obfs tag outbound
  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    hy2_cert_files "${json}"
    port=$(printf '%s' "${json}" | jq -r '.port')
    password=$(printf '%s' "${json}" | jq -r '.password')
    email=$(printf '%s' "${json}" | jq -r '.email // .tag // "xcc"')
    sni=$(printf '%s' "${json}" | jq -r '.sni // .domain // empty')
    [[ -n "${sni}" ]] || sni=$(tls_public_host)
    [[ -n "${sni}" ]] || sni="localhost"
    up=$(printf '%s' "${json}" | jq -r --argjson d "${HYSTERIA_DEFAULT_UP_MBPS}" '.up_mbps // $d')
    down=$(printf '%s' "${json}" | jq -r --argjson d "${HYSTERIA_DEFAULT_DOWN_MBPS}" '.down_mbps // $d')
    obfs=$(printf '%s' "${json}" | jq -r '.obfs // empty')
    tag=$(printf '%s' "${json}" | jq -r '.tag')
    outbound=$(printf '%s' "${json}" | jq -r '.outbound // "proxy"')
    inbounds=$(jq -c \
      --argjson acc "${inbounds}" \
      --argjson port "${port}" \
      --arg password "${password}" \
      --arg name "${email}-singbox_hysteria2" \
      --argjson up "${up}" \
      --argjson down "${down}" \
      --arg sni "${sni}" \
      --arg cert "${HY2_CERT}" \
      --arg key "${HY2_KEY}" \
      --arg obfs "${obfs}" \
      --arg tag "${tag}" \
      '$acc + [{
        type:"hysteria2",
        tag:$tag,
        listen:"::",
        listen_port:$port,
        users:[{password:$password, name:$name}],
        up_mbps:$up,
        down_mbps:$down,
        tls:{enabled:true, server_name:$sni, alpn:["h3"], certificate_path:$cert, key_path:$key}
      } + (if $obfs == "" then {} else {obfs:{type:"salamander", password:$obfs}} end)]')
    if [[ "${outbound}" != "direct" && "${mode}" == "proxy" ]]; then
      routes=$(jq -c --argjson acc "${routes}" --arg tag "${tag}" \
        '$acc + [{inbound:[$tag], outbound:"socks5_outbound"}]')
    fi
    fw_allow_udp "${port}"
    fw_allow_tcp "${port}"
  done < <(jq -c '.hysteria[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  if ! jq -n \
    --argjson inbounds "${inbounds}" \
    --argjson socks "${socks_json}" \
    --argjson routes "${routes}" \
    '{
      log:{level:"warn", timestamp:true},
      dns:{servers:[{tag:"local", type:"local"}]},
      inbounds:$inbounds,
      outbounds:
        ([{type:"direct", tag:"direct"}] + (if $socks == null then [] else [$socks] end)),
      route:{
        rules:$routes,
        final:"direct"
      }
    }' > "${tmp}"; then
    err "jq 生成 sing-box 配置失败"
    rm -f "${tmp}"
    return 1
  fi
  if ! singbox_test_config "${tmp}"; then
    err "sing-box 配置检查失败"
    "${SINGBOX_BIN}" check -c "${tmp}" 2>&1 | tail -n 20 >&2 || true
    rm -f "${tmp}"
    return 1
  fi
  mv "${tmp}" "${SINGBOX_CONF}"
  chmod 600 "${SINGBOX_CONF}"
  if [[ "${inbounds}" == "[]" ]]; then
    systemctl disable --now sing-box >/dev/null 2>&1 || true
    return 0
  fi
  systemctl enable --now sing-box >/dev/null 2>&1 || systemctl restart sing-box
}

