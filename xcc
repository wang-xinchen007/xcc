  local dest stamp
  stamp=$(date '+%Y%m%d-%H%M%S')
  dest="/root/xcc-backup-${stamp}.tar.gz"
  mkdir -p "${XCC_DIR}/export"
  cp -a "${XRAY_CONF}" "${XCC_DIR}/export/xray-config.json" 2>/dev/null || true
  if [[ -d "${SINGBOX_DIR}" ]]; then
    rm -rf "${XCC_DIR}/export/sing-box" "${XCC_DIR}/export/hysteria"
    cp -a "${SINGBOX_DIR}" "${XCC_DIR}/export/sing-box" 2>/dev/null || true
    cp -a "${SINGBOX_DIR}" "${XCC_DIR}/export/hysteria" 2>/dev/null || true
  fi
  if tar -czf "${dest}" -C /etc xcc; then
    chmod 600 "${dest}"
    tui_msg "备份完成" "已保存到 ${dest}"
  else
    tui_msg "错误" "备份失败"
  fi
}

menu_restore() {
  local files=() f choice
  shopt -s nullglob
  files=(/root/xcc-backup-*.tar.gz)
  shopt -u nullglob
  if [[ "${#files[@]}" -eq 0 ]]; then
    f=$(tui_input "恢复配置" "未在 /root 发现备份，请输入备份文件完整路径" "") || return 1
  else
    local items=()
    for f in "${files[@]}"; do
      items+=("${f}" "$(basename "${f}")")
    done
    items+=("custom" "输入自定义路径")
    choice=$(tui_menu "恢复配置" "选择备份文件" "${items[@]}") || return 1
    if [[ "${choice}" == "custom" ]]; then
      f=$(tui_input "恢复配置" "备份文件路径" "") || return 1
    else
      f="${choice}"
    fi
  fi
  [[ -f "${f}" ]] || { tui_msg "错误" "文件不存在: ${f}"; return 1; }
  if ! tui_yesno "确认恢复" "将用 ${f} 覆盖 /etc/xcc ，是否继续？"; then
    return 1
  fi
  begin_config_op
  tar -xzf "${f}" -C /etc
  if [[ -f "${XCC_DIR}/export/xray-config.json" ]]; then
    cp -a "${XCC_DIR}/export/xray-config.json" "${XRAY_CONF}"
  fi
  if [[ -d "${XCC_DIR}/export/sing-box" ]]; then
    mkdir -p "${SINGBOX_DIR}"
    cp -a "${XCC_DIR}/export/sing-box/." "${SINGBOX_DIR}/"
  elif [[ -d "${XCC_DIR}/export/hysteria" ]]; then
    mkdir -p "${SINGBOX_DIR}"
    cp -a "${XCC_DIR}/export/hysteria/." "${SINGBOX_DIR}/"
  fi
  chmod 600 "${XCC_NODES}" "${XCC_OUTBOUND}" "${XRAY_CONF}" 2>/dev/null || true
  if apply_all_configs; then
    end_config_op_ok
    tui_msg "完成" "配置已恢复。"
  else
    tui_msg "错误" "恢复后语法检查失败，已回滚。"
    end_config_op_fail
  fi
}

#===============================================================================
# 卸载
#===============================================================================
do_uninstall() {
  local also
  also="${1:-ask}"
  systemctl stop xcc-watchdog >/dev/null 2>&1 || true
  systemctl disable xcc-watchdog >/dev/null 2>&1 || true
  systemctl disable --now xcc-sub >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/xcc-sub.service
  stop_legacy_hysteria
  if [[ "${also}" == "ask" ]]; then
    if tui_yesno "卸载组件" "是否同时卸载 Xray、sing-box，并移除 Nginx 站点配置？"; then
      also="yes"
    else
      also="no"
    fi
  fi
  rm -f "${NGINX_CONF}"
  if command -v nginx >/dev/null 2>&1; then
    nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
  fi
  systemctl disable --now sing-box >/dev/null 2>&1 || true
  if [[ "${also}" == "yes" ]]; then
    systemctl stop xray >/dev/null 2>&1 || true
    systemctl disable xray >/dev/null 2>&1 || true
    systemctl stop sing-box >/dev/null 2>&1 || true
    rm -f "${XRAY_BIN}" "${SINGBOX_BIN}"
    rm -rf /usr/local/etc/xray "${SINGBOX_DIR}"
    if [[ -x /usr/local/bin/hysteria ]]; then
      rm -f /usr/local/bin/hysteria
    fi
    rm -rf /etc/hysteria
  fi
  rm -f "${WATCHDOG_UNIT}" "${SINGBOX_UNIT}" "${LOGROTATE_CONF}" "${XRAY_TUN_DROPIN}" "${XCC_TUN_SYSCTL}"
  rmdir /etc/systemd/system/xray.service.d 2>/dev/null || true
  systemctl daemon-reload || true
  rm -rf "${XCC_DIR}" "${XCC_TMP_DIR}"
  rm -f "${XCC_BIN}"
  info "xcc 已卸载。"
}

menu_uninstall() {
  local confirm
  confirm=$(tui_input "卸载 xcc" "此操作不可撤销。请输入 yes 确认卸载" "") || return 1
  if [[ "${confirm}" != "yes" ]]; then
    tui_msg "已取消" "未输入 yes，未执行卸载。"
    return 1
  fi
  do_uninstall ask
  tui_msg "完成" "xcc 已卸载，即将退出。"
  exit 0
}

cmd_uninstall() {
  need_root
  local confirm
  read -r -p "确认卸载 xcc？请输入 yes: " confirm
  if [[ "${confirm}" != "yes" ]]; then
    echo "已取消。"
    exit 1
  fi
  tui_init
  do_uninstall ask
}

#===============================================================================
# 更新：覆盖 /usr/local/bin/xcc，保留 /etc/xcc/
# 若 TUI（xcc run）正在运行则拒绝；看门狗会临时停止以便覆盖二进制。
#===============================================================================
cmd_update() {
  need_root
  if pgrep -af "xcc run" | grep -v "$$" >/dev/null 2>&1; then
    die "请先退出 xcc 再更新"
  fi
  # 字面检测 pgrep -f xcc：排除自身、update、watchdog
  local others
  others=$(pgrep -af "xcc" | grep -vE "($$|xcc update|xcc watchdog)" || true)
  if [[ -n "${others}" ]] && pgrep -f "xcc run" >/dev/null 2>&1; then
    die "请先退出 xcc 再更新"
  fi
  info "正在从 GitHub / 镜像下载最新 xcc..."
  local tmp
  tmp=$(xcc_mktemp)
  if ! download_github_file "${tmp}" "xcc"; then
    die "下载失败，请重试。"
  fi
  systemctl stop xcc-watchdog >/dev/null 2>&1 || true
  chmod 755 "${tmp}"
  mv "${tmp}" "${XCC_BIN}"
  chmod 755 "${XCC_BIN}"
  systemctl start xcc-watchdog >/dev/null 2>&1 || true
  info "更新完成。/etc/xcc/ 配置已保留。当前版本: $("${XCC_BIN}" version 2>/dev/null || echo unknown)"
}

check_remote_xcc_version() {
  local remote url
  while IFS= read -r url; do
    [[ -n "${url}" ]] || continue
    remote=$(xcc_curl_quick "${url}" 2>/dev/null \
      | grep -m1 '^XCC_VERSION=' | cut -d= -f2 | tr -d '"' || true)
    [[ -n "${remote}" ]] && break
  done < <(github_file_urls "xcc")
  [[ -n "${remote}" ]] || return 0
  if version_newer "${remote}" "${XCC_VERSION}"; then
    add_warning "GitHub 上有新版本 ${remote}（当前 ${XCC_VERSION}），可执行 xcc update 更新。"
  fi
}

#===============================================================================
# 看门狗：健康检查 / 熔断 / 出站切换 / 系统维护 / 每周更新
#===============================================================================
xray_nodes_enabled() {
  [[ -f "${XCC_NODES}" ]] || return 1
  jq -e '[
    (.reality[]?, .vless_ws[]?, .vless[]?, .vmess[]?, .trojan[]?,
     .shadowsocks[]?, .wireguard[]?, .http[]?, .socks[]?, .tunnel[]?, .tun[]?)
    | select(.enabled == true)
  ] | length > 0' "${XCC_NODES}" >/dev/null 2>&1
}

hy2_nodes_enabled() {
  [[ -f "${XCC_NODES}" ]] || return 1
  local n
  n=$(jq '[.hysteria[]? | select(.enabled==true)] | length' "${XCC_NODES}" 2>/dev/null || echo 0)
  [[ "${n}" =~ ^[0-9]+$ && "${n}" -gt 0 ]]
}

xray_expected_tcp_ports() {
  [[ -f "${XCC_NODES}" ]] || return 0
  local nginx_front="false"
  nginx_front_enabled && nginx_front="true"
  jq -r --argjson nginx_front "${nginx_front}" --argjson api "${XRAY_API_PORT}" '
    def nginxable: ((.network // "tcp") == "ws" or (.network // "") == "httpupgrade");
    [
      (.reality[]? | select(.enabled==true) | .port),
      (.vless_ws[]? | select(.enabled==true) | if $nginx_front then (.xray_port // 31297) else .port end),
      (.vless[]? | select(.enabled==true and ((.network // "tcp") != "kcp")) |
        if $nginx_front and nginxable then (.xray_port // 31297) else .port end),
      (.vmess[]? | select(.enabled==true and ((.network // "ws") != "kcp")) |
        if $nginx_front and nginxable then (.xray_port // 31299) else .port end),
      (.trojan[]? | select(.enabled==true) |
        if $nginx_front and nginxable then (.xray_port // 31300) else .port end),
      (.shadowsocks[]? | select(.enabled==true) | .port),
      (.http[]? | select(.enabled==true) | .port),
      (.socks[]? | select(.enabled==true) | .port),
      (.tunnel[]? | select(.enabled==true) | .port),
      (.wireguard[]? | select(.enabled==true) | .port)
    ] | map(select(. != null)) | unique | .[]
  ' "${XCC_NODES}" 2>/dev/null
  if xray_nodes_enabled; then
    printf '%s\n' "${XRAY_API_PORT}"
  fi
}

hy2_expected_udp_ports() {
  [[ -f "${XCC_NODES}" ]] || return 0
  jq -r '
    [
      (.hysteria[]? | select(.enabled==true) | .port),
      (.vless[]? | select(.enabled==true and (.network // "") == "kcp") | .port),
      (.vmess[]? | select(.enabled==true and (.network // "") == "kcp") | .port)
    ] | map(select(. != null)) | unique | .[]
  ' "${XCC_NODES}" 2>/dev/null
}

nginx_expected_tcp_ports() {
  [[ -f "${NGINX_CONF}" ]] || return 0
  printf '%s\n' "80"
  if nginx_front_enabled; then
    nginx_public_port
  fi
}

watchdog_tui_busy() {
  pgrep -af "xcc run" >/dev/null 2>&1
}

watchdog_read_count() {
  local f="$1"
  if [[ -f "${f}" ]] && [[ "$(tr -d ' \n' < "${f}")" =~ ^[0-9]+$ ]]; then
    tr -d ' \n' < "${f}"
  else
    printf '0'
  fi
}

watchdog_set_count() {
  local f="$1" n="$2"
  printf '%s\n' "${n}" > "${f}"
}

watchdog_inc_count() {
  local f="$1" n
  n=$(watchdog_read_count "${f}")
  n=$((n + 1))
  watchdog_set_count "${f}" "${n}"
  printf '%s' "${n}"
}

watchdog_reset_count() {
  rm -f "$1"
}

cert_days_left() {
  local f="$1" end now
  [[ -f "${f}" ]] || { printf '-1'; return 1; }
  end=$(openssl x509 -enddate -noout -in "${f}" 2>/dev/null | cut -d= -f2) || { printf '-1'; return 1; }
  end=$(date -d "${end}" +%s 2>/dev/null) || { printf '-1'; return 1; }
  now=$(date +%s)
  printf '%s' $(( (end - now) / 86400 ))
}

watchdog_apply_safe() {
  if watchdog_tui_busy; then
    xcc_log WARN "TUI 正在运行，跳过自动应用配置"
    return 1
  fi
  TUI_BACKEND=none
  apply_xray_config || return 1
  apply_singbox_config || return 1
  if [[ -f "${NGINX_CONF}" ]] || nginx_front_enabled; then
    apply_nginx_config || return 1
  fi
  return 0
}

watchdog_cleanup_old_logs() {
  find /var/log/ -name "xcc.log.*" -mtime +7 -delete 2>/dev/null || true
  find "${XCC_TMP_DIR}" -type f -mtime +1 -delete 2>/dev/null || true
  find /var/tmp -maxdepth 1 -name 'xcc-*' -mtime +2 -delete 2>/dev/null || true
}

watchdog_disk() {
  local usage
  usage=$(df -h / | awk 'NR==2{print $5}' | sed 's/%//')
  if ! [[ "${usage}" =~ ^[0-9]+$ ]]; then
    usage=$(df -P / | awk 'NR==2{print $5}' | sed 's/%//')
  fi
  if [[ "${usage}" =~ ^[0-9]+$ && "${usage}" -gt 85 ]]; then
    xcc_log ERROR "磁盘使用率 ${usage}% 超过 85%，正在清理日志 / 临时文件 / journal"
    broadcast "xcc 告警: 磁盘使用率 ${usage}% 超过 85%"
    watchdog_cleanup_old_logs
    journalctl --vacuum-size=200M >/dev/null 2>&1 || true
    find /var/log -type f -name '*.gz' -mtime +14 -delete 2>/dev/null || true
  fi
}

watchdog_load() {
  local load cores thr
  load=$(uptime | awk -F'load average:' '{print $2}' | cut -d, -f1 | tr -d ' ')
  cores=$(nproc 2>/dev/null || echo 1)
  if command -v bc >/dev/null 2>&1 && [[ -n "${load}" ]]; then
    thr=$(echo "${cores} * 2" | bc)
    if [[ $(echo "${load} > ${thr}" | bc -l) -eq 1 ]]; then
      xcc_log WARN "1 分钟负载 ${load} 超过阈值 ${thr}（CPU 核心数 ${cores} * 2）"
    fi
  fi
}

watchdog_count_recent_in() {
  local file="$1"
  local now cutoff
  now=$(date +%s)
  cutoff=$((now - 300))
  [[ -f "${file}" ]] || { printf '0'; return; }
  awk -v c="${cutoff}" '$1 >= c {n++} END {print n+0}' "${file}"
}

watchdog_record_restart_in() {
  local file="$1"
  mkdir -p "${XCC_DIR}"
  date +%s >> "${file}"
  tail -n 30 "${file}" > "${file}.tmp" 2>/dev/null || true
  mv "${file}.tmp" "${file}" 2>/dev/null || true
}

watchdog_count_recent_restarts() {
  watchdog_count_recent_in "${WATCHDOG_RESTARTS}"
}

watchdog_record_restart() {
  watchdog_record_restart_in "${WATCHDOG_RESTARTS}"
}

watchdog_circuit_ok() {
  local halt="$1" rec="$2" name="$3"
  if [[ -f "${halt}" ]]; then
    xcc_log ERROR "${name} 看门狗保护已触发，等待人工介入（主菜单重置）。"
    return 1
  fi
  local n
  n=$(watchdog_count_recent_in "${rec}")
  if [[ "${n}" -ge 3 ]]; then
    : > "${halt}"
    xcc_log ERROR "${name} 5 分钟内重启超过 3 次，已停止自动重启。"
    broadcast "xcc 紧急告警: ${name} 5 分钟内重启超过 3 次，已停止自动重启。"
    return 1
  fi
  return 0
}

watchdog_restart_svc() {
  local unit="$1" halt="$2" rec="$3" name="$4"
  watchdog_circuit_ok "${halt}" "${rec}" "${name}" || return 1
  if watchdog_tui_busy; then
    xcc_log WARN "TUI 正在运行，暂不重启 ${name}"
    return 1
  fi
  xcc_log WARN "${name} 不健康，正在 systemctl restart ${unit}"
  systemctl enable "${unit}" >/dev/null 2>&1 || true
  systemctl restart "${unit}" >/dev/null 2>&1 || true
  watchdog_record_restart_in "${rec}"
}

watchdog_nodes_json_ok() {
  [[ -f "${XCC_NODES}" ]] && jq empty "${XCC_NODES}" >/dev/null 2>&1
}

watchdog_missing_tcp_ports() {
  local p miss=0
  while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    if ! port_busy_tcp "${p}"; then
      xcc_log WARN "TCP ${p} 未在监听"
      miss=1
    fi
  done
  return "${miss}"
}

watchdog_missing_udp_ports() {
  local p miss=0
  while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    if ! port_busy_udp "${p}"; then
      xcc_log WARN "UDP ${p} 未在监听"
      miss=1
    fi
  done
  return "${miss}"
}

watchdog_missing_tun_ifaces() {
  local name miss=0
  [[ -f "${XCC_NODES}" ]] || return 0
  command -v ip >/dev/null 2>&1 || return 0
  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    if ! ip -o link show "${name}" >/dev/null 2>&1; then
      xcc_log WARN "TUN 接口 ${name} 不存在"
      miss=1
    fi
  done < <(jq -r '.tun[]? | select(.enabled==true) | .name // "xcc0"' "${XCC_NODES}" 2>/dev/null)
  return "${miss}"
}

watchdog_xray_api_ok() {
  [[ -x "${XRAY_BIN}" ]] || return 0
  if timeout 4 "${XRAY_BIN}" api statssys --server="${XRAY_API_ADDR}" >/dev/null 2>&1 \
    || timeout 4 "${XRAY_BIN}" api statsquery --server="${XRAY_API_ADDR}" >/dev/null 2>&1; then
    return 0
  fi
  if timeout 3 bash -c "echo >/dev/tcp/127.0.0.1/${XRAY_API_PORT}" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

watchdog_repair_xray_config() {
  if ! watchdog_nodes_json_ok; then
    xcc_log ERROR "nodes.json 损坏，拒绝重建 Xray 配置，请人工修复 ${XCC_NODES}"
    broadcast "xcc 紧急告警: nodes.json 损坏，看门狗已停止自动改配置。"
    return 1
  fi
  if [[ -x "${XRAY_BIN}" && -f "${XRAY_CONF}" ]] && xray_test_config "${XRAY_CONF}"; then
    return 0
  fi
  xcc_log WARN "Xray 配置缺失或语法失败，正在从 nodes.json 重建"
  watchdog_apply_safe || {
    xcc_log ERROR "从 nodes.json 重建 Xray 配置失败"
    return 1
  }
  return 0
}

watchdog_check_xray() {
  xray_nodes_enabled || return 0
  [[ -x "${XRAY_BIN}" ]] || return 0

  if ! watchdog_nodes_json_ok; then
    xcc_log ERROR "nodes.json 无效，跳过 Xray 重启以免放大故障"
    return 0
  fi

  if [[ -f "${WATCHDOG_HALT}" ]]; then
    xcc_log ERROR "Xray 看门狗保护已触发，仅尝试修复配置。"
    watchdog_repair_xray_config || true
    return 0
  fi

  if ! watchdog_repair_xray_config; then
    xcc_log ERROR "无法修复 Xray 配置，本轮不重启，以免坏配置死循环"
    return 0
  fi

  local unhealthy=0
  if ! is_svc_active xray; then
    unhealthy=1
    xcc_log WARN "Xray 服务未运行"
  else
    if ! xray_expected_tcp_ports | watchdog_missing_tcp_ports; then
      unhealthy=1
    fi
    if ! watchdog_missing_tun_ifaces; then
      unhealthy=1
    fi
    if ! watchdog_xray_api_ok; then
      xcc_log WARN "Xray API ${XRAY_API_ADDR} 无响应（进程可能卡死）"
      unhealthy=1
    fi
  fi

  if [[ "${unhealthy}" -eq 0 ]]; then
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_XRAY}"
    return 0
  fi
  local n
  n=$(watchdog_inc_count "${WATCHDOG_UNHEALTHY_XRAY}")
  if [[ "${n}" -ge 2 ]]; then
    watchdog_restart_svc xray "${WATCHDOG_HALT}" "${WATCHDOG_RESTARTS}" "Xray" || true
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_XRAY}"
  fi
}

watchdog_check_singbox() {
  hy2_nodes_enabled || return 0
  if [[ -f "${WATCHDOG_HALT_SB}" ]]; then
    xcc_log ERROR "sing-box 看门狗保护已触发，仅尝试校验配置。"
    if [[ -f "${SINGBOX_CONF}" ]]; then
      singbox_test_config "${SINGBOX_CONF}" || watchdog_apply_safe || true
    fi
    return 0
  fi
  if [[ -f "${SINGBOX_CONF}" ]] && ! singbox_test_config "${SINGBOX_CONF}"; then
    xcc_log WARN "sing-box 配置损坏，正在重建"
    if ! watchdog_apply_safe; then
      watchdog_restart_svc sing-box "${WATCHDOG_HALT_SB}" "${WATCHDOG_RESTARTS_SB}" "sing-box" || true
      return 0
    fi
  fi
  local unhealthy=0
  if ! is_svc_active sing-box; then
    unhealthy=1
  elif ! hy2_expected_udp_ports | watchdog_missing_udp_ports; then
    unhealthy=1
  fi
  if [[ "${unhealthy}" -eq 0 ]]; then
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_SB}"
    return 0
  fi
  local n
  n=$(watchdog_inc_count "${WATCHDOG_UNHEALTHY_SB}")
  if [[ "${n}" -ge 2 ]]; then
    watchdog_restart_svc sing-box "${WATCHDOG_HALT_SB}" "${WATCHDOG_RESTARTS_SB}" "sing-box" || true
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_SB}"
  fi
}

watchdog_check_nginx() {
  command -v nginx >/dev/null 2>&1 || return 0
  [[ -f "${NGINX_CONF}" ]] || return 0
  if [[ -f "${WATCHDOG_HALT_NGINX}" ]]; then
    xcc_log ERROR "Nginx 看门狗保护已触发，仅尝试 nginx -t / 重建。"
    nginx -t >/dev/null 2>&1 || watchdog_apply_safe || true
    return 0
  fi
  if ! nginx -t >/dev/null 2>&1; then
    xcc_log WARN "nginx -t 失败，正在重建站点配置"
    if ! watchdog_apply_safe || ! nginx -t >/dev/null 2>&1; then
      watchdog_restart_svc nginx "${WATCHDOG_HALT_NGINX}" "${WATCHDOG_RESTARTS_NGINX}" "Nginx" || true
      return 0
    fi
  fi
  local unhealthy=0
  if ! is_svc_active nginx; then
    unhealthy=1
  elif ! nginx_expected_tcp_ports | watchdog_missing_tcp_ports; then
    unhealthy=1
  fi
  if [[ "${unhealthy}" -eq 0 ]]; then
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_NGINX}"
    return 0
  fi
  local n
  n=$(watchdog_inc_count "${WATCHDOG_UNHEALTHY_NGINX}")
  if [[ "${n}" -ge 2 ]]; then
    watchdog_restart_svc nginx "${WATCHDOG_HALT_NGINX}" "${WATCHDOG_RESTARTS_NGINX}" "Nginx" || true
    watchdog_reset_count "${WATCHDOG_UNHEALTHY_NGINX}"
  fi
}

watchdog_socks_probe() {
  local raw="$1" proxy_url
  parse_socks5 "${raw}"
  [[ -n "${SOCKS_HOST}" && "${SOCKS_PORT}" =~ ^[0-9]+$ ]] || return 1
  if [[ -n "${SOCKS_USER}" ]]; then
    proxy_url="socks5h://${SOCKS_USER}:${SOCKS_PASS}@${SOCKS_HOST}:${SOCKS_PORT}"
  else
    proxy_url="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
  fi
  curl -fL --max-time 12 -x "${proxy_url}" -o /dev/null -sS "https://www.google.com" >/dev/null 2>&1
}

watchdog_check_outbound() {
  local url orig
  [[ -f "${XCC_OUTBOUND}" ]] || return 0
  url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
  orig=""
  [[ -f "${WATCHDOG_OUTBOUND_ORIG}" ]] && orig=$(tr -d '\r' < "${WATCHDOG_OUTBOUND_ORIG}" | head -n1)

  if [[ -n "${orig}" && ( -z "${url}" || "${url}" == DIRECT || "${url}" == direct ) ]]; then
    if watchdog_socks_probe "${orig}"; then
      local ok
      ok=$(watchdog_inc_count "${WATCHDOG_SOCKS_RECOVER}")
      if [[ "${ok}" -ge 2 ]]; then
        xcc_log INFO "SOCKS5 已恢复，切回 ${orig}"
        printf '%s\n' "${orig}" > "${XCC_OUTBOUND}"
        chmod 600 "${XCC_OUTBOUND}"
        rm -f "${WATCHDOG_OUTBOUND_ORIG}" "${WATCHDOG_SOCKS_FAILS}" "${WATCHDOG_SOCKS_RECOVER}"
        watchdog_apply_safe || true
        broadcast "xcc: SOCKS5 出站已恢复"
      fi
    else
      watchdog_reset_count "${WATCHDOG_SOCKS_RECOVER}"
    fi
    return 0
  fi

  [[ -n "${url}" && "${url}" != DIRECT && "${url}" != direct ]] || return 0
  if watchdog_socks_probe "${url}"; then
    watchdog_reset_count "${WATCHDOG_SOCKS_FAILS}"
    return 0
  fi
  xcc_log ERROR "SOCKS5 连通失败，连续计数中"
  local n
  n=$(watchdog_inc_count "${WATCHDOG_SOCKS_FAILS}")
  if [[ "${n}" -ge 3 ]]; then
    xcc_log ERROR "SOCKS5 连续失败 ${n} 次，切换为 DIRECT，避免节点走死出站"
    printf '%s\n' "${url}" > "${WATCHDOG_OUTBOUND_ORIG}"
    chmod 600 "${WATCHDOG_OUTBOUND_ORIG}"
    printf 'DIRECT\n' > "${XCC_OUTBOUND}"
    chmod 600 "${XCC_OUTBOUND}"
    watchdog_reset_count "${WATCHDOG_SOCKS_FAILS}"
    watchdog_apply_safe || true
    broadcast "xcc 告警: SOCKS5 不可用，已临时切直连。恢复后会自动切回。"
  fi
}

watchdog_ntp() {
  command -v timedatectl >/dev/null 2>&1 || return 0
  timedatectl set-ntp true >/dev/null 2>&1 || true
  local status
  status=$(timedatectl status 2>/dev/null || true)
  if printf '%s' "${status}" | grep -Eqi 'NTP synchronized: yes|System clock synchronized: yes'; then
    return 0
  fi
  xcc_log WARN "系统时间未同步，正在强制对时（Reality maxTimeDiff=70s）"
  if command -v chronyc >/dev/null 2>&1; then
    chronyc -a makestep >/dev/null 2>&1 || true
  elif command -v ntpdate >/dev/null 2>&1; then
    ntpdate -u pool.ntp.org >/dev/null 2>&1 || ntpdate -u time.cloudflare.com >/dev/null 2>&1 || true
  fi
  status=$(timedatectl status 2>/dev/null || true)
  if ! printf '%s' "${status}" | grep -Eqi 'NTP synchronized: yes|System clock synchronized: yes'; then
    xcc_log ERROR "NTP 仍未同步，Reality 可能因时间偏差失败"
    broadcast "xcc 告警: 系统时间未同步，Reality 可能不可用"
  fi
}

watchdog_renew_certs() {
  local cert domain days acme
  [[ -f "${XCC_NODES}" ]] || return 0
  cert=$(jq -r '.settings.cert // empty' "${XCC_NODES}" 2>/dev/null)
  domain=$(jq -r '.settings.domain // empty' "${XCC_NODES}" 2>/dev/null)
  [[ -n "${cert}" && -f "${cert}" ]] || return 0
  days=$(cert_days_left "${cert}")
  if [[ ! "${days}" =~ ^-?[0-9]+$ ]]; then
    return 0
  fi
  if [[ "${days}" -lt 0 ]]; then
    xcc_log ERROR "证书已过期: ${cert}"
    broadcast "xcc 告警: TLS 证书已过期"
  elif [[ "${days}" -le 21 ]]; then
    xcc_log WARN "证书剩余 ${days} 天，尝试续签"
  else
    return 0
  fi
  acme="${HOME}/.acme.sh/acme.sh"
  if [[ ! -x "${acme}" ]]; then
    xcc_log WARN "未安装 acme.sh，跳过自动续签（自签名请忽略）"
    return 0
  fi
  if watchdog_tui_busy; then
    return 0
  fi
  TUI_BACKEND=none
  "${acme}" --cron --home "${HOME}/.acme.sh" >/dev/null 2>&1 || true
  if [[ -n "${domain}" ]]; then
    "${acme}" --renew -d "${domain}" >/dev/null 2>&1 || true
    "${acme}" --install-cert -d "${domain}" \
      --key-file "${XCC_CERT_DIR}/privkey.pem" \
      --fullchain-file "${XCC_CERT_DIR}/fullchain.pem" \
      --reloadcmd "systemctl reload nginx; systemctl reload xray || systemctl restart xray; systemctl restart sing-box" \
      >/dev/null 2>&1 || true
  fi
}

watchdog_weekly_due() {
  local now last
  now=$(date +%s)
  if [[ ! -f "${WATCHDOG_WEEKLY_STAMP}" ]]; then
    printf '%s\n' "${now}" > "${WATCHDOG_WEEKLY_STAMP}"
    return 1
  fi
  last=$(tr -d ' \n' < "${WATCHDOG_WEEKLY_STAMP}")
  [[ "${last}" =~ ^[0-9]+$ ]] || last=0
  [[ $((now - last)) -ge "${WATCHDOG_WEEKLY_SECS}" ]]
}

watchdog_update_xcc() {
  local tmp remote
  tmp=$(xcc_mktemp)
  if ! download_github_file "${tmp}" "xcc"; then
    xcc_log WARN "每周更新：下载 xcc 失败"
    rm -f "${tmp}"
    return 1
  fi
  remote=$(grep -m1 '^XCC_VERSION=' "${tmp}" | cut -d= -f2 | tr -d '"' || true)
  if [[ -z "${remote}" ]] || ! version_newer "${remote}" "${XCC_VERSION}"; then
    rm -f "${tmp}"
    return 0
  fi
  chmod 755 "${tmp}"
  mv "${tmp}" "${XCC_BIN}"
  chmod 755 "${XCC_BIN}"
  xcc_log INFO "xcc 已自动更新到 ${remote}，即将重启看门狗"
  systemctl restart xcc-watchdog >/dev/null 2>&1 || true
}

watchdog_weekly() {
  watchdog_weekly_due || return 0
  if watchdog_tui_busy; then
    xcc_log INFO "每周维护到期，但 TUI 正在运行，下一分钟再试"
    return 0
  fi
  xcc_log INFO "开始每周维护：证书 / geoip / Xray / sing-box / xcc"
  TUI_BACKEND=none
  watchdog_renew_certs || true
  install_geodata || true
  install_xray auto || true
  if [[ -x "${SINGBOX_BIN}" ]] || hy2_nodes_enabled; then
    install_singbox auto || true
  fi
  watchdog_apply_safe || true
  date +%s > "${WATCHDOG_WEEKLY_STAMP}"
  watchdog_update_xcc || true
}

watchdog_units() {
  systemctl enable xcc-watchdog >/dev/null 2>&1 || true
  if xray_nodes_enabled; then
    systemctl enable xray >/dev/null 2>&1 || true
  fi
  if hy2_nodes_enabled; then
    systemctl enable sing-box >/dev/null 2>&1 || true
  fi
}

cmd_watchdog() {
  need_root
  init_tmp
  TUI_BACKEND=none
  xcc_log INFO "看门狗启动（健康检查 / 熔断 / 出站切换 / 每周更新）"
  while true; do
    watchdog_cleanup_old_logs
    watchdog_disk
    watchdog_load
    watchdog_ntp
    watchdog_units
    watchdog_renew_certs
    watchdog_check_xray
    watchdog_check_singbox
    watchdog_check_nginx
    watchdog_check_outbound
    watchdog_weekly
    sleep 60
  done
}

