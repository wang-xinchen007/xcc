# 与 v2ray-agent 相同：hysteria2://...?peer=&insecure=&sni=&alpn=h3
hysteria_share_link() {
  local json="$1"
  local ip port password obfs insecure sni remark host peer
  ip=$(public_ip)
  port=$(printf '%s' "${json}" | jq -r '.port')
  password=$(printf '%s' "${json}" | jq -r '.password')
  obfs=$(printf '%s' "${json}" | jq -r '.obfs // empty')
  insecure=$(printf '%s' "${json}" | jq -r '.insecure // true')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .domain // empty')
  remark=$(node_email "${json}")
  host="${ip}"
  if [[ "${insecure}" != "true" && -n "${sni}" && "${sni}" != "localhost" ]]; then
    host="${sni}"
  fi
  peer="${sni:-${host}}"
  local url
  url="hysteria2://${password}@${host}:${port}?peer=${peer}&"
  if [[ "${insecure}" == "true" ]]; then
    url+="insecure=1"
  else
    url+="insecure=0"
  fi
  url+="&sni=${peer}&alpn=h3"
  if [[ -n "${obfs}" ]]; then
    url+="&obfs=salamander&obfs-password=${obfs}"
  fi
  url+="#${remark}"
  printf '%s\n' "${url}"
}

