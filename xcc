show_startup_warnings() {
  if [[ "${#WARNINGS[@]}" -eq 0 ]]; then
    return
  fi
  local msg="" w
  for w in "${WARNINGS[@]}"; do
    msg+="• ${w}"$'\n'
  done
  tui_msg "环境检测提示" "${msg}"
}

main_menu() {
  local choice extra
  extra=""
  if [[ -f "${WATCHDOG_HALT}" ]]; then
    extra=$'\n'"⚠ 看门狗保护已触发，Xray 不会自动重启。可选择重置。"
  fi
  while true; do
    choice=$(tui_menu "xcc 主菜单" "v2.0 多协议管理（参考 v2ray-agent / 3x-ui，仍为单机单用户）${extra}" \
      "d" "状态面板 / 流量" \
      "q" "一键 Reality（无域名）" \
      "1" "配置 Reality 节点" \
      "2" "配置 Hysteria2 节点" \
      "v" "配置 VLESS-WS-TLS" \
      "m" "配置 VMess-WS-TLS" \
      "t" "配置 Trojan-TLS" \
      "s" "配置 Shadowsocks 2022" \
      "3" "管理节点" \
      "u" "订阅 / 分享链接" \
      "5" "出站 / WARP / 分流" \
      "c" "证书（ACME）" \
      "b" "启用 BBR 加速" \
      "6" "设置 SSH 端口" \
      "k" "更新核心（Xray/Hysteria/xcc）" \
      "7" "备份配置" \
      "8" "恢复配置" \
      "9" "卸载 xcc" \
      "r" "重置看门狗保护" \
      "0" "退出") || exit 0
    case "${choice}" in
      d) menu_dashboard ;;
      q) menu_quick_reality ;;
      1) menu_config_reality ;;
      2) menu_config_hysteria ;;
      v) menu_config_vless_ws ;;
      m) menu_config_vmess ;;
      t) menu_config_trojan ;;
      s) menu_config_ss ;;
      3) menu_manage_hub ;;
      u) menu_subscribe ;;
      5) menu_outbound_hub ;;
      c) menu_certs ;;
      b) menu_bbr ;;
      6) menu_ssh_port ;;
      k) menu_core_update ;;
      7) menu_backup ;;
      8) menu_restore ;;
      9) menu_uninstall ;;
      r)
        rm -f "${WATCHDOG_HALT}" "${WATCHDOG_RESTARTS}"
        extra=""
        tui_msg "完成" "已重置看门狗保护。"
        ;;
      0) exit 0 ;;
    esac
  done
}

cmd_run() {
  need_root
  trap on_run_exit EXIT
  trap 'exit 130' INT TERM
  ensure_environment
  check_remote_xcc_version
  show_startup_warnings
  if [[ -f "${WATCHDOG_HALT}" ]]; then
    tui_msg "看门狗保护" "检测到 5 分钟内重启超过 3 次，自动重启已停止。主菜单可选择重置。"
  fi
  main_menu
}

cmd_version() {
  printf 'xcc %s (config format %s)\n' "${XCC_VERSION}" "${XCC_CONFIG_FORMAT}"
}

usage() {
  cat <<EOF
xcc ${XCC_VERSION} - Xray / Hysteria 节点管理工具（仅支持单用户配置）

Usage:
  xcc              显示本帮助
  xcc run          启动中文 TUI 管理界面
  xcc status       显示状态面板
  xcc update       从 GitHub 下载最新脚本覆盖 ${XCC_BIN}（保留 ${XCC_DIR}/）
  xcc uninstall    卸载 xcc（需输入 yes 确认）
  xcc version      显示版本
  xcc watchdog     看门狗（由 systemd 调用，请勿手动前台运行）

安装（国内建议用 jsDelivr，避免 raw.githubusercontent.com DNS 污染）:
  bash <(curl -fsSL https://cdn.jsdelivr.net/gh/${XCC_GITHUB_SLUG}@${XCC_GITHUB_BRANCH}/install.sh)

EOF
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    ""|-h|--help|help) usage ;;
    run) cmd_run ;;
    status) need_root; init_tmp; detect_os; ensure_dirs; TUI_BACKEND=cli; menu_dashboard ;;
    update) cmd_update ;;
    uninstall) cmd_uninstall ;;
    version|--version) cmd_version ;;
    watchdog) cmd_watchdog ;;
    *)
      err "未知命令: ${cmd}"
      usage
      exit 1
      ;;
  esac
}

main "$@"
