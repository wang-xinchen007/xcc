# 兼容 1.x nodes.json，补齐 2.0 字段，并把 Reality shortId 与 v2ray-agent 对齐。
migrate_nodes_json() {
  [[ -f "${XCC_NODES}" ]] || return 0
  jq_apply "${XCC_NODES}" --argjson st "${XCC_SETTINGS_DEFAULT}" --arg sid "${REALITY_DEFAULT_SID}" --arg sni "${REALITY_DEFAULT_SNI}" '
      .reality //= []
      | .hysteria //= []
      | .vless_ws //= []
      | .vless //= []
      | .vmess //= []
      | .trojan //= []
      | .shadowsocks //= []
      | .wireguard //= []
      | .http //= []
      | .socks //= []
      | .tunnel //= []
      | .tun //= []
      | .settings = ($st + (.settings // {}))
      | .settings.ipv6_domains //= []
      | .reality = [
          .reality
          | to_entries[]
          | .key as $i
          | .value
          | .sni = (.sni // $sni)
          | .dest = (
              if (.dest // "") != "" then .dest
              elif (.target // "") != "" then .target
              else (.sni + ":443") end
            )
          | .short_id = (if (.short_id // "") == "" then $sid else .short_id end)
          | .email = (.email // .tag // "xcc")
          | .flow = (.flow // "xtls-rprx-vision")
          | .fingerprint = (.fingerprint // "chrome")
          | .xray_port = (.xray_port // (45987 - $i))
        ]
      | .hysteria = [
          .hysteria[]
          | .email = (.email // .tag // "xcc")
          | .up_mbps = (.up_mbps // $st.hy_up_mbps // 100)
          | .down_mbps = (.down_mbps // $st.hy_down_mbps // 50)
        ]
      | .vless_ws = [ .vless_ws[] | .email = (.email // .tag // "xcc") | .host = (.host // .sni // "") | .xray_port = (.xray_port // 31297) ]
      | .vless = [ .vless[] | .email = (.email // .tag // "xcc") | .network = (.network // "tcp") | .security = (.security // "tls") | .host = (.host // .sni // "") ]
      | .vmess = [ .vmess[] | .email = (.email // .tag // "xcc") | .network = (.network // "ws") | .security = (.security // "tls") | .xray_port = (.xray_port // 31299) ]
      | .trojan = [ .trojan[] | .email = (.email // .tag // "xcc") | .network = (.network // "tcp") | .security = (.security // "tls") ]
      | .wireguard = [ .wireguard[] | .email = (.email // .tag // "xcc") ]
      | .http = [ .http[] | .email = (.email // .tag // "xcc") ]
      | .socks = [ .socks[] | .email = (.email // .tag // "xcc") ]
      | .tunnel = [ .tunnel[] | .email = (.email // .tag // "xcc") ]
      | .tun = [
          .tun[]
          | .email = (.email // .tag // "xcc")
          | .name = (.name // "xcc0")
          | .mtu = (.mtu // 1500)
          | .auto_route = (.auto_route // "off")
          | .auto_iface = (.auto_iface // "auto")
          | .private_direct = (.private_direct // true)
        ]
    ' 2>/dev/null || true
}

