github_release_urls() {
  local rel="$1"
  printf '%s\n' \
    "https://github.com/${rel}" \
    "https://ghproxy.net/https://github.com/${rel}" \
    "https://mirror.ghproxy.com/https://github.com/${rel}"
}

install_singbox() {
  local mode="${1:-ask}"
  local latest installed arch ver url tmp dir
  latest=$(github_latest_tag "${SINGBOX_RELEASE_API}" || true)
  installed=$(singbox_installed_version || true)
  arch=$(singbox_arch_tuple)

  if [[ -x "${SINGBOX_BIN}" ]]; then
    info "已安装 sing-box ${installed:-unknown}，最新版本 ${latest:-unknown}"
    if [[ -n "${latest}" ]] && version_newer "${latest}" "${installed}"; then
      if [[ "${mode}" == "auto" ]]; then
        xcc_log INFO "自动升级 sing-box ${installed} -> ${latest}"
      elif ! tui_yesno "sing-box 升级" "检测到新版本 ${latest}（当前 ${installed}）。是否升级？"; then
        return 0
      fi
    else
      return 0
    fi
  fi

  ver="${latest#v}"
  [[ -n "${ver}" ]] || ver="1.12.12"
  latest="${latest:-v${ver}}"
  info "正在从 GitHub Release 安装 sing-box ${latest} ..."
  tmp=$(xcc_mktemp)
  url=""
  while IFS= read -r url; do
    [[ -n "${url}" ]] || continue
    info "尝试下载: ${url}"
    if curl -fL -A "xcc/${XCC_VERSION}" --connect-timeout 15 --max-time 180 -o "${tmp}" "${url}"; then
      break
    fi
    rm -f "${tmp}"
    tmp=$(xcc_mktemp)
    url=""
  done < <(github_release_urls "SagerNet/sing-box/releases/download/${latest}/sing-box-${ver}-${arch}.tar.gz")
  if [[ ! -s "${tmp}" ]]; then
    err "下载 sing-box 失败"
    return 1
  fi
  dir=$(mktemp -d "${XCC_TMP_DIR}/singbox-XXXXXX")
  if ! tar -xzf "${tmp}" -C "${dir}"; then
    rm -rf "${dir}" "${tmp}"
    err "解压 sing-box 失败"
    return 1
  fi
  local bin
  bin=$(find "${dir}" -type f -name sing-box | head -n1)
  if [[ -z "${bin}" ]]; then
    rm -rf "${dir}" "${tmp}"
    err "压缩包中未找到 sing-box 二进制"
    return 1
  fi
  chmod 755 "${bin}"
  mv "${bin}" "${SINGBOX_BIN}"
  chmod 755 "${SINGBOX_BIN}"
  rm -rf "${dir}" "${tmp}"
  mkdir -p "${SINGBOX_FRAG_DIR}"
  chmod 700 "${SINGBOX_DIR}"
  info "sing-box 安装完成: $(singbox_installed_version || echo unknown)"
}

