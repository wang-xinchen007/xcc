rand_hex() {
  openssl rand -hex "${1:-4}"
}

rand_alnum() {
  local n="${1:-16}"
  tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${n}"
}

# 调用 xray x25519，按规范提取 PrivateKey / PublicKey（忽略空行）。
xray_x25519() {
  local out priv pub
  out=$("${XRAY_BIN}" x25519 2>/dev/null)
  priv=$(printf '%s\n' "${out}" | sed -n 's/^PrivateKey: //p' | sed '/^$/d' | head -n1)
  pub=$(printf '%s\n' "${out}" | sed -n 's/^PublicKey: //p' | sed '/^$/d' | head -n1)
  if [[ -z "${pub}" ]]; then
    pub=$(printf '%s\n' "${out}" | sed -n 's/^Password (PublicKey): //p' | sed '/^$/d' | head -n1)
  fi
  if [[ -z "${pub}" ]]; then
    pub=$(printf '%s\n' "${out}" | sed -n 's/^Password: //p' | sed '/^$/d' | head -n1)
  fi
  if [[ -z "${priv}" || -z "${pub}" ]]; then
    return 1
  fi
  REALITY_PRIV="${priv}"
  REALITY_PUB="${pub}"
}

xray_uuid() {
  "${XRAY_BIN}" uuid
}

reality_share_link() {
  local json="$1"
  local ip uuid port sni pbk sid flow fp remark
  ip=$(public_ip)
  uuid=$(printf '%s' "${json}" | jq -r '.uuid')
  port=$(printf '%s' "${json}" | jq -r '.port')
  sni=$(printf '%s' "${json}" | jq -r '.sni')
  pbk=$(printf '%s' "${json}" | jq -r '.public_key')
  sid=$(printf '%s' "${json}" | jq -r '.short_id')
  flow=$(printf '%s' "${json}" | jq -r '.flow // "xtls-rprx-vision"')
  fp=$(printf '%s' "${json}" | jq -r '.fingerprint // "chrome"')
  remark="xcc-reality-${port}"
  printf 'vless://%s@%s:%s?encryption=none&flow=%s&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s#%s\n' \
    "${uuid}" "${ip}" "${port}" "${flow}" "${sni}" "${fp}" "${pbk}" "${sid}" "${remark}"
}

hysteria_share_link() {
  local json="$1"
  local ip port password obfs insecure sni remark url
  ip=$(public_ip)
  port=$(printf '%s' "${json}" | jq -r '.port')
  password=$(printf '%s' "${json}" | jq -r '.password')
  obfs=$(printf '%s' "${json}" | jq -r '.obfs // empty')
  insecure=$(printf '%s' "${json}" | jq -r '.insecure // true')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .domain // empty')
  remark="xcc-hysteria-${port}"
  url="hy2://${password}@${ip}:${port}?"
  if [[ "${insecure}" == "true" ]]; then
    url+="insecure=1"
  else
    url+="insecure=0"
  fi
  [[ -n "${sni}" ]] && url+="&sni=${sni}"
  if [[ -n "${obfs}" ]]; then
    url+="&obfs=salamander&obfs-password=${obfs}"
  fi
  url+="#${remark}"
  printf '%s\n' "${url}"
}

show_share_and_qr() {
  local title="$1"
  local link="$2"
  local tmp
  tmp=$(xcc_mktemp)
  {
    echo "${title}"
    echo
    echo "${link}"
    echo
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -t ansiutf8 "${link}" 2>/dev/null || echo "(二维码生成失败)"
    else
      echo "未安装 qrencode，无法显示二维码。"
    fi
  } > "${tmp}"
  if [[ "${TUI_BACKEND}" == "cli" || "${TUI_BACKEND}" == "whiptail" || "${TUI_BACKEND}" == "dialog" ]]; then
    clear
    cat "${tmp}"
    echo
    read -r -p "按回车返回菜单..." _ || true
  fi
  rm -f "${tmp}"
}

urlencode() {
  jq -nr --arg v "$1" '$v|@uri'
}

vless_ws_share_link() {
  local json="$1" ip uuid port sni host path
  ip=$(public_ip)
  uuid=$(printf '%s' "${json}" | jq -r '.uuid')
  port=$(printf '%s' "${json}" | jq -r '.port')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .host // empty')
  host=$(printf '%s' "${json}" | jq -r '.host // .sni // empty')
  path=$(printf '%s' "${json}" | jq -r '.path // "/xcc"')
  printf 'vless://%s@%s:%s?encryption=none&security=tls&sni=%s&fp=chrome&type=ws&host=%s&path=%s#xcc-vlessws-%s\n' \
    "${uuid}" "${ip}" "${port}" "$(urlencode "${sni}")" "$(urlencode "${host}")" "$(urlencode "${path}")" "${port}"
}

vmess_share_link() {
  local json="$1" ip payload
  ip=$(public_ip)
  payload=$(printf '%s' "${json}" | jq -c --arg ip "${ip}" '{
      v:"2", ps:("xcc-vmess-" + (.port|tostring)), add:$ip, port:(.port|tostring),
      id:.uuid, aid:"0", scy:"auto", net:(.network // "ws"), type:"none",
      host:(.host // .sni // ""), path:(.path // "/xcc"), tls:"tls",
      sni:(.sni // .host // ""), fp:"chrome"
    }')
  printf 'vmess://%s\n' "$(printf '%s' "${payload}" | base64 -w0 2>/dev/null || printf '%s' "${payload}" | base64)"
}

trojan_share_link() {
  local json="$1" ip port sni pass
  ip=$(public_ip)
  port=$(printf '%s' "${json}" | jq -r '.port')
  sni=$(printf '%s' "${json}" | jq -r '.sni // empty')
  pass=$(printf '%s' "${json}" | jq -r '.password')
  printf 'trojan://%s@%s:%s?security=tls&sni=%s&fp=chrome&type=tcp#xcc-trojan-%s\n' \
    "$(urlencode "${pass}")" "${ip}" "${port}" "$(urlencode "${sni}")" "${port}"
}

ss_share_link() {
  local json="$1" ip port method pass userinfo
  ip=$(public_ip)
  port=$(printf '%s' "${json}" | jq -r '.port')
  method=$(printf '%s' "${json}" | jq -r '.method // "2022-blake3-aes-128-gcm"')
  pass=$(printf '%s' "${json}" | jq -r '.password')
  userinfo=$(printf '%s:%s' "${method}" "${pass}" | base64 -w0 2>/dev/null || printf '%s:%s' "${method}" "${pass}" | base64)
  printf 'ss://%s@%s:%s#xcc-ss-%s\n' "${userinfo}" "${ip}" "${port}" "${port}"
}

node_share_link() {
  local kind="$1" json="$2"
  case "${kind}" in
    reality) reality_share_link "${json}" ;;
    hysteria) hysteria_share_link "${json}" ;;
    vless_ws) vless_ws_share_link "${json}" ;;
    vmess) vmess_share_link "${json}" ;;
    trojan) trojan_share_link "${json}" ;;
    shadowsocks) ss_share_link "${json}" ;;
  esac
}

collect_all_links() {
  local kind json
  migrate_nodes_json
  for kind in reality vless_ws vmess trojan shadowsocks hysteria; do
    while IFS= read -r json; do
      [[ -n "${json}" ]] || continue
      node_share_link "${kind}" "${json}"
    done < <(jq -c --arg k "${kind}" '.[$k][]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)
  done
}

ensure_sub_token() {
  local tok
  tok=$(jq -r '.settings.sub_token // empty' "${XCC_NODES}")
  if [[ -z "${tok}" ]]; then
    tok=$(rand_alnum 24)
    set_settings_field sub_token "${tok}"
  fi
  printf '%s' "${tok}"
}

set_settings_field() {
  local key="$1" val="$2" is_json="${3:-0}" tmp
  tmp=$(xcc_mktemp)
  if [[ "${is_json}" -eq 1 ]]; then
    jq --arg k "${key}" --argjson v "${val}" '.settings[$k]=$v' "${XCC_NODES}" > "${tmp}"
  else
    jq --arg k "${key}" --arg v "${val}" '.settings[$k]=$v' "${XCC_NODES}" > "${tmp}"
  fi
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"
}

rebuild_subscribe() {
  local tok port ip raw
  migrate_nodes_json
  mkdir -p "${XCC_SUB_DIR}"
  chmod 755 "${XCC_SUB_DIR}"
  tok=$(ensure_sub_token)
  port=$(jq -r '.settings.sub_port // 2096' "${XCC_NODES}")
  ip=$(public_ip)
  raw="${XCC_SUB_DIR}/raw.txt"
  collect_all_links > "${raw}"
  (base64 -w0 "${raw}" 2>/dev/null || base64 "${raw}") > "${XCC_SUB_DIR}/${tok}"
  chmod 644 "${XCC_SUB_DIR}/${tok}" "${raw}"
  local py
  py=$(command -v python3 || echo /usr/bin/python3)
  cat > /etc/systemd/system/xcc-sub.service <<EOF
[Unit]
Description=xcc subscription HTTP
After=network.target

[Service]
Type=simple
WorkingDirectory=${XCC_SUB_DIR}
ExecStart=${py} -m http.server ${port} --bind 0.0.0.0
Restart=always
RestartSec=3
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  fw_allow_tcp "${port}"
  systemctl enable --now xcc-sub >/dev/null 2>&1 || systemctl restart xcc-sub
  printf 'http://%s:%s/%s\n' "${ip}" "${port}" "${tok}"
}

bytes_human() {
  local n="${1:-0}"
  awk -v n="${n}" 'BEGIN{
    split("B KB MB GB TB", u, " ");
    i=1; while (n>=1024 && i<5) {n/=1024; i++}
    printf "%.2f %s", n, u[i]
  }'
}

#===============================================================================
# 状态面板（参考 3x-ui dashboard）
#===============================================================================
menu_dashboard() {
  local tmp cpu mem disk up load1 cores xst hst wst ver_x ver_h ip
  tmp=$(xcc_mktemp)
  cpu=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || nproc)
  mem=$(free -h | awk '/Mem:/{print $3" / "$2}')
  disk=$(df -h / | awk 'NR==2{print $3" / "$2" ("$5")"}')
  up=$(uptime -p 2>/dev/null || uptime)
  load1=$(awk '{print $1}' /proc/loadavg)
  cores=$(nproc)
  xst=$(systemctl is-active xray 2>/dev/null || echo unknown)
  wst=$(systemctl is-active xcc-watchdog 2>/dev/null || echo unknown)
  hst=$(systemctl is-active 'hysteria@*' 2>/dev/null | head -n1 || echo inactive)
  ver_x=$(xray_installed_version || echo -)
  ver_h=$(hysteria_installed_version || echo -)
  ip=$(public_ip)
  {
    echo "===== xcc ${XCC_VERSION} 状态面板 ====="
    echo "主机: $(hostname)    系统: ${OS_ID:-?} ${OS_VERSION_ID:-?}"
    echo "公网 IP: ${ip}"
    echo "CPU: ${cpu} 核    负载: ${load1} (阈值 $((cores * 2)))"
    echo "内存: ${mem}"
    echo "磁盘: ${disk}"
    echo "运行时间: ${up}"
    echo
    echo "Xray: ${xst}  ${ver_x}"
    echo "Hysteria: ${hst}  ${ver_h}"
    echo "看门狗: ${wst}"
    echo
    echo "----- 节点 -----"
    jq -r '
      def line($k):
        (.[$k][]? | "  \($k)\t\(.tag)\tport=\(.port)\t\(if .enabled then "启用" else "禁用" end)\tout=\(.outbound // "proxy")");
      line("reality"), line("vless_ws"), line("vmess"), line("trojan"), line("shadowsocks"), line("hysteria")
    ' "${XCC_NODES}" 2>/dev/null || true
    echo
    echo "----- 流量 (Xray Stats API) -----"
    if command -v "${XRAY_BIN}" >/dev/null && is_svc_active xray; then
      "${XRAY_BIN}" api statsquery --server="${XRAY_API_ADDR}" 2>/dev/null \
        | jq -r '.stat[]? | select(.name|test("traffic")) | "\(.name)\t\(.value)"' 2>/dev/null \
        | while IFS=$'\t' read -r name val; do
            printf '  %s  %s\n' "${name}" "$(bytes_human "${val}")"
          done
      echo "(无输出表示尚未产生流量或 API 未就绪)"
    else
      echo "  Xray 未运行，无法读取流量。"
    fi
  } > "${tmp}"
  tui_textbox_file "状态面板" "${tmp}"
  rm -f "${tmp}"
}

#===============================================================================
# 证书 ACME / 自签名（参考 v2ray-agent 自动 TLS）
#===============================================================================
make_self_signed() {
  local cn="${1:-localhost}"
  mkdir -p "${XCC_CERT_DIR}"
  openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
    -keyout "${XCC_CERT_DIR}/privkey.pem" -out "${XCC_CERT_DIR}/fullchain.pem" \
    -subj "/CN=${cn}" >/dev/null 2>&1
  chmod 600 "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field cert "${XCC_CERT_DIR}/fullchain.pem"
  set_settings_field key "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field domain "${cn}"
}

install_acme_sh() {
  if [[ -x "${HOME}/.acme.sh/acme.sh" ]]; then
    return 0
  fi
  info "正在安装 acme.sh ..."
  curl -fsSL https://get.acme.sh | sh -s -- --install-online >/dev/null 2>&1 \
    || curl -fsSL https://cdn.jsdelivr.net/gh/acmesh-official/acme.sh@master/acme.sh | sh -s -- --install-online
}

issue_acme_cert() {
  local domain="$1" email="${2:-admin@${1}}"
  [[ -n "${domain}" ]] || return 1
  fw_allow_tcp 80
  install_acme_sh || return 1
  "${HOME}/.acme.sh/acme.sh" --set-default-ca --server letsencrypt >/dev/null 2>&1 || true
  "${HOME}/.acme.sh/acme.sh" --register-account -m "${email}" >/dev/null 2>&1 || true
  if ! "${HOME}/.acme.sh/acme.sh" --issue -d "${domain}" --standalone --httpport 80 --force; then
    tui_msg "错误" "ACME 签发失败。请确认域名已解析到本机，且 80 端口未被占用。"
    return 1
  fi
