collect_all_links() {
  local kind json
  migrate_nodes_json
  for kind in reality vless_ws vless vmess trojan shadowsocks hysteria wireguard http socks tunnel tun; do
    while IFS= read -r json; do
      [[ -n "${json}" ]] || continue
      node_share_link "${kind}" "${json}"
    done < <(jq -c --arg k "${kind}" '.[$k][]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)
  done
}

ensure_sub_token() {
  local tok
  tok=$(jq -r '.settings.sub_token // empty' "${XCC_NODES}")
  if [[ -z "${tok}" ]]; then
    tok=$(rand_alnum 24)
    set_settings_field sub_token "${tok}"
  fi
  printf '%s' "${tok}"
}

set_settings_field() {
  local key="$1" val="$2" is_json="${3:-0}"
  if [[ "${is_json}" -eq 1 ]]; then
    jq_apply "${XCC_NODES}" --arg k "${key}" --argjson v "${val}" '.settings[$k]=$v'
  else
    jq_apply "${XCC_NODES}" --arg k "${key}" --arg v "${val}" '.settings[$k]=$v'
  fi
}

yaml_quote() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "${s}"
}

# 按 v2ray-agent clashMeta 字段生成 Clash Meta 代理条目。
write_clash_proxies() {
  local file="$1"
  local names_file="$2"
  local json ip email host port insecure up down obfs
  : > "${file}"
  : > "${names_file}"
  ip=$(public_ip)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: vless"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    uuid: $(printf '%s' "${json}" | jq -r '.uuid')"
      echo "    network: tcp"
      echo "    tls: true"
      echo "    udp: true"
      echo "    flow: xtls-rprx-vision"
      echo "    servername: $(printf '%s' "${json}" | jq -r '.sni')"
      echo "    reality-opts:"
      echo "      public-key: $(printf '%s' "${json}" | jq -r '.public_key')"
      echo "      short-id: $(printf '%s' "${json}" | jq -r --arg d "${REALITY_DEFAULT_SID}" '.short_id // $d')"
      echo "    client-fingerprint: chrome"
    } >> "${file}"
  done < <(jq -c '.reality[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    if nginx_front_enabled; then
      port=$(nginx_public_port)
      host=$(tls_public_host)
    else
      port=$(printf '%s' "${json}" | jq -r '.port')
      host=$(printf '%s' "${json}" | jq -r '.host // .sni // empty')
    fi
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: vless"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    uuid: $(printf '%s' "${json}" | jq -r '.uuid')"
      echo "    udp: true"
      echo "    tls: true"
      echo "    network: ws"
      echo "    client-fingerprint: chrome"
      echo "    servername: ${host}"
      echo "    ws-opts:"
      echo "      path: $(printf '%s' "${json}" | jq -r '.path // "/xcc"')"
      echo "      headers:"
      echo "        Host: ${host}"
    } >> "${file}"
  done < <(jq -c '.vless_ws[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    if nginx_front_enabled; then
      port=$(nginx_public_port)
      host=$(tls_public_host)
    else
      port=$(printf '%s' "${json}" | jq -r '.port')
      host=$(printf '%s' "${json}" | jq -r '.host // .sni // empty')
    fi
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: vmess"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    uuid: $(printf '%s' "${json}" | jq -r '.uuid')"
      echo "    alterId: 0"
      echo "    cipher: none"
      echo "    udp: true"
      echo "    tls: true"
      echo "    client-fingerprint: chrome"
      echo "    servername: ${host}"
      echo "    network: ws"
      echo "    ws-opts:"
      echo "      path: $(printf '%s' "${json}" | jq -r '.path // "/xcc"')"
      echo "      headers:"
      echo "        Host: ${host}"
    } >> "${file}"
  done < <(jq -c '.vmess[]? | select(.enabled==true and ((.network // "ws") == "ws" or (.network // "") == "httpupgrade"))' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    net=$(printf '%s' "${json}" | jq -r '.network // "tcp"')
    sec=$(printf '%s' "${json}" | jq -r '.security // "tls"')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: vmess"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    uuid: $(printf '%s' "${json}" | jq -r '.uuid')"
      echo "    alterId: 0"
      echo "    cipher: auto"
      echo "    udp: true"
      echo "    network: ${net}"
      if [[ "${sec}" == "tls" ]]; then
        echo "    tls: true"
        echo "    servername: $(printf '%s' "${json}" | jq -r '.sni // .host // empty')"
        echo "    client-fingerprint: chrome"
      fi
      if [[ "${net}" == "grpc" ]]; then
        echo "    grpc-opts:"
        echo "      grpc-service-name: $(printf '%s' "${json}" | jq -r '.service_name // .path // "grpc"')"
      fi
    } >> "${file}"
  done < <(jq -c '.vmess[]? | select(.enabled==true and ((.network // "ws") != "ws") and ((.network // "") != "httpupgrade"))' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    host=$(printf '%s' "${json}" | jq -r '.sni // empty')
    [[ -n "${host}" ]] || host="${ip}"
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: trojan"
      echo "    server: ${host}"
      echo "    port: ${port}"
      echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      echo "    udp: true"
      echo "    sni: ${host}"
      echo "    alpn:"
      echo "      - http/1.1"
      echo "    client-fingerprint: chrome"
    } >> "${file}"
  done < <(jq -c '.trojan[]? | select(.enabled==true and (.network // "tcp") == "tcp" and (.security // "tls") == "tls")' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    net=$(printf '%s' "${json}" | jq -r '.network // "tcp"')
    sec=$(printf '%s' "${json}" | jq -r '.security // "tls"')
    host=$(printf '%s' "${json}" | jq -r '.sni // .host // empty')
    [[ -n "${host}" ]] || host="${ip}"
    if nginx_front_enabled && [[ "${net}" == "ws" || "${net}" == "httpupgrade" ]]; then
      port=$(nginx_public_port)
      host=$(tls_public_host)
      sec="tls"
    fi
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: trojan"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      echo "    udp: true"
      echo "    sni: ${host}"
      echo "    network: ${net}"
      echo "    client-fingerprint: chrome"
      if [[ "${sec}" == "tls" || "${sec}" == "reality" ]]; then
        echo "    skip-cert-verify: false"
      fi
      if [[ "${sec}" == "reality" ]]; then
        echo "    reality-opts:"
        echo "      public-key: $(printf '%s' "${json}" | jq -r '.public_key')"
        echo "      short-id: $(printf '%s' "${json}" | jq -r --arg d "${REALITY_DEFAULT_SID}" '.short_id // $d')"
      fi
      if [[ "${net}" == "grpc" ]]; then
        echo "    grpc-opts:"
        echo "      grpc-service-name: $(printf '%s' "${json}" | jq -r '.service_name // .path // "grpc"')"
      fi
      if [[ "${net}" == "ws" || "${net}" == "httpupgrade" ]]; then
        echo "    ws-opts:"
        echo "      path: $(printf '%s' "${json}" | jq -r '.path // "/xcc"')"
        echo "      headers:"
        echo "        Host: ${host}"
      fi
    } >> "${file}"
  done < <(jq -c '.trojan[]? | select(.enabled==true and ((.network // "tcp") != "tcp" or (.security // "tls") != "tls"))' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    host=$(printf '%s' "${json}" | jq -r '.sni // .domain // empty')
    insecure=$(printf '%s' "${json}" | jq -r '.insecure // true')
    up=$(printf '%s' "${json}" | jq -r --argjson d "${HYSTERIA_DEFAULT_UP_MBPS}" '.up_mbps // $d')
    down=$(printf '%s' "${json}" | jq -r --argjson d "${HYSTERIA_DEFAULT_DOWN_MBPS}" '.down_mbps // $d')
    obfs=$(printf '%s' "${json}" | jq -r '.obfs // empty')
    [[ -n "${host}" && "${host}" != "localhost" ]] || host="${ip}"
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: hysteria2"
      echo "    server: ${host}"
      echo "    port: ${port}"
      echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      echo "    alpn:"
      echo "      - h3"
      echo "    sni: ${host}"
      echo "    up: \"${up} Mbps\""
      echo "    down: \"${down} Mbps\""
      if [[ -n "${obfs}" ]]; then
        echo "    obfs: salamander"
        echo "    obfs-password: ${obfs}"
      fi
      if [[ "${insecure}" == "true" ]]; then
        echo "    skip-cert-verify: true"
      fi
    } >> "${file}"
  done < <(jq -c '.hysteria[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    host="${ip}"
    net=$(printf '%s' "${json}" | jq -r '.network // "tcp"')
    sec=$(printf '%s' "${json}" | jq -r '.security // "tls"')
    if nginx_front_enabled && [[ "${net}" == "ws" || "${net}" == "httpupgrade" ]]; then
      port=$(nginx_public_port)
      host=$(tls_public_host)
      sec="tls"
    fi
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: vless"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    uuid: $(printf '%s' "${json}" | jq -r '.uuid')"
      echo "    udp: true"
      echo "    network: ${net}"
      if [[ "${sec}" == "tls" || "${sec}" == "reality" ]]; then
        echo "    tls: true"
        echo "    servername: $(printf '%s' "${json}" | jq -r '.sni // .host // empty')"
        echo "    client-fingerprint: chrome"
      fi
      if [[ "${sec}" == "reality" ]]; then
        echo "    reality-opts:"
        echo "      public-key: $(printf '%s' "${json}" | jq -r '.public_key')"
        echo "      short-id: $(printf '%s' "${json}" | jq -r --arg d "${REALITY_DEFAULT_SID}" '.short_id // $d')"
      fi
      flow=$(printf '%s' "${json}" | jq -r '.flow // empty')
      [[ -n "${flow}" && "${net}" == "tcp" ]] && echo "    flow: ${flow}"
      case "${net}" in
        ws|httpupgrade)
          echo "    ws-opts:"
          echo "      path: $(printf '%s' "${json}" | jq -r '.path // "/xcc"')"
          echo "      headers:"
          echo "        Host: $(printf '%s' "${json}" | jq -r '.host // .sni // empty')"
          ;;
        grpc)
          echo "    grpc-opts:"
          echo "      grpc-service-name: $(printf '%s' "${json}" | jq -r '.service_name // "grpc"')"
          ;;
        xhttp)
          echo "    smux:"
          echo "      enabled: false"
          ;;
      esac
    } >> "${file}"
  done < <(jq -c '.vless[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: ss"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    cipher: $(printf '%s' "${json}" | jq -r '.method // "2022-blake3-aes-128-gcm"')"
      echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      echo "    udp: true"
    } >> "${file}"
  done < <(jq -c '.shadowsocks[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: http"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      if [[ "$(printf '%s' "${json}" | jq -r '.username // empty')" != "" ]]; then
        echo "    username: $(printf '%s' "${json}" | jq -r '.username')"
        echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      fi
    } >> "${file}"
  done < <(jq -c '.http[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: socks5"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    udp: true"
      if [[ "$(printf '%s' "${json}" | jq -r '.username // empty')" != "" ]]; then
        echo "    username: $(printf '%s' "${json}" | jq -r '.username')"
        echo "    password: $(printf '%s' "${json}" | jq -r '.password')"
      fi
    } >> "${file}"
  done < <(jq -c '.socks[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)

  while IFS= read -r json; do
    [[ -n "${json}" ]] || continue
    email=$(node_email "${json}")
    port=$(printf '%s' "${json}" | jq -r '.port')
    printf '%s\n' "${email}" >> "${names_file}"
    {
      echo "  - name: $(yaml_quote "${email}")"
      echo "    type: wireguard"
      echo "    server: ${ip}"
      echo "    port: ${port}"
      echo "    private-key: $(printf '%s' "${json}" | jq -r '.client_private_key')"
      echo "    ip: $(printf '%s' "${json}" | jq -r '.client_address // "10.0.0.2/32"' | cut -d/ -f1)"
      echo "    public-key: $(printf '%s' "${json}" | jq -r '.public_key')"
      echo "    udp: true"
      echo "    mtu: $(printf '%s' "${json}" | jq -r '.mtu // 1420')"
    } >> "${file}"
  done < <(jq -c '.wireguard[]? | select(.enabled==true)' "${XCC_NODES}" 2>/dev/null)
}

write_clash_subscribe() {
  local dest="$1"
  local proxies names_file name_yaml="" n tun_yaml=""
  proxies=$(xcc_mktemp)
  names_file=$(xcc_mktemp)
  write_clash_proxies "${proxies}" "${names_file}"
  while IFS= read -r n; do
    [[ -n "${n}" ]] || continue
    name_yaml+="      - $(yaml_quote "${n}")"$'\n'
  done < "${names_file}"
  if [[ -z "${name_yaml}" ]]; then
    name_yaml='      - DIRECT'$'\n'
  fi
  if [[ "$(jq -r '.settings.clash_tun // false' "${XCC_NODES}" 2>/dev/null)" == "true" ]]; then
    tun_yaml=$'tun:\n  enable: true\n  stack: system\n  auto-route: true\n  auto-detect-interface: true\n  strict-route: true\n  dns-hijack:\n    - any:53\n'
  fi
  cat > "${dest}" <<EOF
mixed-port: 7890
allow-lan: true
bind-address: "*"
mode: rule
log-level: info
find-process-mode: strict
unified-delay: true
tcp-concurrent: true
ipv6: true
${tun_yaml}external-controller: 127.0.0.1:9090
profile:
  store-selected: true
sniffer:
  enable: true
  override-destination: false
dns:
  enable: true
  ipv6: true
  enhanced-mode: fake-ip
  nameserver:
    - https://1.1.1.1/dns-query
    - 8.8.8.8
proxies:
$(cat "${proxies}")
proxy-groups:
  - name: 手动切换
    type: select
    proxies:
      - 自动选择
${name_yaml}  - name: 自动选择
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
${name_yaml}rules:
  - MATCH,手动切换
EOF
  rm -f "${proxies}" "${names_file}"
}

write_subscribe_files() {
  local tok raw clash
  [[ -f "${XCC_NODES}" ]] || return 0
  migrate_nodes_json
  mkdir -p "${XCC_SUB_DIR}"
  chmod 755 "${XCC_SUB_DIR}"
  tok=$(ensure_sub_token)
  raw="${XCC_SUB_DIR}/raw.txt"
  clash="${XCC_SUB_DIR}/${tok}.clash.yaml"
  collect_all_links > "${raw}"
  (base64 -w0 "${raw}" 2>/dev/null || base64 "${raw}") > "${XCC_SUB_DIR}/${tok}"
  write_clash_subscribe "${clash}"
  chmod 644 "${XCC_SUB_DIR}/${tok}" "${raw}" "${clash}"
}

rebuild_subscribe() {
  local tok port ip domain nport
  write_subscribe_files
  tok=$(ensure_sub_token)
  port=$(jq -r '.settings.sub_port // 2096' "${XCC_NODES}")
  nport=$(nginx_public_port)
  ip=$(public_ip)
  domain=$(tls_public_host)
  apply_nginx_config || true
  systemctl disable --now xcc-sub >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/xcc-sub.service
  if nginx_front_enabled && [[ -n "${domain}" ]]; then
    printf '通用订阅: https://%s:%s/s/%s\nClash Meta: https://%s:%s/s/%s.clash.yaml\n' \
      "${domain}" "${nport}" "${tok}" "${domain}" "${nport}" "${tok}"
  else
    printf '通用订阅: http://%s:%s/%s\nClash Meta: http://%s:%s/%s.clash.yaml\n' \
      "${ip}" "${port}" "${tok}" "${ip}" "${port}" "${tok}"
  fi
}

bytes_human() {
  local n="${1:-0}"
  awk -v n="${n}" 'BEGIN{
    split("B KB MB GB TB", u, " ");
    i=1; while (n>=1024 && i<5) {n/=1024; i++}
    printf "%.2f %s", n, u[i]
  }'
}

#===============================================================================
# 状态面板（参考 3x-ui dashboard）
#===============================================================================
menu_dashboard() {
  local tmp cpu mem disk up load1 cores xst hst wst ver_x ver_h ip
  tmp=$(xcc_mktemp)
  cpu=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || nproc)
  mem=$(free -h | awk '/Mem:/{print $3" / "$2}')
  disk=$(df -h / | awk 'NR==2{print $3" / "$2" ("$5")"}')
  up=$(uptime -p 2>/dev/null || uptime)
  load1=$(awk '{print $1}' /proc/loadavg)
  cores=$(nproc)
  xst=$(systemctl is-active xray 2>/dev/null || echo unknown)
  wst=$(systemctl is-active xcc-watchdog 2>/dev/null || echo unknown)
  hst=$(systemctl is-active sing-box 2>/dev/null || echo inactive)
  local nst
  nst=$(systemctl is-active nginx 2>/dev/null || echo inactive)
  ver_x=$(xray_installed_version || echo -)
  ver_h=$(singbox_installed_version || echo -)
  ip=$(public_ip)
  {
    echo "===== xcc ${XCC_VERSION} 状态面板 ====="
    echo "主机: $(hostname)    系统: ${OS_ID:-?} ${OS_VERSION_ID:-?}"
    echo "公网 IP: ${ip}"
    echo "CPU: ${cpu} 核    负载: ${load1} (阈值 $((cores * 2)))"
    echo "内存: ${mem}"
    echo "磁盘: ${disk}"
    echo "运行时间: ${up}"
    echo
    echo "Xray: ${xst}  ${ver_x}"
    echo "sing-box (Hysteria2): ${hst}  ${ver_h}"
    echo "Nginx: ${nst}"
    echo "看门狗: ${wst}"
    echo
    echo "----- 节点 -----"
    jq -r '
      def line($k):
        (.[$k][]? | "  \($k)\t\(.tag)\t\(if .port then "port=\(.port)" else "if=\(.name // "-")" end)\t\(if .enabled then "启用" else "禁用" end)\tout=\(.outbound // "proxy")");
      line("reality"), line("vless_ws"), line("vless"), line("vmess"), line("trojan"), line("shadowsocks"),
      line("hysteria"), line("wireguard"), line("http"), line("socks"), line("tunnel"), line("tun")
    ' "${XCC_NODES}" 2>/dev/null || true
    echo
    echo "----- 流量 (Xray Stats API) -----"
    if command -v "${XRAY_BIN}" >/dev/null && is_svc_active xray; then
      "${XRAY_BIN}" api statsquery --server="${XRAY_API_ADDR}" 2>/dev/null \
        | jq -r '.stat[]? | select(.name|test("traffic")) | "\(.name)\t\(.value)"' 2>/dev/null \
        | while IFS=$'\t' read -r name val; do
            printf '  %s  %s\n' "${name}" "$(bytes_human "${val}")"
          done
      echo "(无输出表示尚未产生流量或 API 未就绪)"
    else
      echo "  Xray 未运行，无法读取流量。"
    fi
  } > "${tmp}"
  tui_textbox_file "状态面板" "${tmp}"
  rm -f "${tmp}"
}

#===============================================================================
# 证书 ACME / 自签名（参考 v2ray-agent 自动 TLS）
#===============================================================================
make_self_signed() {
  local cn="${1:-localhost}"
  mkdir -p "${XCC_CERT_DIR}"
  openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
    -keyout "${XCC_CERT_DIR}/privkey.pem" -out "${XCC_CERT_DIR}/fullchain.pem" \
    -subj "/CN=${cn}" >/dev/null 2>&1
  chmod 600 "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field cert "${XCC_CERT_DIR}/fullchain.pem"
  set_settings_field key "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field domain "${cn}"
}

install_acme_sh() {
  if [[ -x "${HOME}/.acme.sh/acme.sh" ]]; then
    return 0
  fi
  info "正在安装 acme.sh ..."
  curl -fsSL https://get.acme.sh | sh -s -- --install-online >/dev/null 2>&1 \
    || curl -fsSL https://cdn.jsdelivr.net/gh/acmesh-official/acme.sh@master/acme.sh | sh -s -- --install-online
}

issue_acme_cert() {
  local domain="$1" email="${2:-admin@${1}}"
  [[ -n "${domain}" ]] || return 1
  fw_allow_tcp 80
  install_nginx || true
  mkdir -p "${NGINX_WWW}/.well-known/acme-challenge"
  apply_nginx_config || true
  install_acme_sh || return 1
  "${HOME}/.acme.sh/acme.sh" --set-default-ca --server letsencrypt >/dev/null 2>&1 || true
  "${HOME}/.acme.sh/acme.sh" --register-account -m "${email}" >/dev/null 2>&1 || true
  if ! "${HOME}/.acme.sh/acme.sh" --issue -d "${domain}" -w "${NGINX_WWW}" --force \
    && ! "${HOME}/.acme.sh/acme.sh" --issue -d "${domain}" --standalone --httpport 80 --force; then
    tui_msg "错误" "ACME 签发失败。请确认域名已解析到本机，且 80 端口未被占用。"
    return 1
  fi
  mkdir -p "${XCC_CERT_DIR}"
  "${HOME}/.acme.sh/acme.sh" --install-cert -d "${domain}" \
    --key-file "${XCC_CERT_DIR}/privkey.pem" \
    --fullchain-file "${XCC_CERT_DIR}/fullchain.pem" \
    --reloadcmd "systemctl reload nginx; systemctl reload xray || systemctl restart xray; systemctl restart sing-box"
  chmod 600 "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field cert "${XCC_CERT_DIR}/fullchain.pem"
  set_settings_field key "${XCC_CERT_DIR}/privkey.pem"
  set_settings_field domain "${domain}"
}

prompt_tls_files() {
  local domain="$1"
  CERT_FILE=$(jq -r '.settings.cert // empty' "${XCC_NODES}")
  KEY_FILE=$(jq -r '.settings.key // empty' "${XCC_NODES}")
  if [[ -n "${CERT_FILE}" && -f "${CERT_FILE}" && -f "${KEY_FILE}" ]]; then
    if tui_yesno "TLS 证书" "已有证书 ${CERT_FILE}，是否继续使用？"; then
