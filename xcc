menu_config_reality() {
  local port sni dest domain uuid tag
  begin_config_op
  port=$(tui_input "配置 Reality 节点" "请输入端口" "443") || { end_config_op_cancel; return 1; }
  assert_port_free "${port}" || { end_config_op_cancel; return 1; }
  domain=$(tui_input "配置 Reality 节点" "请输入伪装域名" "www.microsoft.com") || { end_config_op_cancel; return 1; }
  sni=$(tui_input "配置 Reality 节点" "请输入 SNI（客户端 TLS 握手域名）" "${domain}") || { end_config_op_cancel; return 1; }
  dest=$(tui_input "配置 Reality 节点" "请输入 dest（Reality 伪装目标地址）" "${domain}:443") || { end_config_op_cancel; return 1; }
  if [[ "${dest}" != *:* ]]; then
    dest="${dest}:443"
  fi
  tag="reality-${port}"
  if jq -e --arg tag "${tag}" '.reality[] | select(.tag==$tag)' "${XCC_NODES}" >/dev/null 2>&1; then
    if ! tui_yesno "节点已存在" "标签 ${tag} 已存在，是否覆盖？"; then
      end_config_op_cancel
      return 1
    fi
  fi

  if ! xray_x25519; then
    tui_msg "错误" "xray x25519 生成密钥失败，请确认已安装最新 TLS 版本 Xray。"
    end_config_op_fail
    return 1
  fi
  uuid=$(xray_uuid)
  local short_id node tmp
  short_id=$(rand_hex 4)
  node=$(jq -n \
    --arg tag "${tag}" \
    --argjson port "${port}" \
    --arg uuid "${uuid}" \
    --arg private_key "${REALITY_PRIV}" \
    --arg public_key "${REALITY_PUB}" \
    --arg sni "${sni}" \
    --arg dest "${dest}" \
    --arg short_id "${short_id}" \
    --arg domain "${domain}" \
    '{
      tag:$tag, enabled:true, port:$port, uuid:$uuid,
      private_key:$private_key, public_key:$public_key,
      sni:$sni, dest:$dest, domain:$domain,
      flow:"xtls-rprx-vision", fingerprint:"chrome",
      tls:"1.3", short_id:$short_id, outbound:"proxy"
    }')
  tmp=$(xcc_mktemp)
  jq --arg tag "${tag}" --argjson node "${node}" \
    '(.reality) |= (map(select(.tag != $tag)) + [$node])' \
    "${XCC_NODES}" > "${tmp}"
  mv "${tmp}" "${XCC_NODES}"
  chmod 600 "${XCC_NODES}"

  fw_allow_tcp "${port}"
  if apply_xray_config; then
    end_config_op_ok
    show_share_and_qr "Reality 节点已创建（TLS 1.3 / fp=chrome / flow=xtls-rprx-vision）" \
      "$(reality_share_link "${node}")"
  else
    tui_msg "错误" "写入 Xray 配置失败，已回滚。"
    end_config_op_fail
    return 1
  fi
}

