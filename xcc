xray_mldsa65() {
  REALITY_MLDSA_SEED=""
  REALITY_MLDSA_VERIFY=""
  local out
  [[ -x "${XRAY_BIN}" ]] || return 1
  out=$("${XRAY_BIN}" mldsa65 2>/dev/null) || return 1
  REALITY_MLDSA_SEED=$(printf '%s\n' "${out}" | awk 'NR==1{print $NF}')
  REALITY_MLDSA_VERIFY=$(printf '%s\n' "${out}" | awk 'NR==2{print $NF}')
  [[ -n "${REALITY_MLDSA_SEED}" && -n "${REALITY_MLDSA_VERIFY}" ]]
}

# 与 v2ray-agent initRealityMldsa65 相同：目标支持 X25519MLKEM768 且证书链 > 3500 才生成。
maybe_init_mldsa65() {
  local dest="$1"
  REALITY_MLDSA_SEED=""
  REALITY_MLDSA_VERIFY=""
  [[ -x "${XRAY_BIN}" ]] || return 0
  local ping length
  ping=$("${XRAY_BIN}" tls ping "${dest}" 2>/dev/null) || return 0
  printf '%s\n' "${ping}" | grep -q "X25519MLKEM768" || return 0
  length=$(printf '%s\n' "${ping}" | awk '/Certificate chain/{print $NF; exit}')
  [[ "${length}" =~ ^[0-9]+$ && "${length}" -gt 3500 ]] || return 0
  xray_mldsa65 || true
}

