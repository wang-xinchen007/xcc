#===============================================================================
# 菜单：SSH 端口
# 先放行新端口，再改配置；sshd -t 失败则回滚。
#===============================================================================
current_ssh_port() {
  awk '/^[Pp]ort[[:space:]]+/ {p=$2} END{if(p) print p; else print 22}' "${SSHD_CONFIG}" 2>/dev/null
}

menu_ssh_port() {
  local old new
  old=$(current_ssh_port)
  new=$(tui_input "设置 SSH 端口" "当前端口 ${old}，请输入新端口" "${old}") || return 1
  [[ "${new}" == "${old}" ]] && { tui_msg "提示" "端口未变化。"; return 0; }
  if ! [[ "${new}" =~ ^[0-9]+$ ]] || [[ "${new}" -lt 1 || "${new}" -gt 65535 ]]; then
    tui_msg "错误" "无效端口"
    return 1
  fi
  begin_config_op
  fw_allow_tcp "${new}"
  # Ubuntu 24.04：若 ufw 为 active，先放行新端口，修改后再 reload；inactive 则跳过。
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | head -n1 | grep -qi 'active'; then
    ufw allow "${new}/tcp" >/dev/null || true
  fi
  cp -a "${SSHD_CONFIG}" "${SSHD_CONFIG}.xccbak"
  if grep -Eq '^[Pp]ort[[:space:]]+' "${SSHD_CONFIG}"; then
    sed -i "s/^[Pp]ort[[:space:]].*/Port ${new}/" "${SSHD_CONFIG}"
  else
    printf '\nPort %s\n' "${new}" >> "${SSHD_CONFIG}"
  fi
  local sshd_err
  sshd_err=$(xcc_mktemp)
  if ! sshd -t >"${sshd_err}" 2>&1; then
    mv "${SSHD_CONFIG}.xccbak" "${SSHD_CONFIG}"
    tui_msg "错误" "sshd -t 检查失败，已回滚。$(cat "${sshd_err}" 2>/dev/null)"
    rm -f "${sshd_err}"
    end_config_op_fail
    return 1
  fi
  rm -f "${sshd_err}"
  if systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null; then
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | head -n1 | grep -qi 'active'; then
      ufw reload >/dev/null || true
    fi
    end_config_op_ok
    tui_msg "SSH 端口已修改" "新端口 ${new}。请另开 SSH 窗口测试新端口，确认成功后再清理旧端口规则。"
    if tui_yesno "清理旧规则" "新端口 ${new} 是否已测试成功？确认后将清理旧端口 ${old} 的防火墙规则。"; then
      fw_delete_tcp "${old}"
    fi
  else
    mv "${SSHD_CONFIG}.xccbak" "${SSHD_CONFIG}"
    tui_msg "错误" "重启 SSH 服务失败，已回滚配置。"
    end_config_op_fail
    return 1
  fi
}

