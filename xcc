# NTP 时间同步：未同步则自动开启。
check_ntp() {
  if ! command -v timedatectl >/dev/null 2>&1; then
    return 0
  fi
  local status
  status=$(timedatectl status 2>/dev/null || true)
  if ! printf '%s' "${status}" | grep -Eqi 'NTP synchronized: yes|System clock synchronized: yes'; then
    info "NTP 未同步，正在执行 timedatectl set-ntp true"
