#===============================================================================
# 防火墙：nftables → ufw → firewalld → iptables
#===============================================================================
fw_kind() {
  if is_svc_active nftables; then
    printf 'nftables'
    return
  fi
  if command -v ufw >/dev/null 2>&1; then
    local st
    st=$(ufw status 2>/dev/null | head -n1 || true)
    if printf '%s' "${st}" | grep -qi 'active'; then
      printf 'ufw'
      return
    fi
  fi
  if is_svc_active firewalld; then
    printf 'firewalld'
    return
  fi
  if command -v iptables >/dev/null 2>&1; then
    printf 'iptables'
    return
  fi
  printf 'none'
}

# 放行 TCP 端口；ufw inactive 时跳过 ufw。
fw_allow_tcp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    nftables)
      nft add table inet filter 2>/dev/null || true
      nft 'add chain inet filter input { type filter hook input priority 0; }' 2>/dev/null || true
      if nft add rule inet filter input tcp dport "${port}" accept 2>/dev/null; then
        nft list ruleset > /etc/nftables.conf 2>/dev/null || true
        info "nftables 已放行 TCP ${port}"
      else
        warn "nftables 放行 TCP ${port} 失败，请手动放行。"
      fi
      ;;
    ufw)
      ufw allow "${port}/tcp" >/dev/null
      ufw reload >/dev/null || true
      info "ufw 已放行 TCP ${port}"
      ;;
    firewalld)
      firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null
      firewall-cmd --reload >/dev/null
      info "firewalld 已放行 TCP ${port}"
      ;;
    iptables)
      iptables -I INPUT -p tcp --dport "${port}" -j ACCEPT
      mkdir -p /etc/iptables
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      info "iptables 已放行 TCP ${port}"
      ;;
    *)
      warn "未检测到防火墙，请手动放行端口 ${port}"
      ;;
  esac
}

fw_allow_udp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    nftables)
      nft add table inet filter 2>/dev/null || true
      nft 'add chain inet filter input { type filter hook input priority 0; }' 2>/dev/null || true
      nft add rule inet filter input udp dport "${port}" accept 2>/dev/null || true
      nft list ruleset > /etc/nftables.conf 2>/dev/null || true
      ;;
    ufw)
      ufw allow "${port}/udp" >/dev/null
      ufw reload >/dev/null || true
      ;;
    firewalld)
      firewall-cmd --permanent --add-port="${port}/udp" >/dev/null
      firewall-cmd --reload >/dev/null
      ;;
    iptables)
      iptables -I INPUT -p udp --dport "${port}" -j ACCEPT
      mkdir -p /etc/iptables
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      ;;
    *)
      warn "未检测到防火墙，请手动放行 UDP 端口 ${port}"
      ;;
  esac
}

fw_delete_tcp() {
  local port="$1"
  local kind
  kind=$(fw_kind)
  case "${kind}" in
    ufw)
      ufw delete allow "${port}/tcp" >/dev/null 2>&1 || true
      ufw reload >/dev/null || true
      ;;
    firewalld)
      firewall-cmd --permanent --remove-port="${port}/tcp" >/dev/null 2>&1 || true
      firewall-cmd --reload >/dev/null 2>&1 || true
      ;;
    iptables)
      iptables -D INPUT -p tcp --dport "${port}" -j ACCEPT 2>/dev/null || true
      iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
      ;;
    nftables)
      warn "nftables 删除规则需手动处理（请用 nft -a list ruleset 查找 handle）。"
      ;;
  esac
}

