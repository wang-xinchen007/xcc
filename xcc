menu_bbr() {
  local cur
  cur=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)
  if ! tui_yesno "BBR" "当前拥塞控制: ${cur}\n是否启用 BBR + fq？"; then
    return 0
  fi
  cat > /etc/sysctl.d/99-xcc-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
  sysctl -p /etc/sysctl.d/99-xcc-bbr.conf >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1 || true
  tui_msg "BBR" "已写入 /etc/sysctl.d/99-xcc-bbr.conf\n当前: $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
}

#===============================================================================
# Cloudflare WARP 出站（参考 3x-ui / v2ray-agent 分流）
#===============================================================================
menu_warp() {
  local choice arch url tmp cfg priv addr
  choice=$(tui_menu "WARP 出站" "将 Cloudflare WARP 注册为 Xray wireguard 出站（tag=warp）" \
    "on" "安装 / 注册 WARP" \
    "off" "移除 WARP 出站") || return 0
  begin_config_op
  case "${choice}" in
    off)
      rm -f "${XCC_WARP_FILE}"
      if apply_xray_config; then end_config_op_ok; tui_msg "完成" "已移除 WARP。"; else end_config_op_fail; fi
      return
      ;;
  esac
  arch=$(arch_suffix)
  tmp=$(xcc_mktemp)
  local wtag
  wtag=$(github_latest_tag "https://api.github.com/repos/ViRb3/wgcf/releases/latest" || true)
  wtag="${wtag#v}"
  [[ -n "${wtag}" ]] || wtag="2.2.22"
  url="https://github.com/ViRb3/wgcf/releases/download/${wtag}/wgcf_${wtag}_linux_${arch}"
  info "下载 wgcf ..."
  if ! xcc_curl "${tmp}" "${url}"; then
    xcc_curl "${tmp}" "https://ghproxy.net/${url}" || { end_config_op_fail; tui_msg "错误" "下载 wgcf 失败"; return 1; }
  fi
  chmod 755 "${tmp}"
  mkdir -p "${XCC_CACHE_DIR}/wgcf"
  mv "${tmp}" "${XCC_CACHE_DIR}/wgcf/wgcf"
  (
    cd "${XCC_CACHE_DIR}/wgcf"
    [[ -f wgcf-account.toml ]] || ./wgcf register --accept-tos >/dev/null
    ./wgcf generate >/dev/null
  ) || { end_config_op_fail; tui_msg "错误" "wgcf 注册失败"; return 1; }
  cfg="${XCC_CACHE_DIR}/wgcf/wgcf-profile.conf"
  priv=$(awk -F' = ' '/^PrivateKey/{print $2}' "${cfg}" | head -n1)
  addr=$(awk -F' = ' '/^Address/{print $2}' "${cfg}" | head -n1 | cut -d, -f1)
  jq -n --arg sk "${priv}" --arg addr "${addr}" '{
      tag:"warp", protocol:"wireguard",
      settings:{
        secretKey:$sk,
        address:[$addr],
        peers:[{publicKey:"bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=", endpoint:"engage.cloudflareclient.com:2408"}]
      }
    }' > "${XCC_WARP_FILE}"
  chmod 600 "${XCC_WARP_FILE}"
  if apply_xray_config; then
    end_config_op_ok
    tui_msg "完成" "WARP 出站 tag=warp。可在「管理节点」里把出站改为 warp。"
  else
    end_config_op_fail
  fi
}

