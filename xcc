menu_config_hysteria() {
  local port password obfs domain email sni tag use_acme cert key
  begin_config_op
  install_singbox || { tui_msg "错误" "sing-box 安装失败"; end_config_op_fail; return 1; }
  port=$(tui_input "配置 Hysteria2" "UDP 端口（可与 Nginx TCP 443 并存，与 v2ray-agent 相同）" "443") || { end_config_op_cancel; return 1; }
  assert_udp_port_free "${port}" || { end_config_op_cancel; return 1; }
  password=$(tui_input "配置 Hysteria2" "请输入密码（回车则使用 UUID，与 v2ray-agent 一致）" "$(xray_uuid)") || { end_config_op_cancel; return 1; }
  if tui_yesno "salamander 混淆" "是否启用 salamander 混淆？（v2ray-agent 默认关闭）" 1; then
    obfs=$(tui_input "混淆参数" "salamander 密码（回车随机）" "$(rand_alnum 16)") || { end_config_op_cancel; return 1; }
  else
    obfs=""
  fi
  domain=$(jq -r '.settings.domain // empty' "${XCC_NODES}")
  cert=$(jq -r '.settings.cert // empty' "${XCC_NODES}")
  key=$(jq -r '.settings.key // empty' "${XCC_NODES}")
  email=""
  use_acme="false"
  if [[ -n "${domain}" && "${domain}" != "localhost" && -n "${cert}" && -f "${cert}" && -n "${key}" && -f "${key}" ]]; then
    sni="${domain}"
    tui_msg "TLS 证书" "将使用已有证书 ${cert}（域名 ${domain}）。"
  elif tui_yesno "ACME 证书" "是否启用 ACME（需要已解析到本机的域名）？"; then
    use_acme="true"
    domain=$(tui_input "ACME 域名" "请输入域名" "${domain}") || { end_config_op_cancel; return 1; }
    email=$(tui_input "ACME 邮箱" "请输入邮箱" "admin@${domain}") || { end_config_op_cancel; return 1; }
    sni="${domain}"
    issue_acme_cert "${domain}" "${email}" || { end_config_op_fail; return 1; }
  else
    tui_msg "自签名证书" "未启用 ACME，将生成自签名证书（客户端需 insecure，仅限测试）。"
    sni="localhost"
    domain=""
  fi
  tag="hysteria-${port}"
  [[ -n "${email}" ]] || email="${tag}"
  local node insecure
  insecure="true"
  [[ -n "${sni}" && "${sni}" != "localhost" ]] && insecure="false"
  node=$(jq -n \
    --arg tag "${tag}" \
    --argjson port "${port}" \
    --arg password "${password}" \
    --arg obfs "${obfs}" \
    --arg acme "${use_acme}" \
    --arg domain "${domain}" \
    --arg email "${email}" \
    --arg sni "${sni}" \
    --arg insecure "${insecure}" \
    --argjson up "${HYSTERIA_DEFAULT_UP_MBPS}" \
    --argjson down "${HYSTERIA_DEFAULT_DOWN_MBPS}" \
    '{
      tag:$tag, enabled:true, port:$port, password:$password, obfs:$obfs,
      acme:($acme=="true"), domain:$domain, email:$email, sni:$sni,
      insecure:($insecure=="true"), outbound:"proxy",
      up_mbps:$up, down_mbps:$down
    }')
  if ! jq_apply "${XCC_NODES}" --arg tag "${tag}" --argjson node "${node}" \
    '(.hysteria) |= (map(select(.tag != $tag)) + [$node])'; then
    tui_msg "错误" "写入 nodes.json 失败"
    end_config_op_fail
    return 1
  fi
  fw_allow_udp "${port}"
  fw_allow_tcp "${port}"
  if apply_all_configs; then
    end_config_op_ok
    show_share_and_qr "Hysteria2（sing-box）节点已创建" "$(hysteria_share_link "${node}")"
  else
    tui_msg "错误" "写入 sing-box / Nginx 配置失败，已回滚。"
    end_config_op_fail
    return 1
  fi
}

#===============================================================================
# 节点选择
#===============================================================================
select_node_tag() {
  local kind="$1"
  local title="$2"
  local count items=() tag desc
  migrate_nodes_json
  count=$(jq -r --arg k "${kind}" '(.[$k] // []) | length' "${XCC_NODES}")
  if [[ "${count}" -eq 0 ]]; then
    tui_msg "提示" "尚未配置 ${kind} 节点。"
    return 1
  fi
  while IFS=$'\t' read -r tag desc; do
    items+=("${tag}" "${desc}")
  done < <(jq -r --arg k "${kind}" '
    .[$k][] | [
      .tag,
      (
        (if .enabled then "启用" else "禁用" end)
        + (if .port then " port=" + (.port|tostring) else " if=" + (.name // .tag) end)
        + " outbound=" + (.outbound // "proxy")
      )
    ] | @tsv
  ' "${XCC_NODES}")
  tui_menu "${title}" "请选择节点" "${items[@]}"
}

node_json_by_tag() {
  local kind="$1"
  local tag="$2"
  jq -c --arg k "${kind}" --arg tag "${tag}" '.[$k][] | select(.tag==$tag)' "${XCC_NODES}"
}

upsert_node() {
  local kind="$1"
  local node="$2"
  local tag
  tag=$(printf '%s' "${node}" | jq -r '.tag')
  jq_apply "${XCC_NODES}" --arg k "${kind}" --arg tag "${tag}" --argjson node "${node}" \
    '.[$k] = ((.[$k] // []) | map(select(.tag != $tag)) + [$node])'
}

delete_node() {
  local kind="$1"
  local tag="$2"
  jq_apply "${XCC_NODES}" --arg k "${kind}" --arg tag "${tag}" \
    '.[$k] |= map(select(.tag != $tag))'
}

set_node_field() {
  local kind="$1" tag="$2" key="$3" value="$4" is_json="${5:-0}"
  if [[ "${is_json}" -eq 1 ]]; then
    jq_apply "${XCC_NODES}" --arg k "${kind}" --arg tag "${tag}" --arg key "${key}" --argjson val "${value}" \
      '(.[$k][] | select(.tag==$tag) | .[$key]) = $val'
  else
    jq_apply "${XCC_NODES}" --arg k "${kind}" --arg tag "${tag}" --arg key "${key}" --arg val "${value}" \
      '(.[$k][] | select(.tag==$tag) | .[$key]) = $val'
  fi
}

