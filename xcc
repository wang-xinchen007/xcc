vless_share_link() {
  local json="$1" ip uuid port sni host path email net sec flow svc mode hdr seed pbk sid q type
  ip=$(public_ip)
  uuid=$(printf '%s' "${json}" | jq -r '.uuid')
  net=$(printf '%s' "${json}" | jq -r '.network // "tcp"')
  sec=$(printf '%s' "${json}" | jq -r '.security // "tls"')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .host // empty')
  host=$(printf '%s' "${json}" | jq -r '.host // .sni // empty')
  path=$(printf '%s' "${json}" | jq -r '.path // empty')
  flow=$(printf '%s' "${json}" | jq -r '.flow // empty')
  svc=$(printf '%s' "${json}" | jq -r '.service_name // empty')
  mode=$(printf '%s' "${json}" | jq -r '.xhttp_mode // "auto"')
  hdr=$(printf '%s' "${json}" | jq -r '.header_type // "none"')
  seed=$(printf '%s' "${json}" | jq -r '.seed // empty')
  pbk=$(printf '%s' "${json}" | jq -r '.public_key // empty')
  sid=$(printf '%s' "${json}" | jq -r --arg d "${REALITY_DEFAULT_SID}" '.short_id // $d')
  email=$(node_email "${json}")
  type="${net}"
  [[ "${type}" == "kcp" ]] && type="kcp"
  if nginx_front_enabled && [[ "${net}" == "ws" || "${net}" == "httpupgrade" ]]; then
    port=$(nginx_public_port)
    host=$(tls_public_host)
    sni="${host}"
    sec="tls"
  else
    port=$(printf '%s' "${json}" | jq -r '.port')
  fi
  q="encryption=none&security=${sec}&type=${type}"
  [[ -n "${sni}" ]] && q+="&sni=${sni}"
  q+="&fp=chrome"
  case "${net}" in
    ws|httpupgrade) q+="&host=${host}&path=$(urlencode "${path:-/}")" ;;
    grpc) q+="&serviceName=$(urlencode "${svc:-grpc}")&mode=gun" ;;
    xhttp) q+="&path=$(urlencode "${path:-/xhttp}")&mode=${mode}"; [[ -n "${host}" ]] && q+="&host=${host}" ;;
    kcp) q+="&headerType=${hdr}"; [[ -n "${seed}" ]] && q+="&seed=$(urlencode "${seed}")" ;;
    tcp) q+="&headerType=${hdr}"; [[ -n "${host}" && "${hdr}" == "http" ]] && q+="&host=${host}&path=$(urlencode "${path:-/}")" ;;
  esac
  if [[ "${sec}" == "reality" ]]; then
    q+="&pbk=${pbk}&sid=${sid}"
  fi
  [[ -n "${flow}" && "${net}" == "tcp" ]] && q+="&flow=${flow}"
  printf 'vless://%s@%s:%s?%s#%s\n' "${uuid}" "${ip}" "${port}" "${q}" "${email}"
}

