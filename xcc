menu_manage_reality() {
  local tag json choice port
  tag=$(select_node_tag reality "管理 Reality 节点") || return 1
  json=$(node_json_by_tag reality "${tag}")
  while true; do
    json=$(node_json_by_tag reality "${tag}")
    [[ -n "${json}" ]] || return 0
    local status
    status=$(printf '%s' "${json}" | jq -r '"\(.tag)  端口:\(.port)  状态:\(if .enabled then "启用" else "禁用" end)  SNI:\(.sni)  dest:\(.dest)  TLS:\(.tls // "1.3")  出站:\(.outbound // "proxy")"')
    choice=$(tui_menu "管理 Reality" "${status}" \
      "toggle" "启用 / 禁用" \
      "port"   "修改端口" \
      "sni"    "更新伪装域名 / SNI / dest" \
      "tls"    "更新 TLS 版本（强制 1.3）" \
      "out"    "设置该节点出站方式（Shifter 或直连）" \
      "share"  "显示分享链接与二维码" \
      "del"    "删除节点" \
      "back"   "返回主菜单") || return 0
    case "${choice}" in
      toggle)
        begin_config_op
        if [[ "$(printf '%s' "${json}" | jq -r '.enabled')" == "true" ]]; then
          set_node_field reality "${tag}" enabled false 1
        else
          set_node_field reality "${tag}" enabled true 1
        fi
        if apply_xray_config; then end_config_op_ok; else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        ;;
      port)
        begin_config_op
        port=$(tui_input "修改端口" "新端口" "$(printf '%s' "${json}" | jq -r '.port')") || { end_config_op_cancel; continue; }
        assert_port_free "${port}" "${tag}" || { end_config_op_cancel; continue; }
        set_node_field reality "${tag}" port "${port}" 1
        local newtag="reality-${port}"
        set_node_field reality "${tag}" tag "${newtag}"
        fw_allow_tcp "${port}"
        tag="${newtag}"
        if apply_xray_config; then end_config_op_ok; else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        ;;
      sni)
        begin_config_op
        local domain sni dest
        domain=$(tui_input "伪装域名" "伪装域名" "$(printf '%s' "${json}" | jq -r '.domain // .sni')") || { end_config_op_cancel; continue; }
        sni=$(tui_input "SNI" "SNI" "${domain}") || { end_config_op_cancel; continue; }
        dest=$(tui_input "dest" "dest" "${domain}:443") || { end_config_op_cancel; continue; }
        [[ "${dest}" == *:* ]] || dest="${dest}:443"
        set_node_field reality "${tag}" domain "${domain}"
        set_node_field reality "${tag}" sni "${sni}"
        set_node_field reality "${tag}" dest "${dest}"
        if apply_xray_config; then end_config_op_ok; else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        ;;
      tls)
        begin_config_op
        local tlsv
        tlsv=$(tui_input "TLS 版本" "当前强制使用 TLS 1.3" "1.3") || { end_config_op_cancel; continue; }
        if [[ "${tlsv}" != "1.3" ]]; then
          tui_msg "提示" "xcc 强制使用 TLS 1.3，已忽略其他输入。"
        fi
        set_node_field reality "${tag}" tls "1.3"
        if apply_xray_config; then end_config_op_ok; else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        ;;
      out)
        begin_config_op
        local ob
        ob=$(tui_menu "出站方式" "为 ${tag} 选择出站" \
          "proxy" "Shifter / SOCKS5 默认出站" \
          "direct" "直连" \
          "warp" "Cloudflare WARP") || { end_config_op_cancel; continue; }
        set_node_field reality "${tag}" outbound "${ob}"
        if apply_xray_config; then end_config_op_ok; else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        ;;
      share)
        show_share_and_qr "Reality 分享链接" "$(reality_share_link "${json}")"
        ;;
      del)
        begin_config_op
        if tui_yesno "删除节点" "确认删除 ${tag}？"; then
          delete_node reality "${tag}"
          if apply_xray_config; then end_config_op_ok; tui_msg "完成" "节点已删除"; return 0
          else tui_msg "错误" "应用配置失败"; end_config_op_fail; fi
        else
          end_config_op_cancel
        fi
        ;;
      back|*) return 0 ;;
    esac
  done
}

