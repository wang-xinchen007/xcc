#===============================================================================
# 出站解析与 Xray/Hysteria 配置应用
#===============================================================================
outbound_mode() {
  if [[ ! -f "${XCC_OUTBOUND}" ]]; then
    printf 'direct'
    return
  fi
  local url
  url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
  if [[ -z "${url}" || "${url}" == DIRECT || "${url}" == direct ]]; then
    printf 'direct'
  else
    printf 'proxy'
  fi
}

# 解析 SOCKS5://user:pass@ip:port
parse_socks5() {
  local url="$1"
  SOCKS_USER=""
  SOCKS_PASS=""
  SOCKS_HOST=""
  SOCKS_PORT=""
  url="${url#SOCKS5://}"
  url="${url#socks5://}"
  url="${url#SOCKS5H://}"
  url="${url#socks5h://}"
  if [[ "${url}" == *"@"* ]]; then
    local cred rest
    cred="${url%@*}"
    rest="${url##*@}"
    SOCKS_USER="${cred%%:*}"
    SOCKS_PASS="${cred#*:}"
    SOCKS_HOST="${rest%%:*}"
    SOCKS_PORT="${rest##*:}"
  else
    SOCKS_HOST="${url%%:*}"
    SOCKS_PORT="${url##*:}"
  fi
}

public_ip() {
  xcc_curl_stdout "${IPIFY_URL}" -4 --max-time 8 2>/dev/null \
    || xcc_curl_stdout "https://ifconfig.me" -4 --max-time 8 2>/dev/null \
    || hostname -I 2>/dev/null | awk '{print $1}'
}

# Xray 语法检查：优先 run -test。Xray 26+ 必须用 .json 后缀才能识别格式。
XRAY_TEST_ERR=""
xray_test_config() {
  local cfg="${1:-${XRAY_CONF}}"
  local json_cfg="${cfg}" tmp=""
  XRAY_TEST_ERR=""
  if [[ "${cfg}" != *.json ]]; then
    tmp=$(xcc_mktemp .json)
    cp -a "${cfg}" "${tmp}"
    json_cfg="${tmp}"
  fi
  if "${XRAY_BIN}" run -test -config "${json_cfg}" >/dev/null 2>&1 \
    || "${XRAY_BIN}" run -test -format json -config "${json_cfg}" >/dev/null 2>&1 \
    || "${XRAY_BIN}" -test -config "${json_cfg}" >/dev/null 2>&1; then
    [[ -n "${tmp}" ]] && rm -f "${tmp}"
    return 0
  fi
  XRAY_TEST_ERR=$("${XRAY_BIN}" run -test -format json -config "${json_cfg}" 2>&1 | tail -n 30 || true)
  [[ -z "${XRAY_TEST_ERR}" ]] && XRAY_TEST_ERR=$("${XRAY_BIN}" run -test -config "${json_cfg}" 2>&1 | tail -n 30 || true)
  err "${XRAY_TEST_ERR}"
  [[ -n "${tmp}" ]] && rm -f "${tmp}"
  return 1
}

xray_reload_or_restart() {
  if systemctl reload xray >/dev/null 2>&1; then
    return 0
  fi
  systemctl restart xray
}

# Hysteria 语法检查：优先 check；不支持 check 时校验 JSON，避免试启动占用端口。
hysteria_test_config() {
  local cfg="$1"
  if [[ -x "${HYSTERIA_BIN}" ]]; then
    if "${HYSTERIA_BIN}" check -config "${cfg}" >/dev/null 2>&1 \
      || "${HYSTERIA_BIN}" check -c "${cfg}" >/dev/null 2>&1; then
      return 0
    fi
  fi
  jq empty "${cfg}" >/dev/null 2>&1
}

# 根据 nodes.json + outbound.conf 重建 Xray 配置。
# 路由：API → BT/广告/域名黑名单 → 各入站独立出站 → CN 直连 → 默认出站。
apply_xray_config() {
  local tmp dns_json mode proxy_json node_json warp_json has_geo
  ensure_xray_inbounds_array
  migrate_nodes_json
  dns_json=$(dns_servers_json)
  mode=$(outbound_mode)

  if [[ "${mode}" == "proxy" ]]; then
    local url
    url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
    parse_socks5 "${url}"
    if [[ -z "${SOCKS_HOST}" || ! "${SOCKS_PORT}" =~ ^[0-9]+$ ]]; then
      err "outbound.conf 格式无效，应为 SOCKS5://user:pass@ip:port"
      return 1
    fi
    if [[ -n "${SOCKS_USER}" ]]; then
      proxy_json=$(jq -n \
        --arg host "${SOCKS_HOST}" \
        --argjson port "${SOCKS_PORT}" \
        --arg user "${SOCKS_USER}" \
        --arg pass "${SOCKS_PASS}" \
        '{tag:"proxy",protocol:"socks",settings:{servers:[{address:$host,port:$port,users:[{user:$user,pass:$pass}]}]}}')
    else
      proxy_json=$(jq -n \
        --arg host "${SOCKS_HOST}" \
        --argjson port "${SOCKS_PORT}" \
        '{tag:"proxy",protocol:"socks",settings:{servers:[{address:$host,port:$port}]}}')
    fi
  else
    proxy_json='{"tag":"proxy","protocol":"freedom","settings":{}}'
  fi

  warp_json='null'
  if [[ -f "${XCC_WARP_FILE}" ]] && jq empty "${XCC_WARP_FILE}" 2>/dev/null; then
    warp_json=$(cat "${XCC_WARP_FILE}")
  fi
  has_geo="false"
  if [[ -f /usr/local/share/xray/geosite.dat || -f /usr/local/share/xray/geoip.dat ]]; then
    has_geo="true"
  fi

  node_json=$(cat "${XCC_NODES}")
  tmp=$(xcc_mktemp .json)

  if ! jq -n \
    --argjson dns "${dns_json}" \
    --argjson nodes "${node_json}" \
    --argjson proxy "${proxy_json}" \
    --argjson warp "${warp_json}" \
    --argjson has_geo "${has_geo}" \
    --arg default_tag "$( [[ "${mode}" == "proxy" ]] && echo proxy || echo direct )" \
    '
    def sniff: {enabled:true, destOverride:["http","tls","quic"]};
    def certfile:
      if (.cert // "") != "" then .cert
      else ($nodes.settings.cert // "/etc/xcc/certs/fullchain.pem") end;
    def keyfile:
      if (.key // "") != "" then .key
      else ($nodes.settings.key // "/etc/xcc/certs/privkey.pem") end;
    def tls_ss($network):
      {
        network: $network,
        security: "tls",
        tlsSettings: {
          minVersion: "1.3",
          maxVersion: "1.3",
          certificates: [{certificateFile: certfile, keyFile: keyfile}]
        }
      }
      + (if $network == "ws" then {
           wsSettings: {path: (.path // "/xcc"), headers: {Host: (.host // .sni // "")}}
         } else {} end);
    def reality_inbound:
      {
        tag: .tag, listen: "0.0.0.0", port: .port, protocol: "vless",
        settings: {
          clients: [{id: .uuid, flow: (.flow // "xtls-rprx-vision"), email: (.email // "xcc")}],
          decryption: "none"
        },
        streamSettings: {
          network: "tcp", security: "reality",
          realitySettings: {
            show: false, dest: .dest, xver: 0,
            serverNames: [.sni], privateKey: .private_key,
            shortIds: [(.short_id // "")]
          }
        },
        sniffing: sniff
      };
    def vless_ws_inbound:
      {
        tag: .tag, listen: "0.0.0.0", port: .port, protocol: "vless",
        settings: {clients: [{id: .uuid, email: (.email // "xcc")}], decryption: "none"},
        streamSettings: tls_ss("ws"),
        sniffing: sniff
      };
    def vmess_inbound:
      {
        tag: .tag, listen: "0.0.0.0", port: .port, protocol: "vmess",
        settings: {clients: [{id: .uuid, alterId: 0, email: (.email // "xcc")}]},
        streamSettings: tls_ss(.network // "ws"),
        sniffing: sniff
      };
    def trojan_inbound:
      {
        tag: .tag, listen: "0.0.0.0", port: .port, protocol: "trojan",
        settings: {clients: [{password: .password, email: (.email // "xcc")}]},
        streamSettings: tls_ss(.network // "tcp"),
        sniffing: sniff
      };
    def ss_inbound:
      {
        tag: .tag, listen: "0.0.0.0", port: .port, protocol: "shadowsocks",
        settings: {
          method: (.method // "2022-blake3-aes-128-gcm"),
          password: .password,
          network: "tcp,udp"
        },
        sniffing: sniff
      };
    def node_rule:
      {type:"field", inboundTag:[.tag], outboundTag:(.outbound // $default_tag)};
    def api_in:
      {listen:"127.0.0.1", port:10085, protocol:"dokodemo-door", settings:{address:"127.0.0.1"}, tag:"api"};

    ($nodes.settings // {}) as $st |
    {
      log: {loglevel: "warning"},
      stats: {},
      api: {tag: "api", services: ["StatsService", "HandlerService"]},
      policy: {
        levels: {"0": {statsUserUplink: true, statsUserDownlink: true}},
        system: {
          statsInboundUplink: true, statsInboundDownlink: true,
          statsOutboundUplink: true, statsOutboundDownlink: true
        }
      },
      dns: {servers: $dns},
      inbounds:
        [api_in]
        + [ $nodes.reality[]?     | select(.enabled == true) | reality_inbound ]
        + [ $nodes.vless_ws[]?    | select(.enabled == true) | vless_ws_inbound ]
        + [ $nodes.vmess[]?       | select(.enabled == true) | vmess_inbound ]
        + [ $nodes.trojan[]?      | select(.enabled == true) | trojan_inbound ]
        + [ $nodes.shadowsocks[]? | select(.enabled == true) | ss_inbound ],
      outbounds:
        (
          [ (if $default_tag == "proxy" then $proxy else {tag:"direct", protocol:"freedom", settings:{}} end),
            (if $default_tag == "proxy" then {tag:"direct", protocol:"freedom", settings:{}} else $proxy end),
            {tag:"block", protocol:"blackhole", settings:{}} ]
          + (if $warp != null then [$warp] else [] end)
        ),
      routing: {
        domainStrategy: "AsIs",
        rules:
          [ {type:"field", inboundTag:["api"], outboundTag:"api"} ]
          + (if ($st.block_bt // true) then [{type:"field", protocol:["bittorrent"], outboundTag:"block"}] else [] end)
          + (if ($st.block_ads // false) and $has_geo then [{type:"field", domain:["geosite:category-ads-all"], outboundTag:"block"}] else [] end)
          + (if (($st.domain_block // [])|length) > 0 then [{type:"field", domain:($st.domain_block), outboundTag:"block"}] else [] end)
          + [ $nodes.hysteria[]?     | select(.enabled == true) | node_rule ]
          + [ $nodes.shadowsocks[]?  | select(.enabled == true) | node_rule ]
          + [ $nodes.trojan[]?       | select(.enabled == true) | node_rule ]
          + [ $nodes.vmess[]?        | select(.enabled == true) | node_rule ]
          + [ $nodes.vless_ws[]?     | select(.enabled == true) | node_rule ]
          + [ $nodes.reality[]?      | select(.enabled == true) | node_rule ]
          + (if ($st.cn_direct // false) and $has_geo then [
               {type:"field", domain:["geosite:cn"], outboundTag:"direct"},
               {type:"field", ip:["geoip:cn"], outboundTag:"direct"}
             ] else [] end)
      }
    }
    ' > "${tmp}"; then
    err "jq 生成 Xray 配置失败，请检查 /etc/xcc/nodes.json"
    tui_msg "配置生成失败" "jq 无法生成 Xray JSON，请检查 nodes.json 是否损坏。"
    rm -f "${tmp}"
    return 1
  fi

  if ! xray_test_config "${tmp}"; then
    err "Xray 配置语法检查失败，已拒绝写入。"
    printf '%s\n' "${XRAY_TEST_ERR:-未知错误}" > "${XCC_TMP_DIR}/xray-test-err.txt"
    tui_textbox_file "Xray 配置检查失败（已拒绝写入）" "${XCC_TMP_DIR}/xray-test-err.txt"
    rm -f "${tmp}"
    return 1
  fi
  mv "${tmp}" "${XRAY_CONF}"
  chmod 600 "${XRAY_CONF}"
  xray_reload_or_restart
}

hysteria_outbound_json() {
  local node_ob="$1"
  local mode
  mode=$(outbound_mode)
  if [[ "${node_ob}" == "direct" || "${mode}" != "proxy" ]]; then
    printf '%s' '[]'
    return
  fi
  local url
  url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
  parse_socks5 "${url}"
  jq -n \
    --arg addr "${SOCKS_HOST}:${SOCKS_PORT}" \
    --arg user "${SOCKS_USER}" \
    --arg pass "${SOCKS_PASS}" \
    '[{name:"proxy", type:"socks5", socks5:(
        {addr:$addr} + (if $user == "" then {} else {username:$user, password:$pass} end)
      )}]'
}

write_hysteria_node_config() {
  local tag="$1"
  local tmp cfg ob json
  json=$(jq -c --arg tag "${tag}" '.hysteria[] | select(.tag==$tag)' "${XCC_NODES}")
  [[ -n "${json}" ]] || return 1
  local port password obfs acme domain email sni outbound
  port=$(printf '%s' "${json}" | jq -r '.port')
  password=$(printf '%s' "${json}" | jq -r '.password')
  obfs=$(printf '%s' "${json}" | jq -r '.obfs // empty')
  acme=$(printf '%s' "${json}" | jq -r '.acme')
  domain=$(printf '%s' "${json}" | jq -r '.domain // empty')
  email=$(printf '%s' "${json}" | jq -r '.email // "admin@localhost"')
  sni=$(printf '%s' "${json}" | jq -r '.sni // .domain // "localhost"')
  outbound=$(printf '%s' "${json}" | jq -r '.outbound // "proxy"')
  cfg="${HYSTERIA_DIR}/config-${port}.json"
  tmp=$(xcc_mktemp .json)
  ob=$(hysteria_outbound_json "${outbound}")

  if [[ "${acme}" == "true" ]]; then
    jq -n \
      --argjson port "${port}" \
      --arg password "${password}" \
      --arg obfs "${obfs}" \
      --arg domain "${domain}" \
      --arg email "${email}" \
      --argjson outbounds "${ob}" \
      --arg masq "https://www.microsoft.com" \
      '
      {
        listen: (":" + ($port|tostring)),
        auth: {type:"password", password:$password},
        tls: {acme:{domains:[$domain], email:$email}},
        masquerade: {type:"proxy", proxy:{url:$masq, rewriteHost:true}}
      }
      + (if $obfs == "" then {} else {obfs:{type:"salamander", salamander:{password:$obfs}}} end)
      + (if ($outbounds|length) == 0 then {} else {outbounds:$outbounds} end)
      ' > "${tmp}"
  else
    local cert="${HYSTERIA_DIR}/server-${port}.crt"
    local key="${HYSTERIA_DIR}/server-${port}.key"
    if [[ ! -f "${cert}" || ! -f "${key}" ]]; then
      openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
        -keyout "${key}" -out "${cert}" -subj "/CN=${sni}" >/dev/null 2>&1
      chmod 600 "${key}"
    fi
    jq -n \
      --argjson port "${port}" \
      --arg password "${password}" \
      --arg obfs "${obfs}" \
      --arg cert "${cert}" \
      --arg key "${key}" \
      --argjson outbounds "${ob}" \
      --arg masq "https://www.microsoft.com" \
      '
      {
        listen: (":" + ($port|tostring)),
        auth: {type:"password", password:$password},
        tls: {cert:$cert, key:$key},
        masquerade: {type:"proxy", proxy:{url:$masq, rewriteHost:true}}
      }
      + (if $obfs == "" then {} else {obfs:{type:"salamander", salamander:{password:$obfs}}} end)
      + (if ($outbounds|length) == 0 then {} else {outbounds:$outbounds} end)
      ' > "${tmp}"
  fi

  if ! hysteria_test_config "${tmp}"; then
    err "Hysteria 配置语法检查失败: ${cfg}"
    rm -f "${tmp}"
    return 1
  fi
  mv "${tmp}" "${cfg}"
  chmod 600 "${cfg}"
  # 兼容用户指定的默认路径
  cp -a "${cfg}" "${HYSTERIA_CONF}"
  chmod 600 "${HYSTERIA_CONF}"
}

apply_hysteria_config() {
  local p enabled tag
  install_hysteria_unit
  while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    enabled=$(jq -r --argjson port "${p}" '.hysteria[] | select(.port==$port) | .enabled' "${XCC_NODES}")
    if [[ "${enabled}" == "true" ]]; then
      tag=$(jq -r --argjson port "${p}" '.hysteria[] | select(.port==$port) | .tag' "${XCC_NODES}")
      write_hysteria_node_config "${tag}" || return 1
      systemctl enable --now "hysteria@${p}" >/dev/null 2>&1 || systemctl restart "hysteria@${p}"
    else
      systemctl stop "hysteria@${p}" >/dev/null 2>&1 || true
      systemctl disable "hysteria@${p}" >/dev/null 2>&1 || true
    fi
  done < <(jq -r '.hysteria[]?.port' "${XCC_NODES}" 2>/dev/null)
}

apply_all_configs() {
  apply_xray_config || return 1
  apply_hysteria_config || return 1
  return 0
}

#===============================================================================
# Reality / Hysteria 密钥与分享链接
