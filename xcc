# Xray 语法检查：优先 run -test。Xray 26+ 必须用 .json 后缀才能识别格式。
XRAY_TEST_ERR=""
xray_test_config() {
  local cfg="${1:-${XRAY_CONF}}"
  local json_cfg="${cfg}" tmp=""
  XRAY_TEST_ERR=""
  if [[ "${cfg}" != *.json ]]; then
    tmp=$(xcc_mktemp .json)
    cp -a "${cfg}" "${tmp}"
    json_cfg="${tmp}"
  fi
  if "${XRAY_BIN}" run -test -config "${json_cfg}" >/dev/null 2>&1 \
    || "${XRAY_BIN}" run -test -format json -config "${json_cfg}" >/dev/null 2>&1 \
    || "${XRAY_BIN}" -test -config "${json_cfg}" >/dev/null 2>&1; then
    [[ -n "${tmp}" ]] && rm -f "${tmp}"
    return 0
  fi
  XRAY_TEST_ERR=$("${XRAY_BIN}" run -test -format json -config "${json_cfg}" 2>&1 | tail -n 30 || true)
  [[ -z "${XRAY_TEST_ERR}" ]] && XRAY_TEST_ERR=$("${XRAY_BIN}" run -test -config "${json_cfg}" 2>&1 | tail -n 30 || true)
  err "${XRAY_TEST_ERR}"
  [[ -n "${tmp}" ]] && rm -f "${tmp}"
  return 1
}

