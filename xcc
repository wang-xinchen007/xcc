singbox_arch_tuple() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'linux-amd64' ;;
    aarch64|arm64) printf 'linux-arm64' ;;
    armv7l) printf 'linux-armv7' ;;
    *) printf 'linux-amd64' ;;
