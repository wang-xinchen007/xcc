#===============================================================================
# 基础输出
#===============================================================================

info()  { printf '%b[INFO]%b %s\n' "${GREEN}" "${NC}" "$*"; }
warn()  { printf '%b[WARN]%b %s\n' "${YELLOW}" "${NC}" "$*"; }
err()   { printf '%b[ERROR]%b %s\n' "${RED}" "${NC}" "$*" >&2; }
die()   { err "$*"; exit 1; }

add_warning() {
  WARNINGS+=("$1")
  warn "$1"
}

need_root() {
