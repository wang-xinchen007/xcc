rand_hex() {
  openssl rand -hex "${1:-4}"
}

rand_alnum() {
  local n="${1:-16}"
  tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${n}"
}

# 调用 xray x25519。兼容 PrivateKey/PublicKey、Password (PublicKey)、Password 三种输出。
xray_x25519() {
  local out priv pub
  out=$("${XRAY_BIN}" x25519 2>&1) || true
  priv=$(printf '%s\n' "${out}" | awk -F': *' '{
    k=$1; gsub(/[[:space:]]/,"",k); k=tolower(k)
    if (k ~ /privatekey/) { gsub(/[[:space:]]/,"",$NF); print $NF; exit }
  }')
  pub=$(printf '%s\n' "${out}" | awk -F': *' '{
    k=$1; gsub(/[[:space:]]/,"",k); k=tolower(k)
    if (k ~ /publickey/) { gsub(/[[:space:]]/,"",$NF); print $NF; exit }
  }')
  if [[ -z "${pub}" ]]; then
    pub=$(printf '%s\n' "${out}" | awk '/Password \(PublicKey\)/ {print $NF; exit} /^Password:/ {print $NF; exit}')
  fi
  if [[ -z "${priv}" ]]; then
    priv=$(printf '%s\n' "${out}" | sed -n 's/^PrivateKey:[[:space:]]*//p' | sed '/^$/d' | head -n1)
  fi
  if [[ -z "${pub}" ]]; then
    pub=$(printf '%s\n' "${out}" | sed -n 's/^PublicKey:[[:space:]]*//p' | sed '/^$/d' | head -n1)
  fi
  if [[ -z "${priv}" || -z "${pub}" ]]; then
    return 1
  fi
  REALITY_PRIV="${priv}"
  REALITY_PUB="${pub}"
}

xray_uuid() {
  local u
  u=$("${XRAY_BIN}" uuid 2>/dev/null | head -n1)
  if [[ -z "${u}" && -r /proc/sys/kernel/random/uuid ]]; then
    u=$(tr -d ' \n' < /proc/sys/kernel/random/uuid)
  fi
  printf '%s' "${u}"
}

alloc_xray_local_port() {
