#===============================================================================
# 菜单：SSH 端口
# 先放行新端口，再改配置；sshd -t 失败则回滚。
#===============================================================================
current_ssh_port() {
  awk '/^[Pp]ort[[:space:]]+/ {p=$2} END{if(p) print p; else print 22}' "${SSHD_CONFIG}" 2>/dev/null
}

menu_ssh_port() {
  local old new
  old=$(current_ssh_port)
  new=$(tui_input "设置 SSH 端口" "当前端口 ${old}，请输入新端口" "${old}") || return 1
  [[ "${new}" == "${old}" ]] && { tui_msg "提示" "端口未变化。"; return 0; }
  if ! [[ "${new}" =~ ^[0-9]+$ ]] || [[ "${new}" -lt 1 || "${new}" -gt 65535 ]]; then
    tui_msg "错误" "无效端口"
    return 1
  fi
  begin_config_op
  fw_allow_tcp "${new}"
  # Ubuntu 24.04：若 ufw 为 active，先放行新端口，修改后再 reload；inactive 则跳过。
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | head -n1 | grep -qi 'active'; then
    ufw allow "${new}/tcp" >/dev/null || true
  fi
  cp -a "${SSHD_CONFIG}" "${SSHD_CONFIG}.xccbak"
  if grep -Eq '^[Pp]ort[[:space:]]+' "${SSHD_CONFIG}"; then
    sed -i "s/^[Pp]ort[[:space:]].*/Port ${new}/" "${SSHD_CONFIG}"
  else
    printf '\nPort %s\n' "${new}" >> "${SSHD_CONFIG}"
  fi
  local sshd_err
  sshd_err=$(xcc_mktemp)
  if ! sshd -t >"${sshd_err}" 2>&1; then
    mv "${SSHD_CONFIG}.xccbak" "${SSHD_CONFIG}"
    tui_msg "错误" "sshd -t 检查失败，已回滚。$(cat "${sshd_err}" 2>/dev/null)"
    rm -f "${sshd_err}"
    end_config_op_fail
    return 1
  fi
  rm -f "${sshd_err}"
  if systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null; then
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | head -n1 | grep -qi 'active'; then
      ufw reload >/dev/null || true
    fi
    end_config_op_ok
    tui_msg "SSH 端口已修改" "新端口 ${new}。请另开 SSH 窗口测试新端口，确认成功后再清理旧端口规则。"
    if tui_yesno "清理旧规则" "新端口 ${new} 是否已测试成功？确认后将清理旧端口 ${old} 的防火墙规则。"; then
      fw_delete_tcp "${old}"
    fi
  else
    mv "${SSHD_CONFIG}.xccbak" "${SSHD_CONFIG}"
    tui_msg "错误" "重启 SSH 服务失败，已回滚配置。"
    end_config_op_fail
    return 1
  fi
}

#===============================================================================
# 备份 / 恢复（备份为只读，不停止看门狗）
#===============================================================================
menu_backup() {
  local dest stamp
  stamp=$(date '+%Y%m%d-%H%M%S')
  dest="/root/xcc-backup-${stamp}.tar.gz"
  mkdir -p "${XCC_DIR}/export"
  cp -a "${XRAY_CONF}" "${XCC_DIR}/export/xray-config.json" 2>/dev/null || true
  if [[ -d "${HYSTERIA_DIR}" ]]; then
    rm -rf "${XCC_DIR}/export/hysteria"
    cp -a "${HYSTERIA_DIR}" "${XCC_DIR}/export/hysteria" 2>/dev/null || true
  fi
  if tar -czf "${dest}" -C /etc xcc; then
    chmod 600 "${dest}"
    tui_msg "备份完成" "已保存到 ${dest}"
  else
    tui_msg "错误" "备份失败"
  fi
}

menu_restore() {
  local files=() f choice
  shopt -s nullglob
  files=(/root/xcc-backup-*.tar.gz)
  shopt -u nullglob
  if [[ "${#files[@]}" -eq 0 ]]; then
    f=$(tui_input "恢复配置" "未在 /root 发现备份，请输入备份文件完整路径" "") || return 1
  else
    local items=()
    for f in "${files[@]}"; do
      items+=("${f}" "$(basename "${f}")")
    done
    items+=("custom" "输入自定义路径")
    choice=$(tui_menu "恢复配置" "选择备份文件" "${items[@]}") || return 1
    if [[ "${choice}" == "custom" ]]; then
      f=$(tui_input "恢复配置" "备份文件路径" "") || return 1
    else
      f="${choice}"
    fi
  fi
  [[ -f "${f}" ]] || { tui_msg "错误" "文件不存在: ${f}"; return 1; }
  if ! tui_yesno "确认恢复" "将用 ${f} 覆盖 /etc/xcc ，是否继续？"; then
    return 1
  fi
  begin_config_op
  tar -xzf "${f}" -C /etc
  if [[ -f "${XCC_DIR}/export/xray-config.json" ]]; then
    cp -a "${XCC_DIR}/export/xray-config.json" "${XRAY_CONF}"
  fi
  if [[ -d "${XCC_DIR}/export/hysteria" ]]; then
    mkdir -p "${HYSTERIA_DIR}"
    cp -a "${XCC_DIR}/export/hysteria/." "${HYSTERIA_DIR}/"
  fi
  chmod 600 "${XCC_NODES}" "${XCC_OUTBOUND}" "${XRAY_CONF}" 2>/dev/null || true
  if apply_all_configs; then
    end_config_op_ok
    tui_msg "完成" "配置已恢复。"
  else
    tui_msg "错误" "恢复后语法检查失败，已回滚。"
    end_config_op_fail
  fi
}

#===============================================================================
# 卸载
#===============================================================================
do_uninstall() {
  local also
  also="${1:-ask}"
  systemctl stop xcc-watchdog >/dev/null 2>&1 || true
  systemctl disable xcc-watchdog >/dev/null 2>&1 || true
  systemctl disable --now xcc-sub >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/xcc-sub.service
  if [[ "${also}" == "ask" ]]; then
    if tui_yesno "卸载组件" "是否同时卸载 Xray 和 Hysteria？"; then
      also="yes"
    else
      also="no"
    fi
  fi
  if [[ "${also}" == "yes" ]]; then
    systemctl stop xray >/dev/null 2>&1 || true
    systemctl disable xray >/dev/null 2>&1 || true
    systemctl list-units --full --all --type=service --no-legend 'hysteria@*' 2>/dev/null \
      | awk '{print $1}' | while read -r unit; do
          [[ -n "${unit}" ]] || continue
          systemctl stop "${unit}" >/dev/null 2>&1 || true
          systemctl disable "${unit}" >/dev/null 2>&1 || true
        done
    rm -f "${XRAY_BIN}" "${HYSTERIA_BIN}"
    rm -rf /usr/local/etc/xray "${HYSTERIA_DIR}"
  fi
  rm -f "${WATCHDOG_UNIT}" "${HYSTERIA_UNIT}" "${LOGROTATE_CONF}"
  systemctl daemon-reload || true
  rm -rf "${XCC_DIR}" "${XCC_TMP_DIR}"
  rm -f "${XCC_BIN}"
  info "xcc 已卸载。"
}

menu_uninstall() {
  local confirm
  confirm=$(tui_input "卸载 xcc" "此操作不可撤销。请输入 yes 确认卸载" "") || return 1
  if [[ "${confirm}" != "yes" ]]; then
    tui_msg "已取消" "未输入 yes，未执行卸载。"
    return 1
  fi
  do_uninstall ask
  tui_msg "完成" "xcc 已卸载，即将退出。"
  exit 0
}

cmd_uninstall() {
  need_root
  local confirm
  read -r -p "确认卸载 xcc？请输入 yes: " confirm
  if [[ "${confirm}" != "yes" ]]; then
    echo "已取消。"
    exit 1
  fi
  tui_init
  do_uninstall ask
}

#===============================================================================
# 更新：覆盖 /usr/local/bin/xcc，保留 /etc/xcc/
# 若 TUI（xcc run）正在运行则拒绝；看门狗会临时停止以便覆盖二进制。
#===============================================================================
cmd_update() {
  need_root
  if pgrep -af "xcc run" | grep -v "$$" >/dev/null 2>&1; then
    die "请先退出 xcc 再更新"
  fi
  # 字面检测 pgrep -f xcc：排除自身、update、watchdog
  local others
  others=$(pgrep -af "xcc" | grep -vE "($$|xcc update|xcc watchdog)" || true)
  if [[ -n "${others}" ]] && pgrep -f "xcc run" >/dev/null 2>&1; then
    die "请先退出 xcc 再更新"
  fi
  info "正在从 GitHub / 镜像下载最新 xcc..."
  local tmp
  tmp=$(xcc_mktemp)
  if ! download_github_file "${tmp}" "xcc"; then
    die "下载失败，请重试。"
  fi
  systemctl stop xcc-watchdog >/dev/null 2>&1 || true
  chmod 755 "${tmp}"
  mv "${tmp}" "${XCC_BIN}"
  chmod 755 "${XCC_BIN}"
  systemctl start xcc-watchdog >/dev/null 2>&1 || true
  info "更新完成。/etc/xcc/ 配置已保留。当前版本: $("${XCC_BIN}" version 2>/dev/null || echo unknown)"
}

check_remote_xcc_version() {
  local remote url
  while IFS= read -r url; do
    [[ -n "${url}" ]] || continue
    remote=$(xcc_curl_quick "${url}" 2>/dev/null \
      | grep -m1 '^XCC_VERSION=' | cut -d= -f2 | tr -d '"' || true)
    [[ -n "${remote}" ]] && break
  done < <(github_file_urls "xcc")
  [[ -n "${remote}" ]] || return 0
  if version_newer "${remote}" "${XCC_VERSION}"; then
    add_warning "GitHub 上有新版本 ${remote}（当前 ${XCC_VERSION}），可执行 xcc update 更新。"
  fi
}

#===============================================================================
# 看门狗主循环（每分钟一次）
#===============================================================================
watchdog_cleanup_old_logs() {
  find /var/log/ -name "xcc.log.*" -mtime +7 -delete 2>/dev/null || true
}

watchdog_disk() {
  local usage
  usage=$(df -h / | awk 'NR==2{print $5}' | sed 's/%//')
  if ! [[ "${usage}" =~ ^[0-9]+$ ]]; then
    usage=$(df -P / | awk 'NR==2{print $5}' | sed 's/%//')
  fi
  if [[ "${usage}" =~ ^[0-9]+$ && "${usage}" -gt 85 ]]; then
    xcc_log ERROR "磁盘使用率 ${usage}% 超过 85%"
    broadcast "xcc 告警: 磁盘使用率 ${usage}% 超过 85%"
  fi
}

watchdog_load() {
  local load cores thr
  load=$(uptime | awk -F'load average:' '{print $2}' | cut -d, -f1 | tr -d ' ')
  cores=$(nproc 2>/dev/null || echo 1)
  if command -v bc >/dev/null 2>&1 && [[ -n "${load}" ]]; then
    thr=$(echo "${cores} * 2" | bc)
    if [[ $(echo "${load} > ${thr}" | bc -l) -eq 1 ]]; then
      xcc_log WARN "1 分钟负载 ${load} 超过阈值 ${thr}（CPU 核心数 ${cores} * 2）"
    fi
  fi
}

watchdog_count_recent_restarts() {
  local now cutoff
  now=$(date +%s)
  cutoff=$((now - 300))
  [[ -f "${WATCHDOG_RESTARTS}" ]] || { printf '0'; return; }
  awk -v c="${cutoff}" '$1 >= c {n++} END {print n+0}' "${WATCHDOG_RESTARTS}"
}

watchdog_record_restart() {
  mkdir -p "${XCC_DIR}"
  date +%s >> "${WATCHDOG_RESTARTS}"
  tail -n 30 "${WATCHDOG_RESTARTS}" > "${WATCHDOG_RESTARTS}.tmp" 2>/dev/null || true
  mv "${WATCHDOG_RESTARTS}.tmp" "${WATCHDOG_RESTARTS}" 2>/dev/null || true
}

watchdog_check_xray() {
  if [[ ! -x "${XRAY_BIN}" ]]; then
    return 0
  fi
  if [[ -f "${WATCHDOG_HALT}" ]]; then
    xcc_log ERROR "看门狗保护已触发（5 分钟内重启超过 3 次），等待人工介入。删除 ${WATCHDOG_HALT} 后恢复。"
    return 0
  fi
  if is_svc_active xray; then
    return 0
  fi
  local n
  n=$(watchdog_count_recent_restarts)
  if [[ "${n}" -ge 3 ]]; then
    : > "${WATCHDOG_HALT}"
    xcc_log ERROR "5 分钟内重启超过 3 次，已停止自动重启，请人工介入。"
    broadcast "xcc 紧急告警: Xray 5 分钟内重启超过 3 次，已停止自动重启。"
    return 0
  fi
  xcc_log WARN "Xray 未运行，正在 systemctl restart xray"
  systemctl restart xray >/dev/null 2>&1 || true
  watchdog_record_restart
}

watchdog_check_hysteria() {
  local p
  [[ -f "${XCC_NODES}" ]] || return 0
  jq -r '.hysteria[]? | select(.enabled==true) | .port' "${XCC_NODES}" 2>/dev/null | while read -r p; do
    [[ -n "${p}" ]] || continue
    if ! is_svc_active "hysteria@${p}"; then
      xcc_log WARN "Hysteria@${p} 未运行，正在重启"
      systemctl restart "hysteria@${p}" >/dev/null 2>&1 || true
    fi
  done
}

watchdog_check_outbound() {
  [[ -f "${XCC_OUTBOUND}" ]] || return 0
  local url mode
  url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
  [[ -n "${url}" && "${url}" != DIRECT && "${url}" != direct ]] || return 0
  parse_socks5 "${url}"
  local proxy_url exit_ip
  if [[ -n "${SOCKS_USER}" ]]; then
    proxy_url="socks5h://${SOCKS_USER}:${SOCKS_PASS}@${SOCKS_HOST}:${SOCKS_PORT}"
  else
    proxy_url="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
  fi
  if ! curl -fL --max-time 15 -x "${proxy_url}" -o /dev/null -sS "https://www.google.com" >/dev/null 2>&1; then
    xcc_log ERROR "SOCKS5 代理连通性检查失败（访问 google.com）"
  fi
  exit_ip=$(curl -fL --max-time 15 -x "${proxy_url}" -sS "${IPIFY_URL}" 2>/dev/null || true)
  if [[ -n "${exit_ip}" && "${exit_ip}" != "${SOCKS_HOST}" ]]; then
    xcc_log WARN "出口 IP ${exit_ip} 与代理地址 ${SOCKS_HOST} 不一致"
  fi
}

cmd_watchdog() {
  need_root
  init_tmp
  watchdog_cleanup_old_logs
  xcc_log INFO "看门狗启动"
  while true; do
    watchdog_disk
    watchdog_load
    watchdog_check_xray
    watchdog_check_hysteria
    watchdog_check_outbound
    sleep 60
  done
}

#===============================================================================
# 主菜单 / CLI
