outbound_mode() {
  if [[ ! -f "${XCC_OUTBOUND}" ]]; then
    printf 'direct'
    return
  fi
  local url
  url=$(tr -d '\r' < "${XCC_OUTBOUND}" | head -n1)
  if [[ -z "${url}" || "${url}" == DIRECT || "${url}" == direct ]]; then
    printf 'direct'
  else
    printf 'proxy'
  fi
}

# 解析 SOCKS5://user:pass@ip:port
parse_socks5() {
  local url="$1"
  SOCKS_USER=""
  SOCKS_PASS=""
  SOCKS_HOST=""
  SOCKS_PORT=""
  url="${url#SOCKS5://}"
  url="${url#socks5://}"
  url="${url#SOCKS5H://}"
  url="${url#socks5h://}"
  if [[ "${url}" == *"@"* ]]; then
    local cred rest
    cred="${url%@*}"
    rest="${url##*@}"
    SOCKS_USER="${cred%%:*}"
    SOCKS_PASS="${cred#*:}"
    SOCKS_HOST="${rest%%:*}"
    SOCKS_PORT="${rest##*:}"
  else
    SOCKS_HOST="${url%%:*}"
    SOCKS_PORT="${url##*:}"
  fi
}

